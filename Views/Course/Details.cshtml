            const closeEnrollModal = document.getElementById('closeEnrollModal');
            const openInquiry = document.getElementById('openInquiry');
            const closeInquiry = document.getElementById('closeInquiry');
            const submitInquiry = document.getElementById('submitInquiry');
            const inquiryMessage = document.getElementById('inquiryMessage');

            tabButtons.forEach(button => {
                button.addEventListener('click', () => {
                    const selectedTab = button.dataset.tab;

                    tabButtons.forEach(btn => {
                        btn.className = 'tab-button px-5 py-3 rounded-full bg-slate-100 text-slate-700 text-sm font-extrabold hover:bg-blue-50 hover:text-blue-700';
                    });

                    button.className = 'tab-button px-5 py-3 rounded-full bg-blue-700 text-white text-sm font-extrabold';

                    tabPanels.forEach(panel => {
                        panel.classList.toggle('active', panel.id === selectedTab);
                    });
                });
            });

            accordions.forEach(button => {
                button.addEventListener('click', () => {
                    const content = button.nextElementSibling;
                    content.classList.toggle('hidden');
                });
            });

            openInquiry.addEventListener('click', () => modal.classList.remove('hidden'));
            closeInquiry.addEventListener('click', () => modal.classList.add('hidden'));
            modal.addEventListener('click', event => {
                if (event.target === modal) modal.classList.add('hidden');
            });
            submitInquiry.addEventListener('click', () => inquiryMessage.classList.remove('hidden'));

            if (enrollButton && enrollModal) {
                enrollButton.addEventListener('click', () => {
                    enrollModal.classList.remove('hidden');
                });
            }

            if (closeEnrollModal && enrollModal) {
                closeEnrollModal.addEventListener('click', () => {
                    enrollModal.classList.add('hidden');
                });

                enrollModal.addEventListener('click', event => {
                    if (event.target === enrollModal) {
                        enrollModal.classList.add('hidden');
                    }
                });
            }

            const toggleReview = document.getElementById('toggleReview');
            const reviewBox = document.getElementById('reviewBox');
            const ambassadorButton = document.getElementById('ambassadorButton');
            const ambassadorMessage = document.getElementById('ambassadorMessage');

            if (toggleReview && reviewBox) {
                toggleReview.addEventListener('click', () => {
                    reviewBox.classList.toggle('hidden');
                    toggleReview.textContent = reviewBox.classList.contains('hidden') ? 'Show Review' : 'Hide Review';
                });
            }

            if (ambassadorButton && ambassadorMessage) {
                ambassadorButton.addEventListener('click', () => {
                    ambassadorMessage.classList.remove('hidden');
                });
            }
        });
    </script>
</body>
</html>
