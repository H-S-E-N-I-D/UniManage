@model UniManage.Models.CourseVo

@{
    ViewData["Title"] = "Create Course";
    var departments = ViewBag.Departments as List<DepartmentVo> ?? new List<DepartmentVo>();

}

<div class="max-w-3xl mx-auto mt-10 bg-white shadow-lg rounded-xl p-8">

    <h2 class="text-2xl font-semibold text-gray-800 mb-6">
        Create New Course
    </h2>

    <form asp-action="Create" method="post" class="space-y-6">

        @Html.AntiForgeryToken()

        <!-- Validation Summary -->
        <div asp-validation-summary="ModelOnly"
             class="text-red-500 text-sm"></div>

        <!-- Title -->
        <div>
            <label asp-for="Title"
                   class="block text-sm font-medium text-gray-700"></label>
            <input asp-for="Title"
                   class="mt-1 w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" />
            <span asp-validation-for="Title"
                  class="text-red-500 text-sm"></span>
        </div>

        <!-- Course Code -->
        <div>
            <label asp-for="CourseCode"
                   class="block text-sm font-medium text-gray-700"></label>
            <input asp-for="CourseCode"
                   class="mt-1 w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" />
            <span asp-validation-for="CourseCode"
                  class="text-red-500 text-sm"></span>
        </div>

        <!-- Description -->
        <div>
            <label asp-for="Description"
                   class="block text-sm font-medium text-gray-700"></label>
            <textarea asp-for="Description" rows="3"
                      class="mt-1 w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none"></textarea>
            <span asp-validation-for="Description"
                  class="text-red-500 text-sm"></span>
        </div>

        <!-- Duration -->
        <div>
            <label asp-for="Duration"
                   class="block text-sm font-medium text-gray-700"></label>
            <input asp-for="Duration" type="number" step="0.1"
                   class="mt-1 w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none" />
            <span asp-validation-for="Duration"
                  class="text-red-500 text-sm"></span>
        </div>

        <!-- Department Dropdown -->
        <div>
            <label asp-for="DepartmentId"
                   class="block text-sm font-medium text-gray-700"></label>

            <select asp-for="DepartmentId"
                    class="mt-1 w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:outline-none">

                <option value="">-- Select Department --</option>

                @foreach (var dept in departments)
                {
                    <option value="@dept.Id">@dept.Name</option>
                }
            </select>

            <span asp-validation-for="DepartmentId"
                  class="text-red-500 text-sm"></span>
        </div>

        <!-- Active Checkbox -->
        <div class="flex items-center">
            <input asp-for="IsActive" type="checkbox"
                   class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" />
            <label asp-for="IsActive"
                   class="ml-2 text-sm text-gray-700"></label>
        </div>

        <!-- Buttons -->
        <div class="flex justify-between items-center pt-4">
            <a asp-action="Index"
               class="text-gray-600 hover:text-gray-800 text-sm">
                ← Back to List
            </a>

            <button type="submit"
                    class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition">
                Create Course
            </button>
        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}