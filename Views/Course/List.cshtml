@{
    ViewData["Title"] = "All Courses";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<section class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-xs font-extrabold uppercase tracking-[0.25em] text-brand-700">Course Management</p>
            <h1 class="mt-2 text-2xl font-extrabold text-slate-900 sm:text-3xl">Course List</h1>
            <p class="mt-2 text-sm text-slate-500">View, filter, and manage registered courses.</p>
        </div>
    </div>

    <div class="rounded-[28px] border border-slate-200 bg-white p-5 shadow-panel sm:p-6">
        <div class="flex flex-col gap-3 border-b border-slate-100 pb-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-50 text-brand-700">
                    <i class="fa-solid fa-filter"></i>
                </div>
                <div>
                    <h2 class="text-lg font-bold text-slate-900">Filter Courses</h2>
                    <p class="text-sm text-slate-500">Filter courses by department, study mode, and award type.</p>
                </div>
            </div>

            <button id="clearFiltersButton" type="button" class="inline-flex items-center justify-center gap-2 rounded-full bg-slate-100 px-4 py-2 text-xs font-bold text-slate-700 transition hover:bg-slate-200">
                <i class="fa-solid fa-rotate-left"></i>
                Clear Filters
            </button>
        </div>

        <form class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-12">
            <div class="sm:col-span-2 xl:col-span-4">
                <label class="block text-xs font-bold text-slate-700">Department</label>
                <div class="relative mt-2">
                    <button id="departmentDropdownButton" type="button" class="flex w-full items-center justify-between rounded-2xl border border-slate-200 bg-white px-4 py-3 text-left text-sm font-semibold text-slate-700 shadow-sm transition hover:border-brand-300 focus:outline-none focus:ring-2 focus:ring-brand-600">
                        <span id="selectedDepartmentText" class="truncate text-slate-400">All departments</span>
                        <i class="fa-solid fa-chevron-down text-xs text-slate-400"></i>
                    </button>

                    <div id="departmentDropdownPanel" class="absolute z-40 mt-2 hidden w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
                        <div class="border-b border-slate-100 p-3">
                            <div class="relative">
                                <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-sm text-slate-400"></i>
                                <input id="departmentSearchInput" type="text" placeholder="Search department" class="w-full rounded-xl border border-slate-200 py-2.5 pl-10 pr-4 text-sm focus:outline-none focus:ring-2 focus:ring-brand-600" />
                            </div>
                        </div>
                        <div id="departmentOptions" class="max-h-64 overflow-y-auto p-2"></div>
                    </div>
                </div>
                <input id="selectedDepartmentInput" type="hidden" />
            </div>

            <div class="sm:col-span-1 xl:col-span-3">
                <label for="studyModeFilter" class="block text-xs font-bold text-slate-700">Study Mode</label>
                <select id="studyModeFilter" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-600">
                    <option value="">All study modes</option>
                    <option>Full Time</option>
                    <option>Part Time</option>
                    <option>Weekend</option>
                    <option>Distance Learning</option>
                    <option>Hybrid</option>
                </select>
            </div>

            <div class="sm:col-span-1 xl:col-span-3">
                <label for="awardTypeFilter" class="block text-xs font-bold text-slate-700">Award Type</label>
                <select id="awardTypeFilter" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-600">
                    <option value="">All award types</option>
                    <option>Foundation Level</option>
                    <option>Certificate Level</option>
                    <option>Higher National Diploma Level</option>
                    <option>Diploma Level</option>
                    <option>Higher National Certificate</option>
                    <option>Undergraduate Level</option>
                    <option>Postgraduate Level</option>
                    <option>Doctorate Level</option>
                </select>
            </div>

            <div class="flex items-end sm:col-span-2 xl:col-span-2">
                <button id="applyFiltersButton" type="button" class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-brand-700 px-4 py-3 text-xs font-bold text-white shadow-lg shadow-brand-700/20 transition hover:-translate-y-0.5 hover:bg-brand-800 focus:outline-none focus:ring-2 focus:ring-brand-600">
                    <i class="fa-solid fa-filter"></i>
                    Apply Filter
                </button>
            </div>
        </form>
    </div>

    <div class="overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-panel">
        <div class="flex flex-col gap-3 border-b border-slate-100 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-50 text-brand-700">
                    <i class="fa-solid fa-book-open-reader"></i>
                </div>
                <div>
                    <h2 class="text-lg font-bold text-slate-900">Course Table</h2>
                    <p id="courseCountText" class="mt-1 text-sm text-slate-500">Showing all courses</p>
                </div>
            </div>
            <span id="activeFilterBadge" class="hidden rounded-full bg-brand-50 px-4 py-2 text-xs font-extrabold text-brand-700">Filters active</span>
        </div>

        <div id="courseTableContainer" class="w-full overflow-x-auto">
            <table class="w-full min-w-[1100px] divide-y divide-slate-200 text-xs sm:text-sm">
                <thead class="bg-slate-50 text-left text-sm font-bold text-slate-700">
                    <tr>
                        <th class="px-3 py-3 sm:px-5 sm:py-4">Course Title</th>
                        <th class="px-3 py-3 sm:px-5 sm:py-4">Course Code</th>
                        <th class="px-3 py-3 sm:px-5 sm:py-4">Department</th>
                        <th class="px-3 py-3 sm:px-5 sm:py-4">Duration (Months)</th>
                        <th class="px-3 py-3 sm:px-5 sm:py-4">Study Mode</th>
                        <th class="px-3 py-3 sm:px-5 sm:py-4">Award Type</th>
                        <th class="px-3 py-3 text-right sm:px-5 sm:py-4">View</th>
                        <th class="px-3 py-3 text-right sm:px-5 sm:py-4">Edit</th>
                    </tr>
                </thead>
                <tbody id="courseTableBody" class="divide-y divide-slate-100 bg-white"></tbody>
            </table>
        </div>

        <div id="pagination" class="flex flex-wrap items-center justify-center gap-2 border-t border-slate-100 px-5 py-5"></div>

        <div id="noResultsBox" class="hidden px-6 py-12 text-center">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand-50 text-brand-700">
                <i class="fa-solid fa-magnifying-glass text-xl"></i>
            </div>
            <h3 class="mt-4 text-lg font-extrabold text-slate-900">No courses found</h3>
            <p class="mt-2 text-sm text-slate-500">Try changing the department, study mode, or award type filters.</p>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const departments = [
            'Department of Languages',
            'Department of Art & Design',
            'Department of Life Science',
            'Department of Computing',
            'Department of Engineering',
            'Department of Management & Law'
        ];

        const courses = [
            { id: 1, title: 'BSc (Hons) in Software Engineering', code: 'CSE-UG-001', department: 'Department of Computing', duration: 36, studyMode: 'Full Time', awardType: 'Undergraduate Level' },
            { id: 2, title: 'HND in Computing', code: 'CSE-HND-002', department: 'Department of Computing', duration: 24, studyMode: 'Weekend', awardType: 'Higher National Diploma Level' },
            { id: 3, title: 'Certificate in Cyber Security', code: 'CSE-CER-003', department: 'Department of Computing', duration: 6, studyMode: 'Hybrid', awardType: 'Certificate Level' },
            { id: 4, title: 'Foundation in Information Technology', code: 'CSE-FDN-004', department: 'Department of Computing', duration: 8, studyMode: 'Full Time', awardType: 'Foundation Level' },
            { id: 5, title: 'Diploma in Graphic Design', code: 'ART-DIP-005', department: 'Department of Art & Design', duration: 12, studyMode: 'Part Time', awardType: 'Diploma Level' },
            { id: 6, title: 'Higher National Certificate in Multimedia Design', code: 'ART-HNC-006', department: 'Department of Art & Design', duration: 12, studyMode: 'Weekend', awardType: 'Higher National Certificate' },
            { id: 7, title: 'BA in Fashion Design', code: 'ART-UG-007', department: 'Department of Art & Design', duration: 36, studyMode: 'Full Time', awardType: 'Undergraduate Level' },
            { id: 8, title: 'Diploma in English Language', code: 'LAN-DIP-008', department: 'Department of Languages', duration: 12, studyMode: 'Distance Learning', awardType: 'Diploma Level' },
            { id: 9, title: 'Certificate in Business English', code: 'LAN-CER-009', department: 'Department of Languages', duration: 4, studyMode: 'Part Time', awardType: 'Certificate Level' },
            { id: 10, title: 'Foundation in Academic English', code: 'LAN-FDN-010', department: 'Department of Languages', duration: 6, studyMode: 'Hybrid', awardType: 'Foundation Level' },
            { id: 11, title: 'BSc Biomedical Science', code: 'LIF-UG-011', department: 'Department of Life Science', duration: 36, studyMode: 'Full Time', awardType: 'Undergraduate Level' },
            { id: 12, title: 'Diploma in Psychology', code: 'LIF-DIP-012', department: 'Department of Life Science', duration: 12, studyMode: 'Distance Learning', awardType: 'Diploma Level' },
            { id: 13, title: 'Certificate in Laboratory Practice', code: 'LIF-CER-013', department: 'Department of Life Science', duration: 6, studyMode: 'Weekend', awardType: 'Certificate Level' },
            { id: 14, title: 'HND in Civil Engineering', code: 'ENG-HND-014', department: 'Department of Engineering', duration: 24, studyMode: 'Full Time', awardType: 'Higher National Diploma Level' },
            { id: 15, title: 'HND in Electrical and Electronic Engineering', code: 'ENG-HND-015', department: 'Department of Engineering', duration: 24, studyMode: 'Part Time', awardType: 'Higher National Diploma Level' },
            { id: 16, title: 'Certificate in AutoCAD for Engineering', code: 'ENG-CER-016', department: 'Department of Engineering', duration: 4, studyMode: 'Hybrid', awardType: 'Certificate Level' },
            { id: 17, title: 'Diploma in Business Management', code: 'MGT-DIP-017', department: 'Department of Management & Law', duration: 12, studyMode: 'Weekend', awardType: 'Diploma Level' },
            { id: 18, title: 'BA (Hons) in Business Administration', code: 'MGT-UG-018', department: 'Department of Management & Law', duration: 36, studyMode: 'Full Time', awardType: 'Undergraduate Level' },
            { id: 19, title: 'MBA in Project Management', code: 'MGT-PG-019', department: 'Department of Management & Law', duration: 18, studyMode: 'Hybrid', awardType: 'Postgraduate Level' },
            { id: 20, title: 'Doctor of Business Administration', code: 'MGT-DOC-020', department: 'Department of Management & Law', duration: 36, studyMode: 'Part Time', awardType: 'Doctorate Level' }
        ];

        const departmentDropdownButton = document.getElementById('departmentDropdownButton');
        const departmentDropdownPanel = document.getElementById('departmentDropdownPanel');
        const departmentSearchInput = document.getElementById('departmentSearchInput');
        const departmentOptions = document.getElementById('departmentOptions');
        const selectedDepartmentText = document.getElementById('selectedDepartmentText');
        const selectedDepartmentInput = document.getElementById('selectedDepartmentInput');
        const studyModeFilter = document.getElementById('studyModeFilter');
        const awardTypeFilter = document.getElementById('awardTypeFilter');
        const clearFiltersButton = document.getElementById('clearFiltersButton');
        const applyFiltersButton = document.getElementById('applyFiltersButton');
        const courseTableBody = document.getElementById('courseTableBody');
        const courseCountText = document.getElementById('courseCountText');
        const activeFilterBadge = document.getElementById('activeFilterBadge');
        const noResultsBox = document.getElementById('noResultsBox');
        const pagination = document.getElementById('pagination');
        const courseTableContainer = document.getElementById('courseTableContainer');

        const itemsPerPage = 5;
        let currentPage = 1;
        let selectedDepartment = '';
        let currentFilteredCourses = [];

        function renderDepartmentOptions(keyword = '') {
            const normalizedKeyword = keyword.trim().toLowerCase();
            const filteredDepartments = departments.filter(department => department.toLowerCase().includes(normalizedKeyword));

            departmentOptions.innerHTML = '';

            const allButton = document.createElement('button');
            allButton.type = 'button';
            allButton.className = 'w-full rounded-xl px-4 py-3 text-left text-sm font-bold text-slate-700 transition hover:bg-brand-50';
            allButton.textContent = 'All departments';
            allButton.addEventListener('click', () => selectDepartment(''));
            departmentOptions.appendChild(allButton);

            if (filteredDepartments.length === 0) {
                const emptyItem = document.createElement('div');
                emptyItem.className = 'px-4 py-6 text-center text-sm font-semibold text-slate-400';
                emptyItem.textContent = 'No departments found.';
                departmentOptions.appendChild(emptyItem);
                return;
            }

            filteredDepartments.forEach(department => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'w-full rounded-xl px-4 py-3 text-left text-sm font-bold text-slate-700 transition hover:bg-brand-50';
                button.textContent = department;
                button.addEventListener('click', () => selectDepartment(department));
                departmentOptions.appendChild(button);
            });
        }

        function selectDepartment(department) {
            selectedDepartment = department;
            selectedDepartmentInput.value = department;
            selectedDepartmentText.textContent = department || 'All departments';
            selectedDepartmentText.classList.toggle('text-slate-400', department === '');
            selectedDepartmentText.classList.toggle('text-slate-900', department !== '');
            departmentDropdownPanel.classList.add('hidden');
            applyFilters(true);
        }

        function applyFilters(resetPage = true) {
            const studyMode = studyModeFilter.value;
            const awardType = awardTypeFilter.value;

            currentFilteredCourses = courses.filter(course => {
                const matchesDepartment = !selectedDepartment || course.department === selectedDepartment;
                const matchesStudyMode = !studyMode || course.studyMode === studyMode;
                const matchesAwardType = !awardType || course.awardType === awardType;
                return matchesDepartment && matchesStudyMode && matchesAwardType;
            });

            if (resetPage) {
                currentPage = 1;
            }

            renderTable(currentFilteredCourses);
            renderPagination(currentFilteredCourses.length);
            updateFilterStatus(currentFilteredCourses.length);
        }

        function renderTable(data) {
            courseTableBody.innerHTML = '';
            noResultsBox.classList.toggle('hidden', data.length > 0);

            const startIndex = (currentPage - 1) * itemsPerPage;
            const endIndex = startIndex + itemsPerPage;
            const paginatedData = data.slice(startIndex, endIndex);

            paginatedData.forEach(course => {
                const row = document.createElement('tr');
                row.className = 'transition hover:bg-slate-50';
                row.innerHTML = `
                    <td class="px-3 py-3 font-semibold text-slate-900 sm:px-5 sm:py-4">${course.title}</td>
                    <td class="px-3 py-3 text-slate-600 sm:px-5 sm:py-4">${course.code}</td>
                    <td class="px-3 py-3 text-slate-700 sm:px-5 sm:py-4">${course.department}</td>
                    <td class="px-3 py-3 text-slate-600 sm:px-5 sm:py-4">${course.duration}</td>
                    <td class="px-3 py-3 text-slate-700 sm:px-5 sm:py-4">${course.studyMode}</td>
                    <td class="px-3 py-3 text-slate-700 sm:px-5 sm:py-4">${course.awardType}</td>
                    <td class="px-3 py-3 text-right sm:px-5 sm:py-4">
                        <a href="/Course/Details/${course.id}" class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-50 px-4 py-2 text-xs font-bold text-brand-700 transition hover:bg-brand-100">
                            <i class="fa-solid fa-eye"></i>
                            View
                        </a>
                    </td>

                    <td class="px-3 py-3 text-right sm:px-5 sm:py-4">
                        <a href="/Course/Edit/${course.id}" class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-amber-50 text-amber-700 transition hover:bg-amber-100">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                    </td>
                `;
                courseTableBody.appendChild(row);
            });
        }

        function renderPagination(totalItems) {
            pagination.innerHTML = '';
            const totalPages = Math.ceil(totalItems / itemsPerPage);

            if (totalPages <= 1) {
                return;
            }

            const createButton = (label, page, disabled = false, active = false) => {
                const button = document.createElement('button');
                button.type = 'button';
                button.textContent = label;
                button.disabled = disabled;
                button.className = active
                    ? 'h-10 min-w-10 rounded-full bg-blue-700 px-4 text-sm font-extrabold text-white shadow-md'
                    : 'h-10 min-w-10 rounded-full border border-slate-200 bg-white px-4 text-sm font-bold text-slate-700 transition hover:bg-blue-50 hover:text-blue-700 disabled:cursor-not-allowed disabled:opacity-40';

                button.addEventListener('click', () => {
                    if (!disabled) {
                        currentPage = page;
                        renderTable(currentFilteredCourses);
                        renderPagination(currentFilteredCourses.length);
                        courseTableContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });

                pagination.appendChild(button);
            };

            createButton('Prev', Math.max(1, currentPage - 1), currentPage === 1);

            for (let page = 1; page <= totalPages; page++) {
                createButton(page, page, false, page === currentPage);
            }

            createButton('Next', Math.min(totalPages, currentPage + 1), currentPage === totalPages);
        }

        function updateFilterStatus(count) {
            const filtersActive = Boolean(selectedDepartment || studyModeFilter.value || awardTypeFilter.value);
            activeFilterBadge.classList.toggle('hidden', !filtersActive);
            courseCountText.textContent = `${count} course${count === 1 ? '' : 's'} found`;
        }

        function clearFilters() {
            selectedDepartment = '';
            selectedDepartmentInput.value = '';
            selectedDepartmentText.textContent = 'All departments';
            selectedDepartmentText.classList.add('text-slate-400');
            selectedDepartmentText.classList.remove('text-slate-900');
            departmentSearchInput.value = '';
            studyModeFilter.value = '';
            awardTypeFilter.value = '';
            renderDepartmentOptions();
            applyFilters(true);
        }

        departmentDropdownButton.addEventListener('click', () => {
            departmentDropdownPanel.classList.toggle('hidden');
            departmentSearchInput.focus();
        });

        document.addEventListener('click', event => {
            if (!departmentDropdownPanel.contains(event.target) && !departmentDropdownButton.contains(event.target)) {
                departmentDropdownPanel.classList.add('hidden');
            }
        });

        departmentSearchInput.addEventListener('input', event => renderDepartmentOptions(event.target.value));
        studyModeFilter.addEventListener('change', () => applyFilters(true));
        awardTypeFilter.addEventListener('change', () => applyFilters(true));
        applyFiltersButton.addEventListener('click', () => applyFilters(true));
        clearFiltersButton.addEventListener('click', clearFilters);

        renderDepartmentOptions();
        applyFilters(true);
    });
</script>