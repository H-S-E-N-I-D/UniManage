@model UniManage.Models.CourseVo
@using UniManage.Models
@{
    ViewData["Title"] = "Create Course";
    var departments = ViewBag.Departments as List<DepartmentVo> ?? new List<DepartmentVo>();
}

<div class="min-h-screen bg-gray-50 py-8 px-4">
    <div class="max-w-2xl mx-auto">

        <div class="mb-6">
            <h1 class="text-2xl font-bold text-gray-800">Create Course</h1>
            <p class="text-sm text-gray-500 mt-1">Fill in the details below to register a new course.</p>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">

            <form asp-action="Create" asp-controller="Course" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="mb-6 p-4 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">

                    <div class="flex flex-col gap-1">
                        <label asp-for="Title"
                               class="text-sm font-medium text-gray-700">
                            Course Title <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="Title"
                               placeholder="e.g. Introduction to Computer Science"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm
                                      focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent
                                      placeholder-gray-400 transition" />
                        <span asp-validation-for="Title" class="text-xs text-red-500 mt-0.5"></span>
                    </div>

                    <div class="flex flex-col gap-1">
                        <label asp-for="CourseCode"
                               class="text-sm font-medium text-gray-700">
                            Course Code <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="CourseCode"
                               placeholder="e.g. CS101"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm
                                      focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent
                                      placeholder-gray-400 transition" />
                        <span asp-validation-for="CourseCode" class="text-xs text-red-500 mt-0.5"></span>
                    </div>

                </div>

                <div class="flex flex-col gap-1 mb-6">
                    <label asp-for="Description"
                           class="text-sm font-medium text-gray-700">Description</label>
                    <textarea asp-for="Description"
                              rows="3"
                              placeholder="Brief description of the course..."
                              class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm
                                     focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent
                                     placeholder-gray-400 transition resize-none"></textarea>
                    <span asp-validation-for="Description" class="text-xs text-red-500 mt-0.5"></span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">

                    <div class="flex flex-col gap-1">
                        <label asp-for="Duration"
                               class="text-sm font-medium text-gray-700">
                            Duration (hours) <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="Duration"
                               type="number"
                               min="0"
                               step="0.5"
                               placeholder="e.g. 45"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm
                                      focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent
                                      placeholder-gray-400 transition" />
                        <span asp-validation-for="Duration" class="text-xs text-red-500 mt-0.5"></span>
                    </div>

                    <div class="flex flex-col gap-1">
                        <label asp-for="DepartmentId"
                               class="text-sm font-medium text-gray-700">
                            Department <span class="text-red-500">*</span>
                        </label>
                        <select asp-for="DepartmentId"
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm
                                       focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent
                                       text-gray-700 transition bg-white">
                            <option value="">— Select a department —</option>
                            @foreach (var dept in departments)
                            {
                                <option value="@dept.Id">@dept.Name</option>
                            }
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-xs text-red-500 mt-0.5"></span>
                    </div>

                </div>

                <div class="flex items-center gap-3 mb-8">
                    <input asp-for="IsActive"
                           type="checkbox"
                           id="isActiveToggle"
                           class="sr-only peer" />

                    <label for="isActiveToggle"
                           class="relative w-11 h-6 bg-gray-300 rounded-full cursor-pointer
                  transition-colors duration-300
                  peer-checked:bg-blue-600
                  peer-focus:ring-2 peer-focus:ring-blue-500 peer-focus:ring-offset-2
                  after:content-[''] after:absolute after:top-0.5 after:left-0.5
                  after:w-5 after:h-5 after:bg-white after:rounded-full after:shadow
                  after:transition-transform after:duration-300
                  peer-checked:after:translate-x-5">
                    </label>

                    <span class="text-sm font-medium text-gray-700 cursor-pointer"
                          onclick="document.getElementById('isActiveToggle').click()">
                        Active Course
                    </span>
                </div>
                <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                    <a asp-action="Index"
                       class="text-sm text-gray-500 hover:text-gray-700 transition">
                        ← Back to List
                    </a>
                    <button type="submit"
                            class="px-6 py-2 bg-blue-600 hover:bg-blue-700 active:bg-blue-800
                                   text-white text-sm font-medium rounded-lg transition
                                   focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                        Create Course
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}