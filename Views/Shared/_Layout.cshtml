<!DOCTYPE html>
<html lang="en" class="h-full bg-[#f4f8fb]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UserRoles</title>


    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#effbff',
                            100: '#d7f4fe',
                            200: '#b3ebfd',
                            300: '#7ddffb',
                            400: '#3cccf6',
                            500: '#1aa7d6',
                            600: '#1696c1',
                            700: '#137ea5',
                            800: '#0f7598',
                            900: '#0b6687'
                        }
                    },
                    boxShadow: {
                        panel: '0 10px 30px rgba(15, 23, 42, 0.08)'
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UserRoles.styles.css" asp-append-version="true" />
</head>
<body class="h-full font-sans text-slate-700 antialiased bg-[#f4f8fb]">
    <div class="min-h-screen bg-[#f4f8fb]">
        <div class="flex min-h-screen">
            <aside id="sidebar" class="fixed inset-y-0 left-0 z-40 w-64 -translate-x-full overflow-y-auto bg-gradient-to-b from-[#118bb3] via-[#0f84ab] to-[#0b7397] text-white shadow-2xl transition-transform duration-300 lg:translate-x-0">
                <div class="flex items-center justify-between border-b border-white/10 px-6 py-5">
                    <div>
                        <p class="text-xs uppercase tracking-[0.3em] text-brand-100/80">UCMS Admin</p>
                        <h1 class="mt-1 text-2xl font-bold">SmartEdu</h1>
                    </div>
                    <button id="closeSidebar" class="rounded-lg p-2 text-white/80 hover:bg-white/10 hover:text-white lg:hidden">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>

                @{

                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();



                    bool isStudent = User.IsInRole("Student");

                    bool isSystemAdmin = User.IsInRole("System Admin");

                    bool isLecturer = User.IsInRole("Lecturer");

                    bool isDepartmentAdmin = User.IsInRole("Department Admin");



                    string ActiveMain(string controller, string action = "")

                    {

                        bool isActive = currentController == controller &&

                        (string.IsNullOrEmpty(action) || currentAction == action);



                        return isActive

                        ? "mb-2 flex items-center gap-3 rounded-2xl bg-[#1695bf]/90 px-4 py-3 font-medium text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.08),0_8px_18px_rgba(4,70,96,0.18)] ring-1 ring-white/10 transition hover:bg-[#1aa1cd]"

                        : "mb-2 flex items-center gap-3 rounded-xl px-4 py-3 font-medium text-white/95 transition hover:bg-white/10 hover:text-white";

                    }



                    string ActiveSub(string controller, string action = "")

                    {

                        bool isActive = currentController == controller &&

                        (string.IsNullOrEmpty(action) || currentAction == action);



                        return isActive

                        ? "block rounded-lg bg-white/15 px-10 py-2 font-semibold text-white"

                        : "block rounded-lg px-10 py-2 text-brand-50/90 hover:bg-white/10 hover:text-white";

                    }



                    bool academicActive =

                    currentController == "AcademicYears" ||

                    currentController == "Departments" ||

                    currentController == "Courses" ||

                    currentController == "CourseOfferings" ||

                    currentController == "Modules";



                    bool userManagementActive =

                    currentController == "Students" ||

                    currentController == "Lecturers" ||

                    currentController == "DepartmentAdmins" ||

                    currentController == "SystemAdmins";

                }

                <nav class="px-4 py-6 text-sm">
                    <p class="px-3 pb-3 text-xs font-semibold uppercase tracking-[0.25em] text-brand-100/70">
                        Navigation
                    </p>

                    <!-- Dashboard: All Users -->
                    <a asp-controller="Home" asp-action="Index" class="@ActiveMain("Home", "Index")">
                        <i class="fa-solid fa-gauge-high w-5 text-center text-[#d5f5ff]"></i>
                        <span>Dashboard</span>
                    </a>

                    <!-- Enrollments: Students and Department Admins -->
                    @if (isStudent || isDepartmentAdmin)

                    {

                        <a asp-controller="" asp-action="" class="@ActiveMain("")">
                            <i class="fa-solid fa-user-plus w-5 text-center text-[#d5f5ff]"></i>
                            <span>Enrollments</span>
                        </a>

                    }

                    <!-- My Courses: Students -->
                    @if (isStudent)

                    {

                        <a asp-controller="MyCourses" asp-action="Index" class="@ActiveMain("MyCourses")">
                            <i class="fa-solid fa-book-open w-5 text-center text-[#d5f5ff]"></i>
                            <span>My Courses</span>
                        </a>

                    }

                    <!-- My Modules: Lecturers -->
                    @if (isLecturer)

                    {

                        <a asp-controller="MyModules" asp-action="Index" class="@ActiveMain("MyModules")">
                            <i class="fa-solid fa-chalkboard-user w-5 text-center text-[#d5f5ff]"></i>
                            <span>My Modules</span>
                        </a>


                        <a asp-controller="ModuleHistory" asp-action="Index" class="@ActiveMain("ModuleHistory")">
                            <i class="fa-solid fa-clock-rotate-left w-5 text-center text-[#d5f5ff]"></i>
                            <span>Module History</span>
                        </a>

                    }

                    <!-- Academic Management: System Admin and Department Admin -->
                    @if (isSystemAdmin || isDepartmentAdmin)

                    {

                        <div class="mb-2 overflow-hidden rounded-xl">
                            <button type="button"
                                    class="submenu-toggle flex w-full items-center justify-between px-4 py-3 text-left font-medium text-white/95 transition hover:bg-white/10 @(academicActive ? "bg-white/10" : "")"
                                    data-target="academicMgtMenu">
                                <span class="flex items-center gap-3">
                                    <i class="fa-solid fa-school w-5 text-center text-[#d5f5ff]"></i>
                                    <span>Academic Management</span>
                                </span>
                                <i class="fa-solid fa-chevron-down text-xs transition-transform @(academicActive ? "rotate-180" : "")"></i>
                            </button>

                            <div id="academicMgtMenu" class="submenu @(academicActive ? "" : "hidden") space-y-1 bg-white/5 px-4 pb-3">
                                <a asp-controller="AcademicYears" asp-action="Index" class="@ActiveSub("AcademicYears")">Academic Years</a>
                                <a asp-controller="Departments" asp-action="Index" class="@ActiveSub("Departments")">Departments</a>
                                <a asp-controller="Courses" asp-action="Index" class="@ActiveSub("Courses")">Courses</a>
                                <a asp-controller="CourseOfferings" asp-action="Index" class="@ActiveSub("CourseOfferings")">Course Offerings</a>
                                <a asp-controller="Modules" asp-action="Index" class="@ActiveSub("Modules")">Modules</a>
                            </div>
                        </div>

                    }

                    <!-- User Management -->
                    @if (isSystemAdmin || isDepartmentAdmin)

                    {

                        <div class="mb-2 overflow-hidden rounded-xl">
                            <button type="button"
                                    class="submenu-toggle flex w-full items-center justify-between px-4 py-3 text-left font-medium text-white/95 transition hover:bg-white/10 @(userManagementActive ? "bg-white/10" : "")"
                                    data-target="usersMgtMenu">
                                <span class="flex items-center gap-3">
                                    <i class="fa-solid fa-users w-5 text-center text-[#d5f5ff]"></i>
                                    <span>User Management</span>
                                </span>
                                <i class="fa-solid fa-chevron-down text-xs transition-transform @(userManagementActive ? "rotate-180" : "")"></i>
                            </button>

                            <div id="usersMgtMenu" class="submenu @(userManagementActive ? "" : "hidden") space-y-1 bg-white/5 px-4 pb-3">
                                @if (isSystemAdmin)

                                {
                                    <a asp-controller="Students" asp-action="Index" class="@ActiveSub("Students")">Register</a>

                                }
                                <a asp-controller="Students" asp-action="Index" class="@ActiveSub("Students")">Students</a>
                                <a asp-controller="Lecturers" asp-action="Index" class="@ActiveSub("Lecturers")">Lecturers</a>

                                @if (isSystemAdmin)

                                {

                                    <a asp-controller="DepartmentAdmins" asp-action="Index" class="@ActiveSub("DepartmentAdmins")">Department Admins</a>
                                    <a asp-controller="SystemAdmins" asp-action="Index" class="@ActiveSub("SystemAdmins")">System Admins</a>

                                }
                            </div>
                        </div>

                    }

                    <!-- Reports: All except Students -->
                    @if (!isStudent)

                    {

                        <div class="mb-2 overflow-hidden rounded-xl">
                            <button type="button"
                                    class="submenu-toggle flex w-full items-center justify-between px-4 py-3 text-left font-medium text-white/95 transition hover:bg-white/10 @(userManagementActive ? "bg-white/10" : "")"
                                    data-target="reports">
                                <span class="flex items-center gap-3">
                                    <i class="fa-solid fa-chart-column w-5 text-center text-[#d5f5ff]"></i>
                                    <span>Reports</span>
                                </span>
                                <i class="fa-solid fa-chevron-down text-xs transition-transform @(userManagementActive ? "rotate-180" : "")"></i>
                            </button>

                            <div id="reports" class="submenu @(userManagementActive ? "" : "hidden") space-y-1 bg-white/5 px-4 pb-3">
                                @if (isLecturer)

                                {

                                    <a asp-controller="Students" asp-action="Index" class="@ActiveSub("Students")">Assesment Grading Report</a>

                                }
                                @if (isLecturer || isDepartmentAdmin)
                                {
                                    <a asp-controller="Lecturers" asp-action="Index" class="@ActiveSub("Lecturers")">Student Performance Report</a>
                                }

                                @if (isDepartmentAdmin)

                                {
                                    <a asp-controller="Lecturers" asp-action="Index" class="@ActiveSub("Lecturers")">Course Performance Report</a>
                                    <a asp-controller="Lecturers" asp-action="Index" class="@ActiveSub("Lecturers")">Course Popularity Report</a>
                                    <a asp-controller="Lecturers" asp-action="Index" class="@ActiveSub("Lecturers")">Lecturer Performance Report</a>
                                    <a asp-controller="Lecturers" asp-action="Index" class="@ActiveSub("Lecturers")">Lecturer Workload Report</a>

                                }
                                @if (isLecturer || isDepartmentAdmin)
                                {
                                    <a asp-controller="Lecturers" asp-action="Index" class="@ActiveSub("Lecturers")">Module Performance Report</a>
                                }
                                @if (isSystemAdmin)
                                {

                                    <a asp-controller="Lecturers" asp-action="Index" class="@ActiveSub("Lecturers")">System Audit Log</a>
                                    <a asp-controller="Lecturers" asp-action="Index" class="@ActiveSub("Lecturers")">System User Interaction Report</a>
                                    <a asp-controller="Lecturers" asp-action="Index" class="@ActiveSub("Lecturers")">System Activity Report</a>
                                    <a asp-controller="Lecturers" asp-action="Index" class="@ActiveSub("Lecturers")">System Performance Report</a>
                                }
                            </div>
                        </div>
                    }

                    <!-- Profile: All Users -->
                    <a asp-controller="Profile" asp-action="Index" class="@ActiveMain("Profile")">
                        <i class="fa-solid fa-user w-5 text-center text-[#d5f5ff]"></i>
                        <span>Profile</span>
                    </a>

                    <!-- Settings: Students -->
                        <a asp-controller="Settings" asp-action="Index" class="@ActiveMain("Settings")">
                            <i class="fa-solid fa-gear w-5 text-center text-[#d5f5ff]"></i>
                            <span>Settings</span>
                        </a>
                    
                </nav>
            </aside>

            <div class="flex min-w-0 flex-1 flex-col lg:pl-64">
                <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/90 backdrop-blur">
                    <div class="flex items-center justify-between gap-4 px-5 py-4 sm:px-6 lg:px-6">
                        <div class="flex items-center gap-3">
                            <button id="openSidebar" class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 shadow-sm transition hover:bg-slate-50 lg:hidden">
                                <i class="fa-solid fa-bars"></i>
                            </button>
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-700">University Course Management System</p>
                                <h2 class="text-xl font-bold text-slate-600">SmartEdu System Dashboard</h2>
                            </div>
                        </div>

                        <div class="flex items-center gap-3">
                            <button class="relative inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 shadow-sm transition hover:-translate-y-0.5 hover:text-brand-700">
                                <i class="fa-regular fa-bell text-lg"></i>
                                <span class="absolute right-2 top-2 h-2.5 w-2.5 rounded-full bg-rose-500"></span>
                            </button>
                            @if (isStudent || isLecturer)
                            {
                                <button class="relative inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 shadow-sm transition hover:-translate-y-0.5 hover:text-brand-700">
                                    <i class="fa-regular fa-comments text-lg"></i>
                                    <span class="absolute right-2 top-2 h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
                                </button>
                            }


                            <div class="relative">
                                <button id="profileMenuButton" class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-white px-2 py-1 shadow-sm transition hover:border-brand-200 hover:bg-slate-50">
                                    <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-brand-100 text-brand-700">
                                        <i class="fa-regular fa-user"></i>
                                    </div>
                                    <div class="hidden text-left sm:block">
                                        <p class="text-sm font-semibold text-slate-800">
                                            @(User.IsInRole("System Admin") ? "System Admin" :
                                                                                        User.IsInRole("Department Admin") ? "Department Admin" :
                                                                                        User.IsInRole("Lecturer") ? "Lecturer" :
                                                                                        User.IsInRole("Student") ? "Student" : "User")
                                        </p>
                                        <p class="text-xs text-slate-500">@User.FindFirst("FullName")?.Value</p>
                                    </div>
                                    <i class="fa-solid fa-chevron-down text-xs text-slate-400"></i>
                                </button>

                                <div id="profileMenu" class="absolute right-0 mt-3 hidden w-56 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
                                    <div class="border-b border-slate-100 px-4 py-3">
                                        <p class="text-sm font-semibold text-slate-800">Account Menu</p>
                                        <p class="text-xs text-slate-500">Manage your session</p>
                                    </div>
                                    <a href="#" class="flex items-center gap-3 px-4 py-3 text-sm text-slate-700 transition hover:bg-slate-50 hover:text-brand-700">
                                        <i class="fa-regular fa-id-badge w-4 text-center"></i>
                                        <span>View Profile</span>
                                    </a>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="flex w-full items-center gap-3 px-4 py-3 text-left text-sm text-rose-600 transition hover:bg-rose-50">
                                            <i class="fa-solid fa-arrow-right-from-bracket w-4 text-center"></i>
                                            <span>Sign Out</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </header>

                <main class="flex-1 px-5 py-6 sm:px-6 lg:px-6">

                    <div class="rounded-[28px] border border-dashed border-[#97e3ff] bg-white/80 p-6 lg:p-8 shadow-panel">
                        @RenderBody()
                    </div>
                </main>

                <footer class="border-t border-slate-200 bg-white px-5 py-4 text-sm text-slate-500 sm:px-6 lg:px-6">
                    <div class="flex flex-col items-center justify-between gap-2 sm:flex-row">
                        <p>
                            &copy; 2026 SmartEdu
                            System Dashboard
                        </p>
                        <a asp-area="" asp-controller="Home" asp-action="Privacy" class="font-medium text-brand-700 hover:text-brand-800">Privacy Policy</a>
                    </div>
                </footer>
            </div>
        </div>
    </div>

    <div id="sidebarOverlay" class="fixed inset-0 z-30 hidden bg-slate-900/50 lg:hidden"></div>

    <script>
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const openSidebar = document.getElementById('openSidebar');
        const closeSidebar = document.getElementById('closeSidebar');
        const profileMenuButton = document.getElementById('profileMenuButton');
        const profileMenu = document.getElementById('profileMenu');

        function showSidebar() {
            sidebar.classList.remove('-translate-x-full');
            overlay.classList.remove('hidden');
        }

        function hideSidebar() {
            sidebar.classList.add('-translate-x-full');
            overlay.classList.add('hidden');
        }

        openSidebar?.addEventListener('click', showSidebar);
        closeSidebar?.addEventListener('click', hideSidebar);
        overlay?.addEventListener('click', hideSidebar);

        document.querySelectorAll('.submenu-toggle').forEach(button => {
            button.addEventListener('click', () => {
                const menu = document.getElementById(button.dataset.target);
                const icon = button.querySelector('.fa-chevron-down');
                menu.classList.toggle('hidden');
                icon.classList.toggle('rotate-180');
            });
        });

        profileMenuButton?.addEventListener('click', (event) => {
            event.stopPropagation();
            profileMenu.classList.toggle('hidden');
        });

        document.addEventListener('click', (event) => {
            if (!profileMenu.contains(event.target) && !profileMenuButton.contains(event.target)) {
                profileMenu.classList.add('hidden');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
