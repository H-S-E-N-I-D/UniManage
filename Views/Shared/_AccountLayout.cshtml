
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SmartEdu - Login</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .brand-gradient {
            background: linear-gradient(135deg, #1e3a8a 0%, #312e81 45%, #2563eb 100%);
        }

        .glass-panel {
            background: rgba(255,255,255,0.35);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }

        .glass-card {
            background: rgba(255,255,255,0.76);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }
    </style>
</head>

<body class="min-h-screen bg-gradient-to-br from-slate-100 via-blue-50 to-indigo-100">

    <!-- Background Effects -->
    <div class="pointer-events-none fixed inset-0 overflow-hidden">
        <div class="absolute -left-32 top-0 h-80 w-80 rounded-full bg-blue-300/30 blur-3xl"></div>
        <div class="absolute bottom-0 right-0 h-96 w-96 rounded-full bg-indigo-300/30 blur-3xl"></div>
        <div class="absolute left-1/2 top-1/2 h-72 w-72 -translate-x-1/2 -translate-y-1/2 rounded-full bg-cyan-200/20 blur-3xl"></div>
    </div>

    <!-- Header -->
    <header class="relative z-50 border-b border-white/20 bg-white/60 backdrop-blur-xl">
        <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3">

            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-700 text-white shadow-lg">
                    <i class="fa-solid fa-graduation-cap text-lg"></i>
                </div>

                <div>
                    <h1 class="text-lg font-extrabold text-slate-800">SmartEdu</h1>
                    <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-500">
                        University Course Management System - UCMS
                    </p>
                </div>
            </div>

            <nav class="hidden items-center gap-7 md:flex">
                <a href="#" class="text-sm font-semibold text-slate-600 hover:text-blue-700">Home</a>
                <a href="#" class="text-sm font-semibold text-slate-600 hover:text-blue-700">Courses</a>
                <a href="#" class="text-sm font-semibold text-slate-600 hover:text-blue-700">About</a>
                <a href="#" class="text-sm font-semibold text-slate-600 hover:text-blue-700">Contact</a>
            </nav>


    <!-- Main -->
    @RenderBody()

    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }
    </script>
            @await RenderSectionAsync("Scripts", required: false)
</body>
</html>