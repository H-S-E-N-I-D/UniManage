<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Smart Edu Higher Education Institute</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .hero-bg {
            background: linear-gradient(120deg, rgba(15, 23, 42, 0.92), rgba(30, 64, 175, 0.82)), url('https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fit=crop&w=1600&q=80');
            background-size: cover;
            background-position: center;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800">
    <header class="bg-white/95 backdrop-blur sticky top-0 z-50 border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                <a href="#" class="flex items-center gap-3">
                    <div class="h-11 w-11 rounded-2xl bg-blue-700 text-white flex items-center justify-center font-extrabold text-xl">SE</div>
                    <div>
                        <p class="text-xl font-extrabold text-slate-900 leading-tight">Smart Edu</p>
                        <p class="text-xs font-medium text-slate-500">Higher Education Institute</p>
                    </div>
                </a>

                <nav class="hidden lg:flex items-center gap-8 text-sm font-semibold text-slate-700">
                    <a href="#home" class="hover:text-blue-700">Home</a>
                    <a href="#about" class="hover:text-blue-700">About</a>
                    <a href="#courses" class="hover:text-blue-700">Courses</a>
                    <a href="#schools" class="hover:text-blue-700">Schools</a>
                    <a href="#student-life" class="hover:text-blue-700">Student Life</a>
                    <a href="#contact" class="hover:text-blue-700">Contact</a>
                </nav>

                <div class="hidden md:flex items-center gap-3">
                    <a href="/Account/Login" class="px-5 py-2.5 rounded-full bg-white text-blue-700 text-sm font-bold shadow hover:bg-blue-50 transition transform hover:-translate-y-0.5 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-blue-500">Login</a>
                    <a href="/Account/Register" class="px-5 py-2.5 rounded-full bg-blue-700 text-white text-sm font-bold hover:bg-blue-800 shadow-lg shadow-blue-700/20 transition transform hover:-translate-y-0.5 hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-blue-300">Register</a>
                </div>
            </div>
        </div>
    </header>

    <main>
        <section id="home" class="hero-bg text-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
                <div class="max-w-3xl">
                    <span class="inline-flex items-center px-4 py-2 rounded-full bg-white/15 ring-1 ring-white/20 text-sm font-semibold mb-6">Admissions Open for 2026 Intake</span>
                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight">Empowering minds for a smarter academic future</h1>
                    <p class="mt-6 text-lg sm:text-xl text-blue-50 leading-8">Smart Edu Higher Education Institute delivers industry-aligned diplomas, degrees, professional certifications, and flexible learning pathways for ambitious students.</p>
                    <div class="mt-9 flex flex-col sm:flex-row gap-4">
                        <a href="#courses" class="inline-flex justify-center px-7 py-3.5 rounded-full bg-white text-blue-800 font-bold hover:bg-blue-50">Explore Courses</a>
                        <a href="#contact" class="inline-flex justify-center px-7 py-3.5 rounded-full bg-blue-600/80 ring-1 ring-white/30 font-bold hover:bg-blue-600">Talk to a Counselor</a>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 grid grid-cols-2 md:grid-cols-4 gap-6">
                <div class="rounded-3xl bg-slate-50 p-6 text-center border border-slate-100">
                    <p class="text-3xl font-extrabold text-blue-700">15+</p>
                    <p class="mt-1 text-sm font-semibold text-slate-600">Years of Excellence</p>
                </div>
                <div class="rounded-3xl bg-slate-50 p-6 text-center border border-slate-100">
                    <p class="text-3xl font-extrabold text-blue-700">8</p>
                    <p class="mt-1 text-sm font-semibold text-slate-600">Academic Schools</p>
                </div>
                <div class="rounded-3xl bg-slate-50 p-6 text-center border border-slate-100">
                    <p class="text-3xl font-extrabold text-blue-700">120+</p>
                    <p class="mt-1 text-sm font-semibold text-slate-600">Lecturers</p>
                </div>
                <div class="rounded-3xl bg-slate-50 p-6 text-center border border-slate-100">
                    <p class="text-3xl font-extrabold text-blue-700">10k+</p>
                    <p class="mt-1 text-sm font-semibold text-slate-600">Students Trained</p>
                </div>
            </div>
        </section>

        <section id="about" class="py-20">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-12 items-center">
                <div>
                    <p class="text-sm font-extrabold tracking-wider text-blue-700 uppercase">Welcome to Smart Edu</p>
                    <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-slate-900">A modern institute built for academic excellence and employability</h2>
                    <p class="mt-5 text-slate-600 leading-8">Smart Edu combines practical teaching, digital learning support, academic mentoring, and career-focused training. Our programmes are designed to help students progress from foundation knowledge to advanced professional capability.</p>
                    <div class="mt-8 grid sm:grid-cols-2 gap-4">
                        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm">
                            <p class="font-bold text-slate-900">Flexible Learning</p>
                            <p class="mt-2 text-sm text-slate-600">Weekday, weekend, hybrid, and online study options.</p>
                        </div>
                        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm">
                            <p class="font-bold text-slate-900">Career Support</p>
                            <p class="mt-2 text-sm text-slate-600">CV clinics, internships, workshops, and placement guidance.</p>
                        </div>
                    </div>
                </div>
                <div class="relative">
                    <img class="rounded-[2rem] shadow-2xl object-cover h-[420px] w-full" src="https://images.unsplash.com/photo-1523580846011-d3a5bc25702b?auto=format&fit=crop&w=1200&q=80" alt="Students learning at Smart Edu" />
                    <div class="absolute -bottom-6 -left-6 bg-white rounded-3xl p-6 shadow-xl max-w-xs hidden sm:block">
                        <p class="text-4xl font-extrabold text-blue-700">95%</p>
                        <p class="mt-1 text-sm font-semibold text-slate-600">student satisfaction across academic support and learning resources</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="courses" class="py-20 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
                    <div>
                        <p class="text-sm font-extrabold tracking-wider text-blue-700 uppercase">Explore Our Courses</p>
                        <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-slate-900">Programmes designed for future careers</h2>
                    </div>
                    <a href="#" class="inline-flex px-5 py-3 rounded-full bg-slate-900 text-white text-sm font-bold hover:bg-slate-700">View All Courses</a>
                </div>

                <div class="mt-10 grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <article class="rounded-3xl border border-slate-200 p-6 hover:shadow-xl transition bg-white">
                        <span class="text-xs font-bold text-blue-700 bg-blue-50 px-3 py-1 rounded-full">School of Computing</span>
                        <h3 class="mt-5 text-xl font-extrabold text-slate-900">HND in Software Engineering</h3>
                        <p class="mt-3 text-sm text-slate-600 leading-6">Learn programming, databases, web development, software design, and project delivery.</p>
                        <a href="#" class="mt-6 inline-flex font-bold text-blue-700 hover:text-blue-900">Discover Details →</a>
                    </article>
                    <article class="rounded-3xl border border-slate-200 p-6 hover:shadow-xl transition bg-white">
                        <span class="text-xs font-bold text-purple-700 bg-purple-50 px-3 py-1 rounded-full">School of Business</span>
                        <h3 class="mt-5 text-xl font-extrabold text-slate-900">Diploma in Business Management</h3>
                        <p class="mt-3 text-sm text-slate-600 leading-6">Develop foundations in management, marketing, finance, and entrepreneurship.</p>
                        <a href="#" class="mt-6 inline-flex font-bold text-blue-700 hover:text-blue-900">Discover Details →</a>
                    </article>
                    <article class="rounded-3xl border border-slate-200 p-6 hover:shadow-xl transition bg-white">
                        <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full">School of Technology</span>
                        <h3 class="mt-5 text-xl font-extrabold text-slate-900">Certificate in Cyber Security</h3>
                        <p class="mt-3 text-sm text-slate-600 leading-6">Study network security, ethical hacking basics, cyber risks, and defensive practices.</p>
                        <a href="#" class="mt-6 inline-flex font-bold text-blue-700 hover:text-blue-900">Discover Details →</a>
                    </article>
                </div>
            </div>
        </section>

        <section id="schools" class="py-20 bg-slate-900 text-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="max-w-3xl">
                    <p class="text-sm font-extrabold tracking-wider text-blue-300 uppercase">Our Schools</p>
                    <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold">Academic pathways for every ambition</h2>
                    <p class="mt-5 text-slate-300 leading-8">Each school supports a focused learning pathway with specialist lecturers, structured modules, and practical assessment methods.</p>
                </div>
                <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
                    <div class="rounded-3xl bg-white/10 p-6 ring-1 ring-white/10">School of Computing</div>
                    <div class="rounded-3xl bg-white/10 p-6 ring-1 ring-white/10">School of Business</div>
                    <div class="rounded-3xl bg-white/10 p-6 ring-1 ring-white/10">School of Engineering</div>
                    <div class="rounded-3xl bg-white/10 p-6 ring-1 ring-white/10">School of Languages</div>
                </div>
            </div>
        </section>

        <section id="student-life" class="py-20 bg-slate-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-3xl mx-auto">
                    <p class="text-sm font-extrabold tracking-wider text-blue-700 uppercase">Student Life</p>
                    <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-slate-900">Learning beyond classrooms</h2>
                    <p class="mt-5 text-slate-600 leading-8">Smart Edu supports students with academic clubs, innovation challenges, workshops, sports activities, and community events.</p>
                </div>
                <div class="mt-10 grid md:grid-cols-3 gap-6">
                    <div class="rounded-3xl bg-white p-6 border border-slate-200 shadow-sm">
                        <h3 class="font-extrabold text-lg">Innovation Clubs</h3>
                        <p class="mt-3 text-sm text-slate-600 leading-6">Participate in coding, robotics, business idea, and research clubs.</p>
                    </div>
                    <div class="rounded-3xl bg-white p-6 border border-slate-200 shadow-sm">
                        <h3 class="font-extrabold text-lg">Career Events</h3>
                        <p class="mt-3 text-sm text-slate-600 leading-6">Meet employers and industry mentors through career-focused activities.</p>
                    </div>
                    <div class="rounded-3xl bg-white p-6 border border-slate-200 shadow-sm">
                        <h3 class="font-extrabold text-lg">Student Support</h3>
                        <p class="mt-3 text-sm text-slate-600 leading-6">Access academic counseling, assignment guidance, and peer support.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-20 bg-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-3 gap-6">
                <div class="lg:col-span-1">
                    <p class="text-sm font-extrabold tracking-wider text-blue-700 uppercase">Latest Updates</p>
                    <h2 class="mt-3 text-3xl font-extrabold text-slate-900">News and events</h2>
                    <p class="mt-4 text-slate-600 leading-7">Stay updated with admissions, open days, workshops, and student achievements.</p>
                </div>
                <div class="lg:col-span-2 grid md:grid-cols-2 gap-6">
                    <article class="rounded-3xl border border-slate-200 p-6">
                        <p class="text-sm font-semibold text-slate-500">May 20, 2026</p>
                        <h3 class="mt-3 font-extrabold text-xl">Open Day for 2026 Intake</h3>
                        <p class="mt-3 text-sm text-slate-600 leading-6">Meet lecturers, explore programmes, and receive course counseling.</p>
                    </article>
                    <article class="rounded-3xl border border-slate-200 p-6">
                        <p class="text-sm font-semibold text-slate-500">June 05, 2026</p>
                        <h3 class="mt-3 font-extrabold text-xl">Technology Career Workshop</h3>
                        <p class="mt-3 text-sm text-slate-600 leading-6">A practical session on software engineering, cloud, and AI career paths.</p>
                    </article>
                </div>
            </div>
        </section>

        <section id="apply" class="py-20 bg-blue-700 text-white">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                <h2 class="text-3xl sm:text-4xl font-extrabold">Your path to excellence begins here</h2>
                <p class="mt-5 text-blue-50 max-w-2xl mx-auto leading-8">Apply online or speak to an academic counselor to find the most suitable programme for your education and career goals.</p>
                <div class="mt-8 flex flex-col sm:flex-row justify-center gap-4">
                    <a href="#contact" class="px-7 py-3.5 rounded-full bg-white text-blue-800 font-bold hover:bg-blue-50">Make an Inquiry</a>
                    <a href="#courses" class="px-7 py-3.5 rounded-full bg-blue-900 text-white font-bold hover:bg-blue-950">Browse Courses</a>
                </div>
            </div>
        </section>
    </main>

    <footer id="contact" class="bg-slate-950 text-slate-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grid md:grid-cols-4 gap-8">
            <div class="md:col-span-2">
                <p class="text-2xl font-extrabold text-white">Smart Edu Higher Education Institute</p>
                <p class="mt-4 max-w-md leading-7">A student-centered higher education institute focused on quality teaching, employability, and lifelong learning.</p>
            </div>
            <div>
                <p class="font-bold text-white">Quick Links</p>
                <ul class="mt-4 space-y-2 text-sm">
                    <li><a href="#courses" class="hover:text-white">Courses</a></li>
                    <li><a href="#schools" class="hover:text-white">Schools</a></li>
                    <li><a href="#student-life" class="hover:text-white">Student Life</a></li>
                    <li><a href="#apply" class="hover:text-white">Apply Online</a></li>
                </ul>
            </div>
            <div>
                <p class="font-bold text-white">Contact</p>
                <ul class="mt-4 space-y-2 text-sm">
                    <li>Colombo, Sri Lanka</li>
                    <li>info@smartedu.lk</li>
                    <li>+94 11 234 5678</li>
                </ul>
            </div>
        </div>
        <div class="border-t border-white/10 py-5 text-center text-sm">© 2026 Smart Edu Higher Education Institute. All rights reserved.</div>

        <div>
            @RenderBody()
        </div>
    </footer>
</body>
</html>

