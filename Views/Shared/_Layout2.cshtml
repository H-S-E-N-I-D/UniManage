<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LearnSpace LMS</title>
    <script type="importmap"></script>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'lms-primary':   '#1a6b8a',
                        'lms-dark':      '#124d66',
                        'lms-light':     '#e0f4fb',
                        'lms-accent':    '#63d3f5',
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UserRoles.styles.css" asp-append-version="true" />
    <style>
        /* Sidebar active & hover state helpers not covered cleanly by Tailwind alone */
        .nav-item-active {
            background: rgba(255,255,255,0.14);
            border-left: 3px solid #63d3f5;
            color: #fff;
        }
        .nav-item-base {
            border-left: 3px solid transparent;
        }
        .sub-menu-open  { display: block !important; }
        .arrow-open     { transform: rotate(90deg); }
        /* Thin scrollbar for sidebar */
        .sidebar-scroll::-webkit-scrollbar { width: 4px; }
        .sidebar-scroll::-webkit-scrollbar-track { background: transparent; }
        .sidebar-scroll::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 4px; }
    </style>
</head>
<body class="bg-slate-100 font-sans">

<div class="flex h-screen overflow-hidden">

    <!-- ─────────────────────────────────────────────────────────
         LEFT SIDEBAR
    ───────────────────────────────────────────────────────────── -->
    <aside class="w-60 min-w-[240px] bg-[#1a6b8a] flex flex-col overflow-y-auto sidebar-scroll flex-shrink-0">

        <!-- Logo -->
        <div class="flex items-center gap-3 px-5 py-[18px] border-b border-white/10">
            <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-[18px] h-[18px] text-lms-primary" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/>
                </svg>
            </div>
            <div>
                <span class="block text-white text-[15px] font-medium leading-tight">LearnSpace</span>
                <span class="block text-white/50 text-[11px]">eLMS Platform</span>
            </div>
        </div>

        <!-- ── MAIN ── -->
        <div class="pt-4 pb-1">
            <p class="text-[10px] font-medium text-white/40 uppercase tracking-widest px-5 pb-1.5">Main</p>

            <!-- Dashboard -->
            <a asp-area="" asp-controller="Home" asp-action="Index"
               class="nav-item-base flex items-center gap-2.5 px-5 py-[9px] text-[13px] text-white/80 hover:bg-white/10 hover:text-white transition-all @(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "nav-item-active" : "")">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
                    <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
                    <rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
                </svg>
                Dashboard
            </a>

            <!-- Courses (expandable) -->
            <button type="button" onclick="toggleSub('courses-sub','courses-arr')"
                    class="nav-item-base w-full flex items-center gap-2.5 px-5 py-[9px] text-[13px] text-white/80 hover:bg-white/10 hover:text-white transition-all">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
                    <path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/>
                </svg>
                Courses
                <svg id="courses-arr" class="ml-auto w-3 h-3 opacity-50 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" viewBox="0 0 24 24">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
            </button>
            <div id="courses-sub" class="hidden bg-black/10">
                <a asp-controller="Courses" asp-action="Index"  class="flex items-center gap-2.5 pl-[46px] pr-5 py-[7px] text-[12.5px] text-white/65 hover:text-white hover:bg-white/5"><span class="w-1.5 h-1.5 rounded-full bg-current flex-shrink-0"></span>All Courses</a>
                <a asp-controller="Courses" asp-action="Create" class="flex items-center gap-2.5 pl-[46px] pr-5 py-[7px] text-[12.5px] text-white/65 hover:text-white hover:bg-white/5"><span class="w-1.5 h-1.5 rounded-full bg-current flex-shrink-0"></span>Create Course</a>
                <a asp-controller="Courses" asp-action="Categories" class="flex items-center gap-2.5 pl-[46px] pr-5 py-[7px] text-[12.5px] text-white/65 hover:text-white hover:bg-white/5"><span class="w-1.5 h-1.5 rounded-full bg-current flex-shrink-0"></span>Categories</a>
                <a asp-controller="Courses" asp-action="Certificates" class="flex items-center gap-2.5 pl-[46px] pr-5 py-[7px] text-[12.5px] text-white/65 hover:text-white hover:bg-white/5"><span class="w-1.5 h-1.5 rounded-full bg-current flex-shrink-0"></span>Certificates</a>
            </div>

            <!-- Students (expandable, role-guarded) -->
            @if (User.IsInRole("Admin") || User.IsInRole("Lecturer"))
            {
                <button type="button" onclick="toggleSub('students-sub','students-arr')"
                        class="nav-item-base w-full flex items-center gap-2.5 px-5 py-[9px] text-[13px] text-white/80 hover:bg-white/10 hover:text-white transition-all">
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
                        <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                    </svg>
                    Students
                    <svg id="students-arr" class="ml-auto w-3 h-3 opacity-50 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" viewBox="0 0 24 24">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </button>
                <div id="students-sub" class="hidden bg-black/10">
                    <a asp-controller="Students" asp-action="Index"   class="flex items-center gap-2.5 pl-[46px] pr-5 py-[7px] text-[12.5px] text-white/65 hover:text-white hover:bg-white/5"><span class="w-1.5 h-1.5 rounded-full bg-current flex-shrink-0"></span>All Students</a>
                    <a asp-controller="Students" asp-action="Enrol"   class="flex items-center gap-2.5 pl-[46px] pr-5 py-[7px] text-[12.5px] text-white/65 hover:text-white hover:bg-white/5"><span class="w-1.5 h-1.5 rounded-full bg-current flex-shrink-0"></span>Enrolments</a>
                    <a asp-controller="Students" asp-action="Progress" class="flex items-center gap-2.5 pl-[46px] pr-5 py-[7px] text-[12.5px] text-white/65 hover:text-white hover:bg-white/5"><span class="w-1.5 h-1.5 rounded-full bg-current flex-shrink-0"></span>Progress Reports</a>
                </div>
            }

            <!-- Lecturers (expandable, role-guarded) -->
            @if (User.IsInRole("Admin"))
            {
                <button type="button" onclick="toggleSub('lect-sub','lect-arr')"
                        class="nav-item-base w-full flex items-center gap-2.5 px-5 py-[9px] text-[13px] text-white/80 hover:bg-white/10 hover:text-white transition-all">
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
                        <circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 10-16 0"/><path d="M12 12v9"/><path d="M9 18l3 3 3-3"/>
                    </svg>
                    Lecturers
                    <svg id="lect-arr" class="ml-auto w-3 h-3 opacity-50 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" viewBox="0 0 24 24">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </button>
                <div id="lect-sub" class="hidden bg-black/10">
                    <a asp-controller="Home" asp-action="Lecturer"    class="flex items-center gap-2.5 pl-[46px] pr-5 py-[7px] text-[12.5px] text-white/65 hover:text-white hover:bg-white/5"><span class="w-1.5 h-1.5 rounded-full bg-current flex-shrink-0"></span>All Lecturers</a>
                    <a asp-controller="Lecturers" asp-action="Assign"  class="flex items-center gap-2.5 pl-[46px] pr-5 py-[7px] text-[12.5px] text-white/65 hover:text-white hover:bg-white/5"><span class="w-1.5 h-1.5 rounded-full bg-current flex-shrink-0"></span>Assign Courses</a>
                    <a asp-controller="Lecturers" asp-action="Schedule" class="flex items-center gap-2.5 pl-[46px] pr-5 py-[7px] text-[12.5px] text-white/65 hover:text-white hover:bg-white/5"><span class="w-1.5 h-1.5 rounded-full bg-current flex-shrink-0"></span>Schedule</a>
                </div>
            }

            <!-- Student view -->
            @if (User.IsInRole("Student"))
            {
                <a asp-controller="Home" asp-action="Student"
                   class="nav-item-base flex items-center gap-2.5 px-5 py-[9px] text-[13px] text-white/80 hover:bg-white/10 hover:text-white transition-all">
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
                        <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/>
                    </svg>
                    My Courses
                </a>
            }
        </div>

        <!-- ── LEARNING ── -->
        <div class="pt-4 pb-1">
            <p class="text-[10px] font-medium text-white/40 uppercase tracking-widest px-5 pb-1.5">Learning</p>

            <a asp-controller="Classes" asp-action="Index"
               class="nav-item-base flex items-center gap-2.5 px-5 py-[9px] text-[13px] text-white/80 hover:bg-white/10 hover:text-white transition-all">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
                    <polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/>
                </svg>
                Live Classes
                <span class="ml-auto bg-lms-accent text-[#0a3d52] text-[10px] font-medium px-1.5 py-0.5 rounded-full">3</span>
            </a>

            <a asp-controller="Assessments" asp-action="Index"
               class="nav-item-base flex items-center gap-2.5 px-5 py-[9px] text-[13px] text-white/80 hover:bg-white/10 hover:text-white transition-all">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
                    <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
                </svg>
                Assessments
            </a>

            <a asp-controller="Timetable" asp-action="Index"
               class="nav-item-base flex items-center gap-2.5 px-5 py-[9px] text-[13px] text-white/80 hover:bg-white/10 hover:text-white transition-all">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                Timetable
            </a>

            <a asp-controller="Discussions" asp-action="Index"
               class="nav-item-base flex items-center gap-2.5 px-5 py-[9px] text-[13px] text-white/80 hover:bg-white/10 hover:text-white transition-all">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
                    <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                </svg>
                Discussions
            </a>
        </div>

        <!-- ── ADMINISTRATION ── -->
        @if (User.IsInRole("Admin"))
        {
            <div class="pt-4 pb-4">
                <p class="text-[10px] font-medium text-white/40 uppercase tracking-widest px-5 pb-1.5">Administration</p>

                <a asp-controller="Home" asp-action="Admin"
                   class="nav-item-base flex items-center gap-2.5 px-5 py-[9px] text-[13px] text-white/80 hover:bg-white/10 hover:text-white transition-all">
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                    Roles &amp; Access
                </a>

                <a asp-controller="Analytics" asp-action="Index"
                   class="nav-item-base flex items-center gap-2.5 px-5 py-[9px] text-[13px] text-white/80 hover:bg-white/10 hover:text-white transition-all">
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
                        <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
                    </svg>
                    Analytics
                </a>

                <a asp-controller="Settings" asp-action="Index"
                   class="nav-item-base flex items-center gap-2.5 px-5 py-[9px] text-[13px] text-white/80 hover:bg-white/10 hover:text-white transition-all">
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="3"/>
                        <path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/>
                        <path d="M12 2v2M12 20v2M2 12h2M20 12h2"/>
                    </svg>
                    Settings
                </a>
            </div>
        }
    </aside>

    <!-- ─────────────────────────────────────────────────────────
         MAIN AREA
    ───────────────────────────────────────────────────────────── -->
    <div class="flex flex-col flex-1 min-w-0 overflow-hidden">

        <!-- TOP BAR -->
        <header class="h-14 bg-white border-b border-slate-200 flex items-center px-5 gap-2 flex-shrink-0 relative z-10">

            <!-- Page title injected by views -->
            <div class="flex-1 text-sm font-medium text-slate-800">
                @ViewData["Title"]
                <span class="text-slate-400 font-normal text-xs ml-1.5">@ViewData["Breadcrumb"]</span>
            </div>

            <!-- Notification Bell -->
            <div class="relative" id="notif-wrap">
                <button type="button" onclick="toggleDrop('notif-dd')"
                        class="relative w-9 h-9 rounded-lg flex items-center justify-center text-slate-500 hover:bg-slate-100 hover:text-slate-800 transition-colors">
                    <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
                        <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/>
                    </svg>
                    <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
                </button>
                <!-- Notification dropdown -->
                <div id="notif-dd"
                     class="hidden absolute right-0 top-12 w-72 bg-white border border-slate-200 rounded-xl shadow-lg overflow-hidden z-50">
                    <div class="flex items-center justify-between px-3.5 py-3 border-b border-slate-100">
                        <span class="text-sm font-medium text-slate-800">Notifications</span>
                        <button class="text-xs text-lms-primary hover:underline">Mark all read</button>
                    </div>
                    <div class="flex gap-2.5 items-start px-3.5 py-2.5 bg-sky-50 border-b border-slate-100">
                        <div class="w-7 h-7 rounded-full bg-sky-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                            <svg class="w-3.5 h-3.5 text-sky-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
                        </div>
                        <div><p class="text-xs text-slate-700 leading-snug">New course <strong>React Fundamentals</strong> was published</p><p class="text-[11px] text-slate-400 mt-0.5">2 min ago</p></div>
                    </div>
                    <div class="flex gap-2.5 items-start px-3.5 py-2.5 bg-sky-50 border-b border-slate-100">
                        <div class="w-7 h-7 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                            <svg class="w-3.5 h-3.5 text-emerald-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                        </div>
                        <div><p class="text-xs text-slate-700 leading-snug">14 new students enrolled today</p><p class="text-[11px] text-slate-400 mt-0.5">1 hr ago</p></div>
                    </div>
                    <div class="flex gap-2.5 items-start px-3.5 py-2.5 border-b border-slate-100">
                        <div class="w-7 h-7 rounded-full bg-amber-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                            <svg class="w-3.5 h-3.5 text-amber-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/></svg>
                        </div>
                        <div><p class="text-xs text-slate-700 leading-snug">Assessment deadline in 2 days</p><p class="text-[11px] text-slate-400 mt-0.5">3 hr ago</p></div>
                    </div>
                    <a asp-controller="Notifications" asp-action="Index"
                       class="block text-center text-xs text-lms-primary py-2.5 hover:bg-slate-50 font-medium">View all notifications</a>
                </div>
            </div>

            <!-- Chat Icon -->
            <button type="button"
                    class="w-9 h-9 rounded-lg flex items-center justify-center text-slate-500 hover:bg-slate-100 hover:text-slate-800 transition-colors">
                <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
                    <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                </svg>
            </button>

            <!-- Divider -->
            <div class="w-px h-6 bg-slate-200 mx-1"></div>

            <!-- Profile -->
            <div class="relative" id="profile-wrap">
                <button type="button" onclick="toggleDrop('profile-dd')"
                        class="flex items-center gap-2 pl-1 pr-2 py-1 rounded-lg hover:bg-slate-100 transition-colors">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-lms-primary to-lms-accent flex items-center justify-center text-white text-[11px] font-medium flex-shrink-0">
                        @(User.Identity?.Name?.Length > 0 ? User.Identity.Name.Substring(0,2).ToUpper() : "AD")
                    </div>
                    <div class="text-left leading-tight">
                        <span class="block text-xs font-medium text-slate-800">@(User.Identity?.Name ?? "Admin User")</span>
                        <span class="block text-[11px] text-slate-400">
                            @if (User.IsInRole("Admin")) { <text>Administrator</text> }
                            else if (User.IsInRole("Lecturer")) { <text>Lecturer</text> }
                            else if (User.IsInRole("Student")) { <text>Student</text> }
                            else { <text>User</text> }
                        </span>
                    </div>
                    <svg class="w-3 h-3 text-slate-400 ml-1" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" viewBox="0 0 24 24">
                        <polyline points="6 9 12 15 18 9"/>
                    </svg>
                </button>

                <!-- Profile Dropdown -->
                <div id="profile-dd"
                     class="hidden absolute right-0 top-12 w-48 bg-white border border-slate-200 rounded-xl shadow-lg overflow-hidden z-50">
                    <a asp-controller="Profile" asp-action="Index"
                       class="flex items-center gap-2.5 px-3.5 py-2.5 text-sm text-slate-700 hover:bg-slate-50">
                        <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
                            <circle cx="12" cy="8" r="4"/><path d="M20 21a8 8 0 10-16 0"/>
                        </svg>
                        View Profile
                    </a>
                    <a asp-controller="Settings" asp-action="Index"
                       class="flex items-center gap-2.5 px-3.5 py-2.5 text-sm text-slate-700 hover:bg-slate-50">
                        <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="3"/>
                            <path d="M12 2v2M12 20v2M2 12h2M20 12h2"/>
                        </svg>
                        Settings
                    </a>
                    <div class="border-t border-slate-100"></div>
                    <a asp-controller="Account" asp-action="Logout"
                       class="flex items-center gap-2.5 px-3.5 py-2.5 text-sm text-red-500 hover:bg-red-50">
                        <svg class="w-3.5 h-3.5 opacity-70" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24">
                            <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/>
                            <polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
                        </svg>
                        Sign Out
                    </a>
                </div>
            </div>
        </header>

        <!-- PAGE CONTENT -->
        <main class="flex-1 overflow-y-auto p-5" role="main">
            @RenderBody()
        </main>

        <!-- FOOTER -->
        <footer class="h-10 bg-white border-t border-slate-200 flex items-center px-5 flex-shrink-0">
            <span class="text-xs text-slate-400">
                &copy; 2025 LearnSpace LMS &mdash;
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="hover:text-lms-primary transition-colors">Privacy Policy</a>
            </span>
        </footer>
    </div>
</div>

<!-- ─── Scripts ─── -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)

<script>
    function toggleSub(subId, arrowId) {
        var sub   = document.getElementById(subId);
        var arrow = document.getElementById(arrowId);
        var isOpen = !sub.classList.contains('hidden');
        sub.classList.toggle('hidden', isOpen);
        arrow.classList.toggle('arrow-open', !isOpen);
    }

    function toggleDrop(id) {
        var dropIds = ['profile-dd', 'notif-dd'];
        dropIds.forEach(function (d) {
            if (d !== id) document.getElementById(d).classList.add('hidden');
        });
        document.getElementById(id).classList.toggle('hidden');
    }

    document.addEventListener('click', function (e) {
        if (!e.target.closest('#profile-wrap') && !e.target.closest('#notif-wrap')) {
            ['profile-dd', 'notif-dd'].forEach(function (d) {
                document.getElementById(d)?.classList.add('hidden');
            });
        }
    });
</script>
</body>
</html>
