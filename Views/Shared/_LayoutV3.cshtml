<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UserRoles</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#effbff',
                            100: '#d7f4fe',
                            200: '#b3ebfd',
                            300: '#7ddffb',
                            400: '#3cccf6',
                            500: '#14b7ea',
                            600: '#0899c8',
                            700: '#0d7aa0',
                            800: '#135f7d',
                            900: '#164f67'
                        },
                        sidebar: {
                            DEFAULT: '#0d7a8a',
                            dark:    '#0a6475',
                            darker:  '#085260'
                        }
                    },
                    boxShadow: {
                        panel: '0 10px 30px rgba(15, 23, 42, 0.08)'
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UserRoles.styles.css" asp-append-version="true" />
    <style>
        /* Sidebar solid teal colour that matches the reference image */
        #sidebar { background: linear-gradient(180deg, #0d7a8a 0%, #0a6475 50%, #085260 100%); }
    </style>
</head>
<body class="h-full font-sans text-slate-700 antialiased">
    <div class="min-h-screen bg-slate-50">
        <div class="flex min-h-screen">

            <!-- =====================  SIDEBAR  ===================== -->
            <!-- Width changed: w-72 (288px) → w-64 (256px) to match the image's narrower nav -->
            <aside id="sidebar" class="fixed inset-y-0 left-0 z-40 w-64 -translate-x-full overflow-y-auto text-white shadow-2xl transition-transform duration-300 lg:translate-x-0">

                <!-- Logo / brand area -->
                <div class="flex items-center justify-between border-b border-white/10 px-6 py-6">
                    <div>
                        <p class="text-[10px] font-semibold uppercase tracking-[0.35em] text-white/60">ELMS Admin</p>
                        <h1 class="mt-0.5 text-2xl font-extrabold tracking-tight">EduFlow</h1>
                    </div>
                    <button id="closeSidebar" class="rounded-lg p-2 text-white/80 hover:bg-white/10 hover:text-white lg:hidden">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>

                <!-- Navigation -->
                <nav class="px-4 py-6 text-sm">
                    <p class="px-3 pb-4 text-[10px] font-bold uppercase tracking-[0.3em] text-white/50">Navigation</p>

                    <!-- Dashboard (active) -->
                    <a href="#" class="mb-1.5 flex items-center gap-3 rounded-xl bg-white/15 px-4 py-3 font-semibold text-white shadow ring-1 ring-white/10 transition hover:bg-white/20">
                        <i class="fa-solid fa-gauge-high w-5 text-center text-white/80"></i>
                        <span>Dashboard</span>
                    </a>

                    <!-- Courses submenu -->
                    <div class="mb-1.5 overflow-hidden rounded-xl">
                        <button type="button" class="submenu-toggle flex w-full items-center justify-between px-4 py-3 text-left font-medium text-white/85 transition hover:bg-white/10" data-target="coursesMenu">
                            <span class="flex items-center gap-3">
                                <i class="fa-solid fa-book-open-reader w-5 text-center text-white/70"></i>
                                <span>Courses</span>
                            </span>
                            <i class="fa-solid fa-chevron-down text-xs transition-transform text-white/60"></i>
                        </button>
                        <div id="coursesMenu" class="submenu hidden space-y-0.5 bg-white/5 px-4 pb-3 pt-1">
                            <a href="#" class="block rounded-lg px-8 py-2 text-white/75 hover:bg-white/10 hover:text-white">All Courses</a>
                            <a href="#" class="block rounded-lg px-8 py-2 text-white/75 hover:bg-white/10 hover:text-white">Course Categories</a>
                            <a href="#" class="block rounded-lg px-8 py-2 text-white/75 hover:bg-white/10 hover:text-white">Assignments</a>
                        </div>
                    </div>

                    <!-- Users submenu -->
                    <div class="mb-1.5 overflow-hidden rounded-xl">
                        <button type="button" class="submenu-toggle flex w-full items-center justify-between px-4 py-3 text-left font-medium text-white/85 transition hover:bg-white/10" data-target="usersMenu">
                            <span class="flex items-center gap-3">
                                <i class="fa-solid fa-users w-5 text-center text-white/70"></i>
                                <span>Users</span>
                            </span>
                            <i class="fa-solid fa-chevron-down text-xs transition-transform text-white/60"></i>
                        </button>
                        <div id="usersMenu" class="submenu hidden space-y-0.5 bg-white/5 px-4 pb-3 pt-1">
                            <a href="#" class="block rounded-lg px-8 py-2 text-white/75 hover:bg-white/10 hover:text-white">Students</a>
                            <a href="#" class="block rounded-lg px-8 py-2 text-white/75 hover:bg-white/10 hover:text-white">Lecturers</a>
                            <a href="#" class="block rounded-lg px-8 py-2 text-white/75 hover:bg-white/10 hover:text-white">Administrators</a>
                        </div>
                    </div>

                    <!-- Academic Calendar -->
                    <a href="#" class="mb-1.5 flex items-center gap-3 rounded-xl px-4 py-3 font-medium text-white/85 transition hover:bg-white/10 hover:text-white">
                        <i class="fa-solid fa-calendar-days w-5 text-center text-white/70"></i>
                        <span>Academic Calendar</span>
                    </a>

                    <!-- Reports -->
                    <a href="#" class="mb-1.5 flex items-center gap-3 rounded-xl px-4 py-3 font-medium text-white/85 transition hover:bg-white/10 hover:text-white">
                        <i class="fa-solid fa-chart-column w-5 text-center text-white/70"></i>
                        <span>Reports</span>
                    </a>

                    <!-- Settings submenu -->
                    <div class="mb-1.5 overflow-hidden rounded-xl">
                        <button type="button" class="submenu-toggle flex w-full items-center justify-between px-4 py-3 text-left font-medium text-white/85 transition hover:bg-white/10" data-target="settingsMenu">
                            <span class="flex items-center gap-3">
                                <i class="fa-solid fa-gear w-5 text-center text-white/70"></i>
                                <span>Settings</span>
                            </span>
                            <i class="fa-solid fa-chevron-down text-xs transition-transform text-white/60"></i>
                        </button>
                        <div id="settingsMenu" class="submenu hidden space-y-0.5 bg-white/5 px-4 pb-3 pt-1">
                            <a href="#" class="block rounded-lg px-8 py-2 text-white/75 hover:bg-white/10 hover:text-white">General</a>
                            <a href="#" class="block rounded-lg px-8 py-2 text-white/75 hover:bg-white/10 hover:text-white">Permissions</a>
                            <a href="#" class="block rounded-lg px-8 py-2 text-white/75 hover:bg-white/10 hover:text-white">Integrations</a>
                        </div>
                    </div>
                </nav>
            </aside>

            <!-- ================  MAIN CONTENT AREA  ================ -->
            <!-- pl updated from lg:pl-72 → lg:pl-64 to match new sidebar width -->
            <div class="flex min-w-0 flex-1 flex-col lg:pl-64">

                <!-- Top header bar -->
                <header class="sticky top-0 z-30 border-b border-slate-200/70 bg-white/90 backdrop-blur">
                    <div class="flex items-center justify-between gap-4 px-6 py-4 sm:px-8 lg:px-10">
                        <div class="flex items-center gap-4">
                            <!-- Mobile sidebar toggle -->
                            <button id="openSidebar" class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 shadow-sm transition hover:bg-slate-50 lg:hidden">
                                <i class="fa-solid fa-bars"></i>
                            </button>
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-700">Learning Management</p>
                                <h2 class="text-xl font-bold text-slate-800">Modern Admin Dashboard</h2>
                            </div>
                        </div>

                        <!-- Right-side controls -->
                        <div class="flex items-center gap-3">
                            <!-- Notifications -->
                            <button class="relative inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 shadow-sm transition hover:-translate-y-0.5 hover:text-brand-700">
                                <i class="fa-regular fa-bell text-lg"></i>
                                <span class="absolute right-2 top-2 h-2.5 w-2.5 rounded-full bg-rose-500"></span>
                            </button>
                            <!-- Messages -->
                            <button class="relative inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-600 shadow-sm transition hover:-translate-y-0.5 hover:text-brand-700">
                                <i class="fa-regular fa-comments text-lg"></i>
                                <span class="absolute right-2 top-2 h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
                            </button>

                            <!-- Profile menu -->
                            <div class="relative">
                                <button id="profileMenuButton" class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-white px-3 py-2 shadow-sm transition hover:border-brand-200 hover:bg-slate-50">
                                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-100 text-brand-700">
                                        <i class="fa-regular fa-user"></i>
                                    </div>
                                    <div class="hidden text-left sm:block">
                                        <p class="text-sm font-semibold text-slate-800">Admin User</p>
                                        <p class="text-xs text-slate-500">System Administrator</p>
                                    </div>
                                    <i class="fa-solid fa-chevron-down text-xs text-slate-400"></i>
                                </button>

                                <div id="profileMenu" class="absolute right-0 mt-3 hidden w-56 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
                                    <div class="border-b border-slate-100 px-4 py-3">
                                        <p class="text-sm font-semibold text-slate-800">Account Menu</p>
                                        <p class="text-xs text-slate-500">Manage your session</p>
                                    </div>
                                    <a href="#" class="flex items-center gap-3 px-4 py-3 text-sm text-slate-700 transition hover:bg-slate-50 hover:text-brand-700">
                                        <i class="fa-regular fa-id-badge w-4 text-center"></i>
                                        <span>View Profile</span>
                                    </a>
                                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                        <button type="submit" class="flex w-full items-center gap-3 px-4 py-3 text-left text-sm text-rose-600 transition hover:bg-rose-50">
                                            <i class="fa-solid fa-arrow-right-from-bracket w-4 text-center"></i>
                                            <span>Sign Out</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </header>

                <!-- Page body -->
                <!-- Increased padding: px-6 py-8 sm:px-8 lg:px-12 for a more spacious feel -->
                <main class="flex-1 px-6 py-8 sm:px-8 lg:px-12">

                    <!-- Stats cards — gap and card padding slightly increased -->
                    <div class="mb-8 grid gap-5 md:grid-cols-2 xl:grid-cols-4">

                        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-sm text-slate-500">Active Students</p>
                                    <h3 class="mt-2 text-3xl font-bold text-slate-800">1,248</h3>
                                </div>
                                <div class="rounded-2xl bg-brand-50 p-4 text-brand-700"><i class="fa-solid fa-user-graduate text-xl"></i></div>
                            </div>
                            <p class="mt-4 text-xs text-emerald-600">+12% compared to last month</p>
                        </div>

                        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-sm text-slate-500">Courses Running</p>
                                    <h3 class="mt-2 text-3xl font-bold text-slate-800">86</h3>
                                </div>
                                <div class="rounded-2xl bg-emerald-50 p-4 text-emerald-600"><i class="fa-solid fa-book text-xl"></i></div>
                            </div>
                            <p class="mt-4 text-xs text-slate-500">14 newly published this semester</p>
                        </div>

                        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-sm text-slate-500">Pending Reviews</p>
                                    <h3 class="mt-2 text-3xl font-bold text-slate-800">32</h3>
                                </div>
                                <div class="rounded-2xl bg-amber-50 p-4 text-amber-600"><i class="fa-solid fa-file-circle-check text-xl"></i></div>
                            </div>
                            <p class="mt-4 text-xs text-amber-600">Assignments awaiting grading</p>
                        </div>

                        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-sm text-slate-500">Unread Messages</p>
                                    <h3 class="mt-2 text-3xl font-bold text-slate-800">18</h3>
                                </div>
                                <div class="rounded-2xl bg-violet-50 p-4 text-violet-600"><i class="fa-solid fa-envelope-open-text text-xl"></i></div>
                            </div>
                            <p class="mt-4 text-xs text-slate-500">Respond to recent student queries</p>
                        </div>
                    </div>

                    <!-- Body content wrapper — more generous padding -->
                    <div class="rounded-3xl border border-dashed border-brand-200 bg-white/70 p-10 shadow-panel">
                        @RenderBody()
                    </div>
                </main>

                <footer class="border-t border-slate-200 bg-white px-6 py-5 text-sm text-slate-500 sm:px-8 lg:px-12">
                    <div class="flex flex-col items-center justify-between gap-2 sm:flex-row">
                        <p>&copy; 2026 EduFlow eLMS Admin Dashboard</p>
                        <a asp-area="" asp-controller="Home" asp-action="Privacy" class="font-medium text-brand-700 hover:text-brand-800">Privacy Policy</a>
                    </div>
                </footer>
            </div>
        </div>
    </div>

    <!-- Mobile sidebar overlay -->
    <div id="sidebarOverlay" class="fixed inset-0 z-30 hidden bg-slate-900/50 lg:hidden"></div>

    <script>
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const openSidebar = document.getElementById('openSidebar');
        const closeSidebar = document.getElementById('closeSidebar');
        const profileMenuButton = document.getElementById('profileMenuButton');
        const profileMenu = document.getElementById('profileMenu');

        function showSidebar() {
            sidebar.classList.remove('-translate-x-full');
            overlay.classList.remove('hidden');
        }

        function hideSidebar() {
            sidebar.classList.add('-translate-x-full');
            overlay.classList.add('hidden');
        }

        openSidebar?.addEventListener('click', showSidebar);
        closeSidebar?.addEventListener('click', hideSidebar);
        overlay?.addEventListener('click', hideSidebar);

        document.querySelectorAll('.submenu-toggle').forEach(button => {
            button.addEventListener('click', () => {
                const menu = document.getElementById(button.dataset.target);
                const icon = button.querySelector('.fa-chevron-down');
                menu.classList.toggle('hidden');
                icon.classList.toggle('rotate-180');
            });
        });

        profileMenuButton?.addEventListener('click', (event) => {
            event.stopPropagation();
            profileMenu.classList.toggle('hidden');
        });

        document.addEventListener('click', (event) => {
            if (!profileMenu.contains(event.target) && !profileMenuButton.contains(event.target)) {
                profileMenu.classList.add('hidden');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
