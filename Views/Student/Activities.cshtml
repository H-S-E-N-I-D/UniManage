@{
    ViewData["Title"] = "Module Activities";
}

<div class="space-y-6">

    <!-- Module Header -->
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
        <a href="javascript:history.back()"
           class="mb-4 inline-flex items-center text-sm font-semibold text-brand-700 hover:text-brand-800">
            ← Back to Modules
        </a>

        <h1 class="mt-2 text-2xl font-bold text-slate-800">
            Software Testing and Quality Assurance
        </h1>

        <p class="mt-2 text-sm text-slate-500">
            Module Code: <span class="font-semibold text-slate-700">SE202</span>
        </p>
    </div>

    <!-- Tabs -->
    <div class="rounded-3xl border border-slate-200 bg-white shadow-panel">

        <div class="flex border-b border-slate-200">
            <button onclick="showTab('materials')" id="tab-materials"
                    class="tab-btn flex-1 border-b-2 border-brand-700 px-4 py-4 text-sm font-bold text-brand-700">
                Course Materials
            </button>

            <button onclick="showTab('announcements')" id="tab-announcements"
                    class="tab-btn flex-1 border-b-2 border-transparent px-4 py-4 text-sm font-bold text-slate-500 hover:text-brand-700">
                Announcements
            </button>

            <button onclick="showTab('assessments')" id="tab-assessments"
                    class="tab-btn flex-1 border-b-2 border-transparent px-4 py-4 text-sm font-bold text-slate-500 hover:text-brand-700">
                Assessments
            </button>
        </div>

        <!-- Course Materials Tab -->
        <div id="materials" class="tab-content p-6">
            <div class="space-y-4">

                <div class="rounded-2xl border border-slate-200 p-5 transition hover:border-brand-300 hover:shadow-md">
                    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                        <div>
                            <h3 class="text-lg font-bold text-slate-800">Introduction to Software Testing</h3>
                            <p class="mt-1 text-sm text-slate-500">
                                Lecture slides covering testing principles, test levels and QA fundamentals.
                            </p>
                            <div class="mt-3 flex flex-wrap gap-3 text-xs font-semibold text-slate-500">
                                <span>File Type: PDF</span>
                                <span>Uploaded Date: 02 Mar 2026</span>
                            </div>
                        </div>

                        <button class="rounded-xl bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-800">
                            Download
                        </button>
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-200 p-5 transition hover:border-brand-300 hover:shadow-md">
                    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                        <div>
                            <h3 class="text-lg font-bold text-slate-800">Test Case Design Techniques</h3>
                            <p class="mt-1 text-sm text-slate-500">
                                Practical guide for equivalence partitioning, boundary value analysis and decision tables.
                            </p>
                            <div class="mt-3 flex flex-wrap gap-3 text-xs font-semibold text-slate-500">
                                <span>File Type: DOCX</span>
                                <span>Uploaded Date: 10 Mar 2026</span>
                            </div>
                        </div>

                        <button class="rounded-xl bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-800">
                            Download
                        </button>
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-200 p-5 transition hover:border-brand-300 hover:shadow-md">
                    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                        <div>
                            <h3 class="text-lg font-bold text-slate-800">Automation Testing Lab Sheet</h3>
                            <p class="mt-1 text-sm text-slate-500">
                                Step-by-step lab worksheet for designing and executing automated test scripts.
                            </p>
                            <div class="mt-3 flex flex-wrap gap-3 text-xs font-semibold text-slate-500">
                                <span>File Type: PDF</span>
                                <span>Uploaded Date: 18 Mar 2026</span>
                            </div>
                        </div>

                        <button class="rounded-xl bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-800">
                            Download
                        </button>
                    </div>
                </div>

            </div>
        </div>

        <!-- Announcements Tab -->
        <div id="announcements" class="tab-content hidden p-6">
            <div class="space-y-4">

                <div class="rounded-2xl border border-slate-200 p-5">
                    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                        <div>
                            <h3 class="text-lg font-bold text-slate-800">Assessment 02 Submission Reminder</h3>
                            <p class="mt-1 text-sm leading-6 text-slate-500">
                                Students are reminded to submit Assessment 02 before the published deadline.
                            </p>
                            <p class="mt-3 text-xs font-semibold text-slate-400">Date: 24 Mar 2026</p>
                        </div>

                        <button class="rounded-xl border border-brand-700 px-5 py-2.5 text-sm font-semibold text-brand-700 hover:bg-brand-50">
                            View
                        </button>
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-200 p-5">
                    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                        <div>
                            <h3 class="text-lg font-bold text-slate-800">Additional Lab Session Scheduled</h3>
                            <p class="mt-1 text-sm leading-6 text-slate-500">
                                An additional practical session has been scheduled to support test automation activities.
                            </p>
                            <p class="mt-3 text-xs font-semibold text-slate-400">Date: 18 Mar 2026</p>
                        </div>

                        <button class="rounded-xl border border-brand-700 px-5 py-2.5 text-sm font-semibold text-brand-700 hover:bg-brand-50">
                            View
                        </button>
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-200 p-5">
                    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                        <div>
                            <h3 class="text-lg font-bold text-slate-800">Coursework Brief Released</h3>
                            <p class="mt-1 text-sm leading-6 text-slate-500">
                                The coursework brief and marking rubric are now available under the assessments section.
                            </p>
                            <p class="mt-3 text-xs font-semibold text-slate-400">Date: 14 Mar 2026</p>
                        </div>

                        <button class="rounded-xl border border-brand-700 px-5 py-2.5 text-sm font-semibold text-brand-700 hover:bg-brand-50">
                            View
                        </button>
                    </div>
                </div>

            </div>
        </div>

        <!-- Assessments Tab -->
        <div id="assessments" class="tab-content hidden p-6">

            <!-- Assessment List -->
            <div id="assessmentList" class="space-y-4">

                <div class="rounded-2xl border border-slate-200 p-5 transition hover:border-brand-300 hover:shadow-md">
                    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                        <div>
                            <h3 class="text-lg font-bold text-slate-800">SEP 2025 - AD CW 01</h3>
                            <div class="mt-3 grid grid-cols-1 gap-3 text-sm text-slate-600 md:grid-cols-3">
                                <p><span class="font-semibold text-slate-700">Released:</span> 14/03/2026 13:24</p>
                                <p><span class="font-semibold text-slate-700">Submission:</span> 29/03/2026 23:59</p>
                                <p>
                                    <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-700">
                                        Open
                                    </span>
                                </p>
                            </div>
                        </div>

                        <button onclick="showAssessmentDetail('SEP 2025 - AD CW 01')"
                                class="rounded-xl bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-800">
                            View
                        </button>
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-200 p-5 transition hover:border-brand-300 hover:shadow-md">
                    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                        <div>
                            <h3 class="text-lg font-bold text-slate-800">SEP 2025 - AD CW 02</h3>
                            <div class="mt-3 grid grid-cols-1 gap-3 text-sm text-slate-600 md:grid-cols-3">
                                <p><span class="font-semibold text-slate-700">Released:</span> 02/04/2026 09:00</p>
                                <p><span class="font-semibold text-slate-700">Submission:</span> 11/05/2026 23:59</p>
                                <p>
                                    <span class="rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-700">
                                        Submitted
                                    </span>
                                </p>
                            </div>
                        </div>

                        <button onclick="showAssessmentDetail('SEP 2025 - AD CW 02')"
                                class="rounded-xl bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-800">
                            View
                        </button>
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-200 p-5 transition hover:border-brand-300 hover:shadow-md">
                    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                        <div>
                            <h3 class="text-lg font-bold text-slate-800">SEP 2025 - AD Practical Test</h3>
                            <div class="mt-3 grid grid-cols-1 gap-3 text-sm text-slate-600 md:grid-cols-3">
                                <p><span class="font-semibold text-slate-700">Released:</span> 20/04/2026 10:00</p>
                                <p><span class="font-semibold text-slate-700">Submission:</span> 01/05/2026 17:00</p>
                                <p>
                                    <span class="rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700">
                                        Late Submitted
                                    </span>
                                </p>
                            </div>
                        </div>

                        <button onclick="showAssessmentDetail('SEP 2025 - AD Practical Test')"
                                class="rounded-xl bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-800">
                            View
                        </button>
                    </div>
                </div>

            </div>

            <!-- Assessment Detail -->
            <div id="assessmentDetail" class="hidden">
                <button onclick="backToAssessmentList()"
                        class="mb-5 inline-flex items-center text-sm font-semibold text-brand-700 hover:text-brand-800">
                    ← Back to Assessments
                </button>

                <h2 id="assessmentTitle" class="mb-6 text-xl font-extrabold text-slate-800">
                    SEP 2025 - AD CW 02
                </h2>

                <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">

                    <div class="rounded-2xl border border-slate-200 bg-white p-5 lg:col-span-2">
                        <p class="text-xs font-bold uppercase text-slate-600">
                            Submission Deadline - 29th March 2026
                        </p>

                        <div class="mt-10">
                            <h3 class="text-lg font-bold text-slate-800">Resources</h3>

                            <div class="mt-5 flex items-center gap-4">
                                <i class="fa-regular fa-file-lines text-xl text-brand-700"></i>
                                <span class="text-base font-medium text-slate-700">Coursework</span>
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="rounded-2xl border border-slate-200 bg-white p-5">
                            <div class="space-y-4 text-sm">
                                <div class="grid grid-cols-2 gap-4">
                                    <span class="text-slate-700">Submission Status</span>
                                    <span class="rounded bg-amber-100 px-3 py-1 text-center font-semibold text-amber-700">Open</span>
                                </div>

                                <div class="grid grid-cols-2 gap-4">
                                    <span class="text-slate-700">Issued Date</span>
                                    <span class="text-right font-medium text-slate-800">14/03/2026 13:24</span>
                                </div>

                                <div class="grid grid-cols-2 gap-4">
                                    <span class="text-slate-700">Mark Release Date</span>
                                    <span class="text-right font-medium text-slate-800">19/05/2026 23:59</span>
                                </div>

                                <div class="grid grid-cols-2 gap-4">
                                    <span class="text-slate-700">Deadline</span>
                                    <span class="text-right font-medium text-slate-800">11/05/2026 23:59</span>
                                </div>
                            </div>

                            <button class="mt-4 w-full rounded-xl bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-800">
                                Submit
                            </button>
                        </div>

                        <p class="mt-4 text-center text-xs text-slate-500">
                            *Grade is subjected to change
                        </p>
                    </div>

                </div>

                <!-- Grading Section -->
                <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">

                    <!-- Section Header -->
                    <div class="mb-5 flex items-center gap-3">
                        <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-brand-100 text-brand-700">
                            <i class="fa-solid fa-award text-lg"></i>
                        </div>

                        <div>
                            <h3 class="text-lg font-bold text-slate-800">Grading</h3>
                            <p class="text-sm text-slate-500">
                                Final assessment evaluation and lecturer feedback.
                            </p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">

                        <!-- Final Marks -->
                        <div class="rounded-2xl bg-slate-50 p-5 text-center">
                            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                                Final Marks
                            </p>

                            <p class="mt-3 text-3xl font-extrabold text-slate-800">
                                75%
                            </p>
                        </div>

                        <!-- Final Grade -->
                        <div class="rounded-2xl bg-slate-50 p-5 text-center">
                            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                                Final Grade
                            </p>

                            <div class="mt-3 flex justify-center">
                                <span class="inline-flex rounded-full bg-green-100 px-5 py-2 text-lg font-extrabold text-green-700">
                                    A
                                </span>
                            </div>
                        </div>

                        <!-- Graded Date -->
                        <div class="rounded-2xl bg-slate-50 p-5 text-center">
                            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                                Graded Date
                            </p>

                            <p class="mt-3 text-lg font-bold text-slate-700">
                                19/05/2026
                            </p>
                        </div>

                    </div>

                    <!-- Feedback -->
                    <div class="mt-5">
                        <p class="text-xs font-semibold uppercase text-slate-400">
                            Feedback
                        </p>

                        <p class="mt-2 rounded-xl bg-slate-50 p-4 text-sm leading-6 text-slate-600">
                            Excellent understanding of software testing concepts, test case design techniques and practical application.
                            Minor improvements are recommended in documenting test execution evidence.
                        </p>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.add('hidden');
            });

            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('border-brand-700', 'text-brand-700');
                btn.classList.add('border-transparent', 'text-slate-500');
            });

            document.getElementById(tabId).classList.remove('hidden');

            const activeButton = document.getElementById('tab-' + tabId);
            activeButton.classList.remove('border-transparent', 'text-slate-500');
            activeButton.classList.add('border-brand-700', 'text-brand-700');
        }

        function showAssessmentDetail(title) {
            document.getElementById('assessmentList').classList.add('hidden');
            document.getElementById('assessmentDetail').classList.remove('hidden');
            document.getElementById('assessmentTitle').innerText = title;
        }

        function backToAssessmentList() {
            document.getElementById('assessmentDetail').classList.add('hidden');
            document.getElementById('assessmentList').classList.remove('hidden');
        }
    </script>
}