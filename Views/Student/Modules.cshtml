@{
    ViewData["Title"] = "Student Modules";
}

<div class="space-y-8">

    <!-- Course Header -->
    <section class="relative overflow-hidden rounded-none bg-slate-900 px-8 py-8 text-white shadow-panel">
        <div class="absolute inset-0 bg-[url('/images/course-software-engineering.jpg')] bg-cover bg-center opacity-30"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-brand-900/90 to-brand-700/90"></div>

        <div class="relative z-10 max-w-5xl">
            <a href="javascript:history.back()"
               class="mb-5 inline-flex items-center text-sm font-semibold text-white hover:text-brand-100">
                ← Back to Courses
            </a>

            <div class="mb-4 flex flex-wrap gap-3">
                <span class="rounded-full bg-white/20 px-5 py-2 text-sm font-bold backdrop-blur">
                    Department of Computing
                </span>
                <span class="rounded-full bg-brand-500 px-5 py-2 text-sm font-bold">
                    Undergraduate Level
                </span>
            </div>

            <h1 class="text-3xl font-extrabold tracking-tight">
                BSc (Hons) in Software Engineering
            </h1>

            <p class="mt-3 max-w-3xl text-sm leading-7 text-white">
                Build strong software engineering capability through programming, database systems,
                web application development, cloud concepts, software architecture, and final-year project experience.
            </p>
        </div>
    </section>

    <!-- Overall Progress -->
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
        <div class="mb-3 flex items-center justify-between">
            <div>
                <h2 class="text-lg font-bold text-slate-800">Overall Course Progress</h2>
                <p class="text-sm text-slate-500">Current completion status across enrolled modules.</p>
            </div>
            <span class="text-xl font-extrabold text-brand-700">58%</span>
        </div>

        <div class="h-4 overflow-hidden rounded-full bg-slate-200">
            <div class="h-full rounded-full bg-brand-600" style="width: 58%;"></div>
        </div>
    </section>

    <!-- Semester 1 -->
    <section class="space-y-4">
        <div>
            <h2 class="text-2xl font-bold text-slate-800">Semester 1</h2>
        </div>

        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4">

            <button type="button" onclick="selectModule('SE101')"
                    class="group rounded-3xl border border-slate-200 bg-white p-5 text-left shadow-panel transition hover:-translate-y-1 hover:border-brand-300 hover:shadow-xl">
                <div class="mb-4 flex items-center justify-between">
                    <span class="h-3.5 w-3.5 rounded-full bg-green-500"></span>
                    <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700">Completed</span>
                </div>
                <h3 class="text-lg font-bold text-slate-800 group-hover:text-brand-700">
                    Programming Fundamentals
                </h3>
                <p class="mt-2 text-sm text-slate-500">Module Code: <span class="font-semibold text-slate-700">SE101</span></p>
                <p class="mt-1 text-sm text-slate-500">Duration: <span class="font-semibold text-slate-700">12 weeks</span></p>
            </button>

            <button type="button" onclick="selectModule('SE102')"
                    class="group rounded-3xl border border-slate-200 bg-white p-5 text-left shadow-panel transition hover:-translate-y-1 hover:border-brand-300 hover:shadow-xl">
                <div class="mb-4 flex items-center justify-between">
                    <span class="h-3.5 w-3.5 rounded-full bg-green-500"></span>
                    <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-700">Completed</span>
                </div>
                <h3 class="text-lg font-bold text-slate-800 group-hover:text-brand-700">
                    Database Management Systems
                </h3>
                <p class="mt-2 text-sm text-slate-500">Module Code: <span class="font-semibold text-slate-700">SE102</span></p>
                <p class="mt-1 text-sm text-slate-500">Duration: <span class="font-semibold text-slate-700">12 weeks</span></p>
            </button>

            <button type="button" onclick="selectModule('SE103')"
                    class="group rounded-3xl border border-slate-200 bg-white p-5 text-left shadow-panel transition hover:-translate-y-1 hover:border-brand-300 hover:shadow-xl">
                <div class="mb-4 flex items-center justify-between">
                    <span class="h-3.5 w-3.5 rounded-full bg-yellow-400"></span>
                    <span class="rounded-full bg-yellow-100 px-3 py-1 text-xs font-semibold text-yellow-700">In Progress</span>
                </div>
                <h3 class="text-lg font-bold text-slate-800 group-hover:text-brand-700">
                    Web Application Development
                </h3>
                <p class="mt-2 text-sm text-slate-500">Module Code: <span class="font-semibold text-slate-700">SE103</span></p>
                <p class="mt-1 text-sm text-slate-500">Duration: <span class="font-semibold text-slate-700">10 weeks</span></p>
            </button>

            <button type="button" onclick="selectModule('SE104')"
                    class="group rounded-3xl border border-slate-200 bg-white p-5 text-left shadow-panel transition hover:-translate-y-1 hover:border-brand-300 hover:shadow-xl">
                <div class="mb-4 flex items-center justify-between">
                    <span class="h-3.5 w-3.5 rounded-full bg-yellow-400"></span>
                    <span class="rounded-full bg-yellow-100 px-3 py-1 text-xs font-semibold text-yellow-700">In Progress</span>
                </div>
                <h3 class="text-lg font-bold text-slate-800 group-hover:text-brand-700">
                    Computer Systems Architecture
                </h3>
                <p class="mt-2 text-sm text-slate-500">Module Code: <span class="font-semibold text-slate-700">SE104</span></p>
                <p class="mt-1 text-sm text-slate-500">Duration: <span class="font-semibold text-slate-700">10 weeks</span></p>
            </button>

        </div>
    </section>

    <!-- Semester 2 -->
    <section class="space-y-4">
        <div>
            <h2 class="text-2xl font-bold text-slate-800">Semester 2</h2>
        </div>

        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">

            <button type="button" onclick="selectModule('SE201')"
                    class="group rounded-3xl border border-slate-200 bg-white p-5 text-left shadow-panel transition hover:-translate-y-1 hover:border-brand-300 hover:shadow-xl">
                <div class="mb-4 flex items-center justify-between">
                    <span class="h-3.5 w-3.5 rounded-full bg-yellow-400"></span>
                    <span class="rounded-full bg-yellow-100 px-3 py-1 text-xs font-semibold text-yellow-700">In Progress</span>
                </div>
                <h3 class="text-lg font-bold text-slate-800 group-hover:text-brand-700">
                    Object-Oriented Software Design
                </h3>
                <p class="mt-2 text-sm text-slate-500">Module Code: <span class="font-semibold text-slate-700">SE201</span></p>
                <p class="mt-1 text-sm text-slate-500">Duration: <span class="font-semibold text-slate-700">12 weeks</span></p>
            </button>

            <button type="button" onclick="selectModule('SE202')"
                    class="group rounded-3xl border border-slate-200 bg-white p-5 text-left shadow-panel transition hover:-translate-y-1 hover:border-brand-300 hover:shadow-xl">
                <div class="mb-4 flex items-center justify-between">
                    <span class="h-3.5 w-3.5 rounded-full bg-yellow-400"></span>
                    <span class="rounded-full bg-yellow-100 px-3 py-1 text-xs font-semibold text-yellow-700">In Progress</span>
                </div>
                <h3 class="text-lg font-bold text-slate-800 group-hover:text-brand-700">
                    Software Testing and Quality Assurance
                </h3>
                <p class="mt-2 text-sm text-slate-500">Module Code: <span class="font-semibold text-slate-700">SE202</span></p>
                <p class="mt-1 text-sm text-slate-500">Duration: <span class="font-semibold text-slate-700">10 weeks</span></p>
            </button>

            <button type="button" onclick="selectModule('SE203')"
                    class="group rounded-3xl border border-slate-200 bg-white p-5 text-left shadow-panel transition hover:-translate-y-1 hover:border-brand-300 hover:shadow-xl">
                <div class="mb-4 flex items-center justify-between">
                    <span class="h-3.5 w-3.5 rounded-full bg-yellow-400"></span>
                    <span class="rounded-full bg-yellow-100 px-3 py-1 text-xs font-semibold text-yellow-700">In Progress</span>
                </div>
                <h3 class="text-lg font-bold text-slate-800 group-hover:text-brand-700">
                    Cloud Application Development
                </h3>
                <p class="mt-2 text-sm text-slate-500">Module Code: <span class="font-semibold text-slate-700">SE203</span></p>
                <p class="mt-1 text-sm text-slate-500">Duration: <span class="font-semibold text-slate-700">12 weeks</span></p>
            </button>

        </div>
    </section>

</div>

@section Scripts {
    <script>
        function selectModule(moduleCode) {
            console.log("Selected module:", moduleCode);

            // Later implementation:
            // window.location.href = "/Student/ModuleDetails?moduleCode=" + moduleCode;
        }
    </script>
}