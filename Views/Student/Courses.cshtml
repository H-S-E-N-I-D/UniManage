@{
    ViewData["Title"] = "My Enrolled Courses";
}

<div class="space-y-8">

    <!-- Page Header -->
    <div>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-700">
            Student Dashboard
        </p>
        <h1 class="mt-2 text-3xl font-bold text-slate-800">
            My Enrolled Courses
        </h1>
        <p class="mt-1 text-slate-500">
            View your enrolled courses, learning progress and current course status.
        </p>
    </div>

    <!-- Course Cards -->
    <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">

        <!-- Course Card 1 -->
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel transition hover:-translate-y-1 hover:shadow-xl">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-100 text-brand-700">
                        <i class="fa-solid fa-book-open text-xl"></i>
                    </div>

                    <h2 class="text-xl font-bold text-slate-800">
                        BSc Software Engineering
                    </h2>
                    <p class="mt-1 text-sm text-slate-500">
                        Course Code: <span class="font-semibold text-slate-700">CSE401</span>
                    </p>
                </div>

                <span class="rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-700">
                    In Progress
                </span>
            </div>

            <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <p class="text-xs font-semibold uppercase text-slate-400">Department</p>
                    <p class="mt-1 font-medium text-slate-700">Department of Computing</p>
                </div>

                <div>
                    <p class="text-xs font-semibold uppercase text-slate-400">Program Mode</p>
                    <p class="mt-1 font-medium text-slate-700">Full Time</p>
                </div>

                <div>
                    <p class="text-xs font-semibold uppercase text-slate-400">Start Date</p>
                    <p class="mt-1 font-medium text-slate-700">15 Jan 2026</p>
                </div>
            </div>

            <div class="mt-6">
                <div class="mb-2 flex items-center justify-between">
                    <p class="text-sm font-semibold text-slate-700">Current Progress</p>
                    <p class="text-sm font-bold text-brand-700">65%</p>
                </div>

                <div class="h-3 overflow-hidden rounded-full bg-slate-200">
                    <div class="h-full rounded-full bg-brand-600" style="width: 65%;"></div>
                </div>
            </div>

            <div class="mt-6 flex justify-end">
                <button onclick="viewCourseDetails('CSE401')"
                        class="inline-flex items-center gap-2 rounded-xl bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-800">
                    <i class="fa-regular fa-eye"></i>
                    View Details
                </button>
            </div>
        </div>

        <!-- Course Card 2 -->
        <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel transition hover:-translate-y-1 hover:shadow-xl">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-700">
                        <i class="fa-solid fa-graduation-cap text-xl"></i>
                    </div>

                    <h2 class="text-xl font-bold text-slate-800">
                        Diploma in Web Development
                    </h2>
                    <p class="mt-1 text-sm text-slate-500">
                        Course Code: <span class="font-semibold text-slate-700">DWD205</span>
                    </p>
                </div>

                <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-700">
                    Completed
                </span>
            </div>

            <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div>
                    <p class="text-xs font-semibold uppercase text-slate-400">Department</p>
                    <p class="mt-1 font-medium text-slate-700">Department of Computing</p>
                </div>

                <div>
                    <p class="text-xs font-semibold uppercase text-slate-400">Program Mode</p>
                    <p class="mt-1 font-medium text-slate-700">Weekend</p>
                </div>

                <div>
                    <p class="text-xs font-semibold uppercase text-slate-400">Start Date</p>
                    <p class="mt-1 font-medium text-slate-700">05 Sep 2025</p>
                </div>
            </div>

            <div class="mt-6">
                <div class="mb-2 flex items-center justify-between">
                    <p class="text-sm font-semibold text-slate-700">Current Progress</p>
                    <p class="text-sm font-bold text-emerald-700">100%</p>
                </div>

                <div class="h-3 overflow-hidden rounded-full bg-slate-200">
                    <div class="h-full rounded-full bg-emerald-600" style="width: 100%;"></div>
                </div>
            </div>

            <div class="mt-6 flex justify-end">
                <button onclick="viewCourseDetails('DWD205')"
                        class="inline-flex items-center gap-2 rounded-xl bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-800">
                    <i class="fa-regular fa-eye"></i>
                    View Details
                </button>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function viewCourseDetails(courseCode) {
            alert("View details clicked for course: " + courseCode);

            // Example MVC navigation:
            // window.location.href = "/Student/CourseDetails?courseCode=" + courseCode;
        }
    </script>
}