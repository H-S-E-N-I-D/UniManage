@{
    ViewData["Title"] = "Course Performance Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="space-y-6">

    <!-- Page Header -->
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.25em] text-brand-700">
                Reports and Analytics
            </p>
            <h1 class="mt-2 text-2xl font-bold text-slate-800">
                Course Performance Report
            </h1>
            <p class="mt-1 text-sm text-slate-500">
                Analyze course-wise student count, GPA performance, and course completion statistics.
            </p>
        </div>

        <div class="flex flex-wrap gap-3">
            <button class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700">
                <i class="fa-solid fa-file-excel"></i>
                Export to Excel
            </button>
            <button class="inline-flex items-center gap-2 rounded-xl bg-rose-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-rose-700">
                <i class="fa-solid fa-file-pdf"></i>
                Export to PDF
            </button>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-2xl border border-blue-300 bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">Total Courses</p>
            <h3 class="mt-2 text-2xl font-bold text-slate-800">20</h3>
        </div>
        <div class="rounded-2xl border border-blue-300 bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">Average Course GPA</p>
            <h3 class="mt-2 text-2xl font-bold text-brand-700">3.31</h3>
        </div>
        <div class="rounded-2xl border border-blue-300 bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">Total Students</p>
            <h3 class="mt-2 text-2xl font-bold text-indigo-600">1,084</h3>
        </div>
        <div class="rounded-2xl border border-blue-300 bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">Completed Students</p>
            <h3 class="mt-2 text-2xl font-bold text-emerald-600">782</h3>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
        <h2 class="mb-4 text-lg font-bold text-slate-800">Generate Report</h2>

        <div class="grid gap-4 lg:grid-cols-2">

            <!-- Searchable Department Dropdown -->
            <div class="relative">
                <label class="mb-1 block text-sm font-semibold text-slate-600">Department</label>

                <button id="departmentDropdownButton"
                        type="button"
                        class="flex w-full items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-left text-sm text-slate-600 outline-none transition hover:border-brand-400 focus:border-brand-500 focus:ring-2 focus:ring-brand-100">
                    <span id="selectedDepartmentText">Select department</span>
                    <i class="fa-solid fa-chevron-down text-xs text-slate-400"></i>
                </button>

                <input type="hidden" id="selectedDepartmentValue" name="Department" />

                <div id="departmentDropdownPanel" class="absolute z-40 mt-2 hidden w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
                    <div class="border-b border-slate-100 p-3">
                        <div class="relative">
                            <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-sm text-slate-400"></i>
                            <input id="departmentSearchInput"
                                   type="text"
                                   placeholder="Search department name or code"
                                   class="w-full rounded-xl border border-slate-200 py-2.5 pl-10 pr-4 text-sm focus:outline-none focus:ring-2 focus:ring-brand-600" />
                        </div>
                    </div>
                    <div id="departmentOptions" class="max-h-72 overflow-y-auto p-2"></div>
                </div>
            </div>

            <div class="flex items-end">
                <button class="w-full rounded-xl bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-800">
                    <i class="fa-solid fa-chart-line mr-2"></i>
                    Generate Report
                </button>
            </div>
        </div>
    </div>

    <!-- Report Table -->
    <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
        <div class="mb-4 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <h2 class="text-lg font-bold text-slate-800">Course Performance Details</h2>

            <select id="sortOption"
                    class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 sm:w-72">
                <option value="courseName">Sort by Course Name</option>
                <option value="gpaDesc">Highest GPA</option>
                <option value="gpaAsc">Lowest GPA</option>
                <option value="studentsDesc">Highest Number of Students</option>
                <option value="studentsAsc">Lowest Number of Students</option>
                <option value="completedDesc">Highest Completed Students</option>
                <option value="completedAsc">Lowest Completed Students</option>
            </select>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-slate-100">
            <table class="min-w-full divide-y divide-slate-100 text-sm">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left font-semibold text-slate-600">Course Name</th>
                        <th class="px-4 py-3 text-center font-semibold text-slate-600">Batch No</th>
                        <th class="px-4 py-3 text-center font-semibold text-slate-600">Number of Students</th>
                        <th class="px-4 py-3 text-center font-semibold text-slate-600">Average GPA</th>
                        <th class="px-4 py-3 text-center font-semibold text-slate-600">Number of Completed Students</th>
                    </tr>
                </thead>
                <tbody id="courseTableBody" class="divide-y divide-slate-100 bg-white"></tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <p id="paginationInfo" class="text-sm text-slate-500"></p>

            <div class="flex items-center gap-2">
                <button id="previousPage"
                        class="rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-500 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50">
                    Previous
                </button>

                <div id="paginationButtons" class="flex items-center gap-2"></div>

                <button id="nextPage"
                        class="rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-500 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50">
                    Next
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    const departments = [
        { code: "DSE", name: "Department of Software Engineering" },
        { code: "DCS", name: "Department of Computer Science" },
        { code: "DIT", name: "Department of Information Technology" },
        { code: "DCY", name: "Department of Cyber Security" },
        { code: "DDS", name: "Department of Data Science" },
        { code: "DAI", name: "Department of Artificial Intelligence" },
        { code: "DBM", name: "Department of Business Management" }
    ];

    const courses = [
        { courseName: "BSc Software Engineering", batchNo: "Batch 0001", students: 64, averageGpa: 3.56, completed: 48 },
        { courseName: "BSc Computer Science", batchNo: "Batch 0001", students: 72, averageGpa: 3.42, completed: 55 },
        { courseName: "BSc Information Technology", batchNo: "Batch 0002", students: 58, averageGpa: 3.21, completed: 39 },
        { courseName: "BSc Cyber Security", batchNo: "Batch 0002", students: 46, averageGpa: 3.37, completed: 32 },
        { courseName: "BSc Data Science", batchNo: "Batch 0003", students: 52, averageGpa: 3.61, completed: 41 },
        { courseName: "BSc Artificial Intelligence", batchNo: "Batch 0003", students: 49, averageGpa: 3.68, completed: 37 },
        { courseName: "BSc Network Engineering", batchNo: "Batch 0004", students: 43, averageGpa: 3.12, completed: 28 },
        { courseName: "BSc Cloud Computing", batchNo: "Batch 0004", students: 51, averageGpa: 3.44, completed: 36 },
        { courseName: "BSc Business Information Systems", batchNo: "Batch 0005", students: 69, averageGpa: 3.18, completed: 47 },
        { courseName: "BSc Digital Business", batchNo: "Batch 0005", students: 55, averageGpa: 3.09, completed: 35 },
        { courseName: "Diploma in Software Development", batchNo: "Batch 0006", students: 61, averageGpa: 3.25, completed: 43 },
        { courseName: "Diploma in Web Engineering", batchNo: "Batch 0006", students: 44, averageGpa: 3.31, completed: 30 },
        { courseName: "Diploma in Graphic Design", batchNo: "Batch 0007", students: 39, averageGpa: 3.14, completed: 25 },
        { courseName: "Diploma in Multimedia Design", batchNo: "Batch 0007", students: 42, averageGpa: 3.28, completed: 29 },
        { courseName: "Higher Diploma in Computing", batchNo: "Batch 0008", students: 73, averageGpa: 3.35, completed: 54 },
        { courseName: "Higher Diploma in Software Engineering", batchNo: "Batch 0008", students: 66, averageGpa: 3.49, completed: 50 },
        { courseName: "MBA in Project Management", batchNo: "Batch 0009", students: 36, averageGpa: 3.58, completed: 31 },
        { courseName: "MSc Information Systems", batchNo: "Batch 0009", students: 33, averageGpa: 3.73, completed: 27 },
        { courseName: "MSc Cyber Security", batchNo: "Batch 0010", students: 29, averageGpa: 3.66, completed: 23 },
        { courseName: "MSc Data Analytics", batchNo: "Batch 0010", students: 42, averageGpa: 3.70, completed: 32 }
    ];

    let currentPage = 1;
    const rowsPerPage = 10;
    let sortedCourses = [...courses];

    const departmentDropdownButton = document.getElementById("departmentDropdownButton");
    const departmentDropdownPanel = document.getElementById("departmentDropdownPanel");
    const departmentSearchInput = document.getElementById("departmentSearchInput");
    const departmentOptions = document.getElementById("departmentOptions");
    const selectedDepartmentText = document.getElementById("selectedDepartmentText");
    const selectedDepartmentValue = document.getElementById("selectedDepartmentValue");

    function renderDepartments(searchText = "") {
        departmentOptions.innerHTML = "";

        const filteredDepartments = departments.filter(department =>
            department.name.toLowerCase().includes(searchText.toLowerCase()) ||
            department.code.toLowerCase().includes(searchText.toLowerCase())
        );

        if (filteredDepartments.length === 0) {
            departmentOptions.innerHTML = `
                <div class="px-4 py-3 text-sm text-slate-400">
                    No departments found
                </div>
            `;
            return;
        }

        filteredDepartments.forEach(department => {
            const option = document.createElement("button");
            option.type = "button";
            option.className = "flex w-full flex-col rounded-xl px-4 py-3 text-left hover:bg-brand-50";
            option.innerHTML = `
                <span class="font-semibold text-slate-700">${department.name}</span>
                <span class="text-xs text-slate-400">${department.code}</span>
            `;

            option.addEventListener("click", () => {
                selectedDepartmentText.textContent = `${department.name} (${department.code})`;
                selectedDepartmentValue.value = department.code;
                departmentDropdownPanel.classList.add("hidden");
            });

            departmentOptions.appendChild(option);
        });
    }

    departmentDropdownButton.addEventListener("click", () => {
        departmentDropdownPanel.classList.toggle("hidden");
        departmentSearchInput.focus();
        renderDepartments();
    });

    departmentSearchInput.addEventListener("input", function () {
        renderDepartments(this.value);
    });

    document.addEventListener("click", function (event) {
        if (!departmentDropdownButton.contains(event.target) && !departmentDropdownPanel.contains(event.target)) {
            departmentDropdownPanel.classList.add("hidden");
        }
    });

    function renderTable() {
        const tableBody = document.getElementById("courseTableBody");
        tableBody.innerHTML = "";

        const start = (currentPage - 1) * rowsPerPage;
        const end = start + rowsPerPage;
        const paginatedCourses = sortedCourses.slice(start, end);

        paginatedCourses.forEach(course => {
            tableBody.innerHTML += `
                <tr class="transition hover:bg-brand-50/40">
                    <td class="px-4 py-3 font-medium text-slate-800">${course.courseName}</td>
                    <td class="px-4 py-3 text-center text-slate-600">${course.batchNo}</td>
                    <td class="px-4 py-3 text-center text-slate-600">${course.students}</td>
                    <td class="px-4 py-3 text-center">
                        <span class="rounded-full bg-brand-50 px-3 py-1 font-semibold text-brand-700">
                            ${course.averageGpa.toFixed(2)}
                        </span>
                    </td>
                    <td class="px-4 py-3 text-center">
                        <span class="rounded-full bg-emerald-50 px-3 py-1 font-semibold text-emerald-700">
                            ${course.completed}
                        </span>
                    </td>
                </tr>
            `;
        });

        renderPagination();
    }

    function renderPagination() {
        const totalPages = Math.ceil(sortedCourses.length / rowsPerPage);
        const paginationButtons = document.getElementById("paginationButtons");
        const paginationInfo = document.getElementById("paginationInfo");

        paginationButtons.innerHTML = "";

        const startRecord = (currentPage - 1) * rowsPerPage + 1;
        const endRecord = Math.min(currentPage * rowsPerPage, sortedCourses.length);

        paginationInfo.textContent = `Showing ${startRecord} to ${endRecord} of ${sortedCourses.length} records`;

        for (let i = 1; i <= totalPages; i++) {
            const button = document.createElement("button");
            button.textContent = i;
            button.className = i === currentPage
                ? "rounded-lg bg-brand-700 px-3 py-2 text-sm font-semibold text-white"
                : "rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-600 hover:bg-slate-50";

            button.addEventListener("click", () => {
                currentPage = i;
                renderTable();
            });

            paginationButtons.appendChild(button);
        }

        document.getElementById("previousPage").disabled = currentPage === 1;
        document.getElementById("nextPage").disabled = currentPage === totalPages;
    }

    document.getElementById("previousPage").addEventListener("click", () => {
        if (currentPage > 1) {
            currentPage--;
            renderTable();
        }
    });

    document.getElementById("nextPage").addEventListener("click", () => {
        const totalPages = Math.ceil(sortedCourses.length / rowsPerPage);
        if (currentPage < totalPages) {
            currentPage++;
            renderTable();
        }
    });

    document.getElementById("sortOption").addEventListener("change", function () {
        const value = this.value;

        sortedCourses.sort((a, b) => {
            if (value === "courseName") return a.courseName.localeCompare(b.courseName);
            if (value === "gpaDesc") return b.averageGpa - a.averageGpa;
            if (value === "gpaAsc") return a.averageGpa - b.averageGpa;
            if (value === "studentsDesc") return b.students - a.students;
            if (value === "studentsAsc") return a.students - b.students;
            if (value === "completedDesc") return b.completed - a.completed;
            if (value === "completedAsc") return a.completed - b.completed;
            return 0;
        });

        currentPage = 1;
        renderTable();
    });

    renderDepartments();
    renderTable();
</script>