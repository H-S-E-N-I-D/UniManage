
@{
    ViewData["Title"] = "System Performance Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="space-y-6">

    <!-- Page Header -->
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.25em] text-brand-700">
                System Analytics
            </p>

            <h1 class="mt-2 text-2xl font-bold text-slate-800">
                System Performance Report
            </h1>

            <p class="mt-1 text-sm text-slate-500">
                Monitor overall LMS performance, active users, server utilization, academic activity, and system health metrics.
            </p>
        </div>

        <div class="flex flex-wrap gap-3">
            <button class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50">
                <i class="fa-solid fa-file-excel text-emerald-600"></i>
                Export To Excel
            </button>

            <button class="inline-flex items-center gap-2 rounded-xl bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-800">
                <i class="fa-solid fa-file-pdf"></i>
                Export To PDF
            </button>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
        <div class="grid gap-4 lg:grid-cols-4">

            <!-- Report Type -->
            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">
                    Report Type
                </label>

                <select class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100">
                    <option>Overall System Performance</option>
                    <option>User Activity Analysis</option>
                    <option>Server Performance</option>
                    <option>Database Performance</option>
                    <option>Academic Activity</option>
                </select>
            </div>

            <!-- Date Range -->
            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">
                    Start Date
                </label>

                <input type="date"
                       class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" />
            </div>

            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">
                    End Date
                </label>

                <input type="date"
                       class="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100" />
            </div>

            <!-- Generate -->
            <div class="flex items-end">
                <button class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-700 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-800">
                    <i class="fa-solid fa-chart-line"></i>
                    Generate Report
                </button>
            </div>

        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

        <div class="rounded-2xl border border-blue-300 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500">Active Users</p>
                    <h3 class="mt-2 text-2xl font-bold text-slate-800">2,486</h3>
                </div>

                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
                    <i class="fa-solid fa-users"></i>
                </div>
            </div>

            <p class="mt-3 text-xs font-semibold text-emerald-600">
                +14% compared to last month
            </p>
        </div>

        <div class="rounded-2xl border border-blue-300 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500">Average Response Time</p>
                    <h3 class="mt-2 text-2xl font-bold text-slate-800">1.2s</h3>
                </div>

                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
                    <i class="fa-solid fa-gauge-high"></i>
                </div>
            </div>

            <p class="mt-3 text-xs font-semibold text-emerald-600">
                Excellent system response
            </p>
        </div>

        <div class="rounded-2xl border border-blue-300 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500">Server Uptime</p>
                    <h3 class="mt-2 text-2xl font-bold text-slate-800">99.8%</h3>
                </div>

                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-700">
                    <i class="fa-solid fa-server"></i>
                </div>
            </div>

            <p class="mt-3 text-xs font-semibold text-emerald-600">
                Stable server performance
            </p>
        </div>

        <div class="rounded-2xl border border-blue-300 bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-slate-500">Database Load</p>
                    <h3 class="mt-2 text-2xl font-bold text-slate-800">68%</h3>
                </div>

                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-amber-50 text-amber-700">
                    <i class="fa-solid fa-database"></i>
                </div>
            </div>

            <p class="mt-3 text-xs font-semibold text-amber-600">
                Moderate utilization
            </p>
        </div>

    </div>

    <!-- Charts Section -->
    <div class="grid gap-6 xl:grid-cols-2">

        <!-- User Activity -->
        <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
            <div class="mb-5 flex items-center justify-between">
                <div>
                    <h2 class="text-lg font-bold text-slate-800">
                        Daily User Activity
                    </h2>

                    <p class="text-sm text-slate-500">
                        User login and platform activity trends.
                    </p>
                </div>
            </div>

            <div class="h-[320px]">
                <canvas id="userActivityChart"></canvas>
            </div>
        </div>

        <!-- Server Performance -->
        <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
            <div class="mb-5 flex items-center justify-between">
                <div>
                    <h2 class="text-lg font-bold text-slate-800">
                        Server Resource Usage
                    </h2>

                    <p class="text-sm text-slate-500">
                        CPU, memory, and storage utilization analysis.
                    </p>
                </div>
            </div>

            <div class="space-y-5">

                <div>
                    <div class="mb-2 flex justify-between text-sm">
                        <span class="font-semibold text-slate-700">CPU Usage</span>
                        <span class="font-semibold text-brand-700">72%</span>
                    </div>

                    <div class="h-3 rounded-full bg-slate-100">
                        <div class="h-3 rounded-full bg-brand-600" style="width:72%"></div>
                    </div>
                </div>

                <div>
                    <div class="mb-2 flex justify-between text-sm">
                        <span class="font-semibold text-slate-700">Memory Usage</span>
                        <span class="font-semibold text-emerald-700">64%</span>
                    </div>

                    <div class="h-3 rounded-full bg-slate-100">
                        <div class="h-3 rounded-full bg-emerald-500" style="width:64%"></div>
                    </div>
                </div>

                <div>
                    <div class="mb-2 flex justify-between text-sm">
                        <span class="font-semibold text-slate-700">Storage Usage</span>
                        <span class="font-semibold text-indigo-700">81%</span>
                    </div>

                    <div class="h-3 rounded-full bg-slate-100">
                        <div class="h-3 rounded-full bg-indigo-500" style="width:81%"></div>
                    </div>
                </div>

                <div>
                    <div class="mb-2 flex justify-between text-sm">
                        <span class="font-semibold text-slate-700">Network Usage</span>
                        <span class="font-semibold text-amber-700">58%</span>
                    </div>

                    <div class="h-3 rounded-full bg-slate-100">
                        <div class="h-3 rounded-full bg-amber-500" style="width:58%"></div>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <!-- System Logs Table -->
    <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">

        <div class="mb-5 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">

            <div>
                <h2 class="text-lg font-bold text-slate-800">
                    Recent System Events
                </h2>

                <p class="text-sm text-slate-500">
                    Monitor important LMS activities and performance logs.
                </p>
            </div>

            <!-- Sort -->
            <div class="w-full lg:w-72">
                <select class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100">
                    <option>Sort By Latest Events</option>
                    <option>Sort By Event Type</option>
                    <option>Sort By Severity</option>
                </select>
            </div>

        </div>

        <!-- Table -->
        <div class="overflow-x-auto rounded-2xl border border-slate-100">

            <table class="min-w-full divide-y divide-slate-100 text-sm">

                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left font-semibold text-slate-600">
                            Event Date & Time
                        </th>

                        <th class="px-4 py-3 text-left font-semibold text-slate-600">
                            Event Type
                        </th>

                        <th class="px-4 py-3 text-left font-semibold text-slate-600">
                            Description
                        </th>

                        <th class="px-4 py-3 text-center font-semibold text-slate-600">
                            Severity
                        </th>

                        <th class="px-4 py-3 text-center font-semibold text-slate-600">
                            Status
                        </th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100 bg-white">

                    <tr class="transition hover:bg-brand-50/40">
                        <td class="px-4 py-3 text-slate-600">
                            09 May 2026 09:15 AM
                        </td>

                        <td class="px-4 py-3 font-medium text-slate-800">
                            User Authentication
                        </td>

                        <td class="px-4 py-3 text-slate-600">
                            Successful login activity detected from lecturer portal.
                        </td>

                        <td class="px-4 py-3 text-center">
                            <span class="rounded-full bg-emerald-50 px-3 py-1 font-semibold text-emerald-700">
                                Low
                            </span>
                        </td>

                        <td class="px-4 py-3 text-center">
                            <span class="rounded-full bg-emerald-50 px-3 py-1 font-semibold text-emerald-700">
                                Resolved
                            </span>
                        </td>
                    </tr>

                    <tr class="transition hover:bg-brand-50/40">
                        <td class="px-4 py-3 text-slate-600">
                            09 May 2026 08:42 AM
                        </td>

                        <td class="px-4 py-3 font-medium text-slate-800">
                            Database Optimization
                        </td>

                        <td class="px-4 py-3 text-slate-600">
                            Scheduled database indexing operation completed.
                        </td>

                        <td class="px-4 py-3 text-center">
                            <span class="rounded-full bg-brand-50 px-3 py-1 font-semibold text-brand-700">
                                Medium
                            </span>
                        </td>

                        <td class="px-4 py-3 text-center">
                            <span class="rounded-full bg-emerald-50 px-3 py-1 font-semibold text-emerald-700">
                                Completed
                            </span>
                        </td>
                    </tr>

                    <tr class="transition hover:bg-brand-50/40">
                        <td class="px-4 py-3 text-slate-600">
                            08 May 2026 11:30 PM
                        </td>

                        <td class="px-4 py-3 font-medium text-slate-800">
                            Server Load Spike
                        </td>

                        <td class="px-4 py-3 text-slate-600">
                            Temporary increase in CPU utilization during report generation.
                        </td>

                        <td class="px-4 py-3 text-center">
                            <span class="rounded-full bg-amber-50 px-3 py-1 font-semibold text-amber-700">
                                High
                            </span>
                        </td>

                        <td class="px-4 py-3 text-center">
                            <span class="rounded-full bg-emerald-50 px-3 py-1 font-semibold text-emerald-700">
                                Stabilized
                            </span>
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

        <!-- Pagination -->
        <div class="mt-5 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">

            <p class="text-sm text-slate-500">
                Showing 1 to 3 of 28 system events
            </p>

            <div class="flex items-center gap-2">

                <button class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-50">
                    Previous
                </button>

                <button class="rounded-xl bg-brand-700 px-4 py-2 text-sm font-semibold text-white">
                    1
                </button>

                <button class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-50">
                    2
                </button>

                <button class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-50">
                    3
                </button>

                <button class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-50">
                    Next
                </button>

            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const ctx = document.getElementById('userActivityChart');

    new Chart(ctx, {
        type: 'line',
        data: {
            labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
            datasets: [{
                label: 'Active Users',
                data: [820, 950, 1120, 1050, 1340, 980, 870],
                borderColor: '#0f8ec7',
                backgroundColor: 'rgba(15,142,199,0.12)',
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            maintainAspectRatio: false,
            responsive: true,
            plugins: {
                legend: {
                    display: true
                }
            }
        }
    });
    </script>