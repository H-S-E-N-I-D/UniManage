@{
    ViewData["Title"] = "Lecturer Workload Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="space-y-6">

    <!-- Page Header -->
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">

        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.25em] text-brand-700">
                Reports and Analytics
            </p>

            <h1 class="mt-2 text-2xl font-bold text-slate-800">
                Lecturer Workload Report
            </h1>

            <p class="mt-1 text-sm text-slate-500">
                Analyze lecturer teaching load, assigned modules, student allocations, grading activities, and weekly working hours.
            </p>
        </div>

        <div class="flex flex-wrap gap-3">

            <button class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700">
                <i class="fa-solid fa-file-excel"></i>
                Export to Excel
            </button>

            <button class="inline-flex items-center gap-2 rounded-xl bg-rose-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-rose-700">
                <i class="fa-solid fa-file-pdf"></i>
                Export to PDF
            </button>

        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

        <div class="rounded-2xl border border-blue-300 bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">Total Lecturers</p>
            <h3 class="mt-2 text-2xl font-bold text-slate-800">20</h3>
        </div>

        <div class="rounded-2xl border border-blue-300 bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">Average Weekly Hours</p>
            <h3 class="mt-2 text-2xl font-bold text-brand-700">34 hrs</h3>
        </div>

        <div class="rounded-2xl border border-blue-300 bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">Average Modules Assigned</p>
            <h3 class="mt-2 text-2xl font-bold text-emerald-600">4 Modules</h3>
        </div>

        <div class="rounded-2xl border border-blue-300 bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">High Workload Lecturers</p>
            <h3 class="mt-2 text-2xl font-bold text-rose-600">5</h3>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">

        <h2 class="mb-4 text-lg font-bold text-slate-800">
            Generate Report
        </h2>

        <div class="grid gap-4 lg:grid-cols-4">

            <!-- Searchable Department Dropdown -->
            <div class="relative">

                <label class="mb-1 block text-sm font-semibold text-slate-600">
                    Department
                </label>

                <button id="departmentDropdownButton"
                        type="button"
                        class="flex w-full items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-left text-sm text-slate-600 outline-none transition hover:border-brand-400 focus:border-brand-500 focus:ring-2 focus:ring-brand-100">

                    <span id="selectedDepartmentText">
                        Select department
                    </span>

                    <i class="fa-solid fa-chevron-down text-xs text-slate-400"></i>
                </button>

                <input type="hidden" id="selectedDepartmentValue" />

                <div id="departmentDropdownPanel"
                     class="absolute z-40 mt-2 hidden w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">

                    <div class="border-b border-slate-100 p-3">

                        <div class="relative">

                            <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-sm text-slate-400"></i>

                            <input id="departmentSearchInput"
                                   type="text"
                                   placeholder="Search department"
                                   class="w-full rounded-xl border border-slate-200 py-2.5 pl-10 pr-4 text-sm focus:outline-none focus:ring-2 focus:ring-brand-600" />
                        </div>
                    </div>

                    <div id="departmentOptions"
                         class="max-h-72 overflow-y-auto p-2"></div>
                </div>
            </div>

            <!-- Semester -->
            <div>
                <label class="mb-1 block text-sm font-semibold text-slate-600">
                    Semester
                </label>

                <select class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100">
                    <option>Semester 1</option>
                    <option>Semester 2</option>
                    <option>Semester 3</option>
                </select>
            </div>

            <!-- Academic Year -->
            <div>
                <label class="mb-1 block text-sm font-semibold text-slate-600">
                    Academic Year
                </label>

                <select class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-100">
                    <option>2026</option>
                    <option>2025</option>
                    <option>2024</option>
                </select>
            </div>

            <!-- Generate Button -->
            <div class="flex items-end">
                <button class="w-full rounded-xl bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-800">
                    <i class="fa-solid fa-chart-line mr-2"></i>
                    Generate Report
                </button>
            </div>
        </div>
    </div>

    <!-- Report Table -->
    <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">

        <div class="mb-4 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

            <h2 class="text-lg font-bold text-slate-800">
                Lecturer Workload Details
            </h2>

            <select id="sortOption"
                    class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-100 sm:w-80">

                <option value="name">Sort by Lecturer Name</option>
                <option value="hoursDesc">Highest Weekly Hours</option>
                <option value="hoursAsc">Lowest Weekly Hours</option>
                <option value="modulesDesc">Highest Modules Assigned</option>
                <option value="modulesAsc">Lowest Modules Assigned</option>
                <option value="studentsDesc">Highest Student Count</option>
                <option value="studentsAsc">Lowest Student Count</option>
            </select>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto rounded-2xl border border-slate-100">

            <table class="min-w-full divide-y divide-slate-100 text-sm">

                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left font-semibold text-slate-600">Lecturer Name</th>
                        <th class="px-4 py-3 text-center font-semibold text-slate-600">Lecturer ID</th>
                        <th class="px-4 py-3 text-left font-semibold text-slate-600">Department</th>
                        <th class="px-4 py-3 text-center font-semibold text-slate-600">Modules Assigned</th>
                        <th class="px-4 py-3 text-center font-semibold text-slate-600">Lecture Hours</th>
                        <th class="px-4 py-3 text-center font-semibold text-slate-600">Lab Hours</th>
                        <th class="px-4 py-3 text-center font-semibold text-slate-600">Weekly Hours</th>
                        <th class="px-4 py-3 text-center font-semibold text-slate-600">Students Handled</th>
                        <th class="px-4 py-3 text-center font-semibold text-slate-600">Assignments to Grade</th>
                        <th class="px-4 py-3 text-center font-semibold text-slate-600">Workload Status</th>
                    </tr>
                </thead>

                <tbody id="workloadTableBody"
                       class="divide-y divide-slate-100 bg-white">
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">

            <p id="paginationInfo"
               class="text-sm text-slate-500"></p>

            <div class="flex items-center gap-2">

                <button id="previousPage"
                        class="rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-500 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50">
                    Previous
                </button>

                <div id="paginationButtons"
                     class="flex items-center gap-2"></div>

                <button id="nextPage"
                        class="rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-500 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50">
                    Next
                </button>
            </div>
        </div>
    </div>
</div>

<script>

    const departments = [
        { code: "DSE", name: "Department of Software Engineering" },
        { code: "DCS", name: "Department of Computer Science" },
        { code: "DIT", name: "Department of Information Technology" },
        { code: "DCY", name: "Department of Cyber Security" },
        { code: "DDS", name: "Department of Data Science" }
    ];

    const lecturers = [

        {
            name: "Dr. Nuwan Perera",
            id: "LEC0001",
            department: "Software Engineering",
            modules: 4,
            lectureHours: 16,
            labHours: 8,
            weeklyHours: 32,
            students: 142,
            assignments: 284,
            status: "Normal"
        },

        {
            name: "Prof. Ishara Fernando",
            id: "LEC0002",
            department: "Computer Science",
            modules: 5,
            lectureHours: 20,
            labHours: 10,
            weeklyHours: 38,
            students: 176,
            assignments: 352,
            status: "High"
        },

        {
            name: "Dr. Kavindi Silva",
            id: "LEC0003",
            department: "Information Technology",
            modules: 3,
            lectureHours: 12,
            labHours: 6,
            weeklyHours: 26,
            students: 98,
            assignments: 196,
            status: "Low"
        },

        {
            name: "Prof. Malith Jayasinghe",
            id: "LEC0004",
            department: "Software Engineering",
            modules: 6,
            lectureHours: 24,
            labHours: 12,
            weeklyHours: 44,
            students: 214,
            assignments: 428,
            status: "Very High"
        },

        {
            name: "Dr. Sanduni Peris",
            id: "LEC0005",
            department: "Artificial Intelligence",
            modules: 4,
            lectureHours: 16,
            labHours: 8,
            weeklyHours: 34,
            students: 126,
            assignments: 252,
            status: "Normal"
        },

        {
            name: "Dr. Tharindu Wijesinghe",
            id: "LEC0006",
            department: "Data Science",
            modules: 5,
            lectureHours: 18,
            labHours: 10,
            weeklyHours: 39,
            students: 168,
            assignments: 336,
            status: "High"
        },

        {
            name: "Prof. Dinuka Ekanayake",
            id: "LEC0007",
            department: "Computer Science",
            modules: 2,
            lectureHours: 8,
            labHours: 4,
            weeklyHours: 18,
            students: 72,
            assignments: 144,
            status: "Low"
        },

        {
            name: "Dr. Yasasvi Gunawardena",
            id: "LEC0008",
            department: "Cyber Security",
            modules: 4,
            lectureHours: 15,
            labHours: 9,
            weeklyHours: 33,
            students: 137,
            assignments: 274,
            status: "Normal"
        },

        {
            name: "Prof. Chamodi Rathnayake",
            id: "LEC0009",
            department: "Cloud Computing",
            modules: 5,
            lectureHours: 21,
            labHours: 10,
            weeklyHours: 41,
            students: 183,
            assignments: 366,
            status: "High"
        },

        {
            name: "Dr. Lahiru Fernando",
            id: "LEC0010",
            department: "Mobile Computing",
            modules: 3,
            lectureHours: 12,
            labHours: 6,
            weeklyHours: 27,
            students: 91,
            assignments: 182,
            status: "Low"
        }
    ];

    let currentPage = 1;
    const rowsPerPage = 10;

    let sortedLecturers = [...lecturers];

    const workloadTableBody = document.getElementById("workloadTableBody");
    const paginationButtons = document.getElementById("paginationButtons");
    const paginationInfo = document.getElementById("paginationInfo");

    function renderTable() {

        workloadTableBody.innerHTML = "";

        const start = (currentPage - 1) * rowsPerPage;
        const end = start + rowsPerPage;

        const paginatedLecturers =
            sortedLecturers.slice(start, end);

        paginatedLecturers.forEach(lecturer => {

            let statusClass = "";

            if (lecturer.status === "Very High")
                statusClass = "bg-rose-50 text-rose-700";

            else if (lecturer.status === "High")
                statusClass = "bg-amber-50 text-amber-700";

            else if (lecturer.status === "Normal")
                statusClass = "bg-emerald-50 text-emerald-700";

            else
                statusClass = "bg-slate-100 text-slate-700";

            workloadTableBody.innerHTML += `
                <tr class="transition hover:bg-brand-50/40">

                    <td class="px-4 py-3 font-medium text-slate-800">
                        ${lecturer.name}
                    </td>

                    <td class="px-4 py-3 text-center text-slate-600">
                        ${lecturer.id}
                    </td>

                    <td class="px-4 py-3 text-slate-600">
                        ${lecturer.department}
                    </td>

                    <td class="px-4 py-3 text-center text-slate-600">
                        ${lecturer.modules}
                    </td>

                    <td class="px-4 py-3 text-center text-slate-600">
                        ${lecturer.lectureHours} hrs
                    </td>

                    <td class="px-4 py-3 text-center text-slate-600">
                        ${lecturer.labHours} hrs
                    </td>

                    <td class="px-4 py-3 text-center">
                        <span class="rounded-full bg-brand-50 px-3 py-1 font-semibold text-brand-700">
                            ${lecturer.weeklyHours} hrs
                        </span>
                    </td>

                    <td class="px-4 py-3 text-center text-slate-600">
                        ${lecturer.students}
                    </td>

                    <td class="px-4 py-3 text-center text-slate-600">
                        ${lecturer.assignments}
                    </td>

                    <td class="px-4 py-3 text-center">
                        <span class="rounded-full px-3 py-1 font-semibold ${statusClass}">
                            ${lecturer.status}
                        </span>
                    </td>

                </tr>
            `;
        });

        renderPagination();
    }

    function renderPagination() {

        paginationButtons.innerHTML = "";

        const totalPages =
            Math.ceil(sortedLecturers.length / rowsPerPage);

        paginationInfo.textContent =
            `Showing ${(currentPage - 1) * rowsPerPage + 1} to ${Math.min(currentPage * rowsPerPage, sortedLecturers.length)} of ${sortedLecturers.length} records`;

        for (let i = 1; i <= totalPages; i++) {

            const button = document.createElement("button");

            button.textContent = i;

            button.className =
                i === currentPage
                    ? "rounded-lg bg-brand-700 px-3 py-2 text-sm font-semibold text-white"
                    : "rounded-lg border border-slate-200 px-3 py-2 text-sm text-slate-600 hover:bg-slate-50";

            button.addEventListener("click", () => {
                currentPage = i;
                renderTable();
            });

            paginationButtons.appendChild(button);
        }

        document.getElementById("previousPage").disabled =
            currentPage === 1;

        document.getElementById("nextPage").disabled =
            currentPage === totalPages;
    }

    document.getElementById("previousPage")
        .addEventListener("click", () => {

            if (currentPage > 1) {
                currentPage--;
                renderTable();
            }
        });

    document.getElementById("nextPage")
        .addEventListener("click", () => {

            const totalPages =
                Math.ceil(sortedLecturers.length / rowsPerPage);

            if (currentPage < totalPages) {
                currentPage++;
                renderTable();
            }
        });

    document.getElementById("sortOption")
        .addEventListener("change", function () {

            const value = this.value;

            sortedLecturers.sort((a, b) => {

                if (value === "name")
                    return a.name.localeCompare(b.name);

                if (value === "hoursDesc")
                    return b.weeklyHours - a.weeklyHours;

                if (value === "hoursAsc")
                    return a.weeklyHours - b.weeklyHours;

                if (value === "modulesDesc")
                    return b.modules - a.modules;

                if (value === "modulesAsc")
                    return a.modules - b.modules;

                if (value === "studentsDesc")
                    return b.students - a.students;

                if (value === "studentsAsc")
                    return a.students - b.students;

                return 0;
            });

            currentPage = 1;

            renderTable();
        });

    renderTable();

</script>