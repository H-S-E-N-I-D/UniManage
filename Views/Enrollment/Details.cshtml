@{
    ViewData["Title"] = "Enrollment Request Details";
}

<section class="space-y-6">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <p class="text-xs font-extrabold uppercase tracking-[0.25em] text-brand-700">Enrollment Management</p>
            <h1 class="mt-2 text-2xl font-extrabold text-slate-900 sm:text-3xl">Enrollment Request Details</h1>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
                Review student details, course enrollment capacity, entry requirements, and uploaded documents before making a decision.
            </p>
        </div>

        <a href="/Enrollment/Requests" class="inline-flex items-center justify-center gap-2 rounded-full bg-slate-100 px-5 py-2.5 text-sm font-bold text-slate-700 transition hover:bg-slate-200">
            <i class="fa-solid fa-arrow-left"></i>
            Back to Requests
        </a>
    </div>

    <div id="statusAlert" class="hidden rounded-3xl border px-5 py-4 text-sm font-semibold"></div>

    <div class="grid gap-6 xl:grid-cols-12">
        <div class="space-y-6 xl:col-span-8 2xl:col-span-9">
            <section class="rounded-[28px] border border-slate-200 bg-white p-5 shadow-panel sm:p-6">
                <div class="flex items-center justify-between gap-4 border-b border-slate-100 pb-4">

                    <div class="flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-50 text-brand-700">
                            <i class="fa-solid fa-user-graduate"></i>
                        </div>

                        <div>
                            <h2 class="text-lg font-bold text-slate-900">Student Information</h2>
                            <p class="mt-1 text-sm text-slate-500">
                                Basic information about the student enrollment request.
                            </p>
                        </div>
                    </div>

                    <span id="statusBadge"
                          class="rounded-full bg-amber-50 px-4 py-2 text-xs font-extrabold text-amber-700 ring-1 ring-amber-100">
                        Pending
                    </span>
                </div>

                <dl class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
                    <div class="rounded-2xl bg-slate-50 p-4">
                        <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Student Name</dt>
                        <dd class="mt-2 text-sm font-semibold text-slate-900">Kasun Perera</dd>
                    </div>
                    <div class="rounded-2xl bg-slate-50 p-4">
                        <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Student Id</dt>
                        <dd class="mt-2 text-sm font-semibold text-slate-900">STU-2026-001</dd>
                    </div>
                    <div class="rounded-2xl bg-slate-50 p-4">
                        <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Request Date</dt>
                        <dd class="mt-2 text-sm font-semibold text-slate-900">01 May 2026</dd>
                    </div>
                    <div class="rounded-2xl bg-slate-50 p-4">
                        <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Status</dt>
                        <dd id="statusText" class="mt-2 text-sm font-semibold text-amber-700">Pending</dd>
                    </div>
                </dl>
            </section>

            <section class="rounded-[28px] border border-slate-200 bg-white p-5 shadow-panel sm:p-6">
                <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
                    <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-50 text-brand-700">
                        <i class="fa-solid fa-book-open-reader"></i>
                    </div>

                    <div>
                        <h2 class="text-lg font-bold text-slate-900">Course Information</h2>
                        <p class="text-sm text-slate-500">
                            Course and intake details related to this enrollment request.
                        </p>
                    </div>
                </div>

                <dl class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                    <div class="rounded-2xl bg-slate-50 p-4">
                        <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Academic Year</dt>
                        <dd class="mt-2 text-sm font-semibold text-slate-900">2026</dd>
                    </div>
                    <div class="rounded-2xl bg-slate-50 p-4 xl:col-span-2">
                        <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Course Name</dt>
                        <dd class="mt-2 text-sm font-semibold text-slate-900">BSc (Hons) in Software Engineering</dd>
                    </div>
                    <div class="rounded-2xl bg-slate-50 p-4">
                        <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Department</dt>
                        <dd class="mt-2 text-sm font-semibold text-slate-900">Department of Computing</dd>
                    </div>
                    <div class="rounded-2xl bg-slate-50 p-4">
                        <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Enrollment Start Date</dt>
                        <dd class="mt-2 text-sm font-semibold text-slate-900">01 May 2026</dd>
                    </div>
                    <div class="rounded-2xl bg-slate-50 p-4">
                        <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Enrollment End Date</dt>
                        <dd class="mt-2 text-sm font-semibold text-slate-900">31 May 2026</dd>
                    </div>
                    <div class="rounded-2xl bg-slate-50 p-4">
                        <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Enrollment Cap</dt>
                        <dd class="mt-2 text-sm font-semibold text-slate-900">120 Students</dd>
                    </div>
                    <div class="rounded-2xl bg-slate-50 p-4">
                        <dt class="text-xs font-bold uppercase tracking-wider text-slate-500">Total Number of Enrollments</dt>
                        <dd class="mt-2 text-sm font-semibold text-slate-900">96 Students</dd>
                    </div>
                </dl>
            </section>

            <section class="rounded-[28px] border border-slate-200 bg-white p-5 shadow-panel sm:p-6">
                <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
                    <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-50 text-brand-700">
                        <i class="fa-solid fa-list-check"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold text-slate-900">Entry Requirements</h2>
                        <p class="text-sm text-slate-500">Requirements applicable to the selected course.</p>
                    </div>
                </div>

                <ul class="mt-5 space-y-3 text-sm leading-6 text-slate-600">
                    <li class="flex gap-3"><span class="font-extrabold text-brand-700">•</span><span>Successful completion of Advanced Level, foundation, diploma, or equivalent qualification.</span></li>
                    <li class="flex gap-3"><span class="font-extrabold text-brand-700">•</span><span>Basic English communication and academic writing ability.</span></li>
                    <li class="flex gap-3"><span class="font-extrabold text-brand-700">•</span><span>Basic computer literacy is recommended for computing-related modules.</span></li>
                    <li class="flex gap-3"><span class="font-extrabold text-brand-700">•</span><span>Mature applicants may be considered based on work experience and prior learning.</span></li>
                </ul>
            </section>

            <section class="overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-panel">
                <div class="border-b border-slate-100 px-5 py-5 sm:px-6">
                    <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
                        <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-50 text-brand-700">
                            <i class="fa-solid fa-file-text"></i>
                        </div>
                        <div>
                            <h2 class="text-lg font-bold text-slate-900">Uploaded Documents</h2>
                            <p class="mt-1 text-sm text-slate-500">Documents uploaded by the student during enrollment submission.</p>
                        </div>
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200 text-sm">
                        <thead class="bg-slate-50 text-left text-sm font-bold text-slate-700">
                            <tr>
                                <th class="px-5 py-4">Document</th>
                                <th class="px-5 py-4">File Name</th>
                                <th class="px-5 py-4">Type</th>
                                <th class="px-5 py-4 text-right">Download</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 bg-white">
                            <tr class="hover:bg-slate-50">
                                <td class="px-5 py-4 font-semibold text-slate-900">Curriculum Vitae</td>
                                <td class="px-5 py-4 text-slate-600">kasun_perera_cv.pdf</td>
                                <td class="px-5 py-4 text-slate-500">PDF</td>
                                <td class="px-5 py-4 text-right">
                                    <a href="#" class="inline-flex items-center gap-2 rounded-full bg-brand-50 px-4 py-2 text-xs font-extrabold text-brand-700 transition hover:bg-brand-100">
                                        <i class="fa-solid fa-download"></i> Download
                                    </a>
                                </td>
                            </tr>
                            <tr class="hover:bg-slate-50">
                                <td class="px-5 py-4 font-semibold text-slate-900">Academic and professional qualifications</td>
                                <td class="px-5 py-4 text-slate-600">academic_certificates.pdf</td>
                                <td class="px-5 py-4 text-slate-500">PDF</td>
                                <td class="px-5 py-4 text-right">
                                    <a href="#" class="inline-flex items-center gap-2 rounded-full bg-brand-50 px-4 py-2 text-xs font-extrabold text-brand-700 transition hover:bg-brand-100">
                                        <i class="fa-solid fa-download"></i> Download
                                    </a>
                                </td>
                            </tr>
                            <tr class="hover:bg-slate-50">
                                <td class="px-5 py-4 font-semibold text-slate-900">Passport or National Identity Card</td>
                                <td class="px-5 py-4 text-slate-600">nic_copy.jpg</td>
                                <td class="px-5 py-4 text-slate-500">JPG</td>
                                <td class="px-5 py-4 text-right">
                                    <a href="#" class="inline-flex items-center gap-2 rounded-full bg-brand-50 px-4 py-2 text-xs font-extrabold text-brand-700 transition hover:bg-brand-100">
                                        <i class="fa-solid fa-download"></i> Download
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <aside class="xl:col-span-4 2xl:col-span-3">
            <div class="sticky top-24 space-y-5">
                <div class="rounded-[28px] border border-slate-200 bg-white p-5 shadow-panel sm:p-6">
                    <h2 class="text-lg font-bold text-slate-900">Request Decision</h2>
                    <p class="mt-2 text-sm leading-6 text-slate-500">Choose an action after reviewing the enrollment request and supporting documents.</p>

                    <div class="mt-5 space-y-3">
                        <button id="waitListButton" type="button" class="flex w-full items-center justify-center gap-2 rounded-full bg-amber-500 px-5 py-3 text-sm font-extrabold text-white transition hover:-translate-y-0.5 hover:bg-amber-600">
                            <i class="fa-solid fa-clock"></i>
                            Wait List
                        </button>
                        <button id="rejectButton" type="button" class="flex w-full items-center justify-center gap-2 rounded-full bg-rose-600 px-5 py-3 text-sm font-extrabold text-white transition hover:-translate-y-0.5 hover:bg-rose-700">
                            <i class="fa-solid fa-xmark"></i>
                            Reject
                        </button>
                        <button id="approveButton" type="button" class="flex w-full items-center justify-center gap-2 rounded-full bg-emerald-600 px-5 py-3 text-sm font-extrabold text-white transition hover:-translate-y-0.5 hover:bg-emerald-700">
                            <i class="fa-solid fa-check"></i>
                            Approve
                        </button>
                    </div>
                </div>

                <div class="rounded-[28px] border border-brand-100 bg-brand-50 p-5 sm:p-6">
                    <h3 class="text-lg font-semibold text-slate-900">Capacity Summary</h3>
                    <div class="mt-4 space-y-3 text-sm">
                        <div class="flex justify-between gap-4">
                            <span class="text-slate-600">Enrollment Cap</span>
                            <span class="font-semibold text-slate-900">120</span>
                        </div>
                        <div class="flex justify-between gap-4">
                            <span class="text-slate-600">Current Enrollments</span>
                            <span class="font-semibold text-slate-900">96</span>
                        </div>
                        <div class="flex justify-between gap-4">
                            <span class="text-slate-600">Available Seats</span>
                            <span class="font-semibold text-emerald-700">24</span>
                        </div>
                    </div>
                    <div class="mt-5 h-3 overflow-hidden rounded-full bg-white">
                        <div class="h-3 rounded-full bg-brand-700" style="width: 80%;"></div>
                    </div>
                    <p class="mt-2 text-xs font-semibold text-slate-500">80% of enrollment capacity is currently filled.</p>
                </div>
            </div>
        </aside>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const statusBadge = document.getElementById('statusBadge');
            const statusText = document.getElementById('statusText');
            const statusAlert = document.getElementById('statusAlert');
            const waitListButton = document.getElementById('waitListButton');
            const rejectButton = document.getElementById('rejectButton');
            const approveButton = document.getElementById('approveButton');

            function updateStatus(status, styles, message) {
                statusBadge.textContent = status;
                statusBadge.className = styles.badge;

                statusText.textContent = status;
                statusText.className = styles.text;

                statusAlert.textContent = message;
                statusAlert.className = styles.alert;
                statusAlert.classList.remove('hidden');
            }

            waitListButton.addEventListener('click', () => {
                updateStatus(
                    'Wait Listed',
                    {
                        badge: 'rounded-full bg-amber-50 px-4 py-2 text-xs font-extrabold text-amber-700 ring-1 ring-amber-100',
                        text: 'mt-2 text-sm font-semibold text-amber-700',
                        alert: 'rounded-3xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm font-semibold text-amber-800'
                    },
                    'The enrollment request has been moved to the wait list.'
                );
            });

            rejectButton.addEventListener('click', () => {
                updateStatus(
                    'Rejected',
                    {
                        badge: 'rounded-full bg-rose-50 px-4 py-2 text-xs font-extrabold text-rose-700 ring-1 ring-rose-100',
                        text: 'mt-2 text-sm font-semibold text-rose-700',
                        alert: 'rounded-3xl border border-rose-200 bg-rose-50 px-5 py-4 text-sm font-semibold text-rose-800'
                    },
                    'The enrollment request has been rejected.'
                );
            });

            approveButton.addEventListener('click', () => {
                updateStatus(
                    'Approved',
                    {
                        badge: 'rounded-full bg-emerald-50 px-4 py-2 text-xs font-extrabold text-emerald-700 ring-1 ring-emerald-100',
                        text: 'mt-2 text-sm font-semibold text-emerald-700',
                        alert: 'rounded-3xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm font-semibold text-emerald-800'
                    },
                    'The enrollment request has been approved successfully.'
                );
            });
        });
    </script>
}
