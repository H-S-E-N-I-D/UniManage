                        'Basic English knowledge is recommended.',
                        'Placement assessment may be required for level identification.'
                    ]
                },
                {
                    title: 'Certificate in Business English',
                    department: 'Department of Languages',
                    level: 'Certificate Level',
                    requirements: [
                        'Basic English language ability.',
                        'Suitable for students and working professionals.',
                        'Interest in workplace communication and presentation skills.'
                    ]
                },
                {
                    title: 'Foundation in Academic English',
                    department: 'Department of Languages',
                    level: 'Foundation Level',
                    requirements: [
                        'Basic English literacy.',
                        'Interest in preparing for higher education.',
                        'Placement assessment may be used to recommend support level.'
                    ]
                },
                {
                    title: 'BSc Biomedical Science',
                    department: 'Department of Life Science',
                    level: 'Undergraduate Level',
                    requirements: [
                        'Successful completion of Advanced Level in science stream or equivalent qualification.',
                        'Biology and chemistry background is recommended.',
                        'English language competency suitable for laboratory-based study.'
                    ]
                },
                {
                    title: 'Diploma in Psychology',
                    department: 'Department of Life Science',
                    level: 'Diploma Level',
                    requirements: [
                        'Completion of ordinary level, advanced level, or equivalent qualification.',
                        'Interest in human behavior, counselling, or social sciences.',
                        'English reading and writing ability is recommended.'
                    ]
                },
                {
                    title: 'Certificate in Laboratory Practice',
                    department: 'Department of Life Science',
                    level: 'Certificate Level',
                    requirements: [
                        'Basic science knowledge.',
                        'Ability to follow laboratory safety instructions.',
                        'Suitable for beginners entering laboratory-based study.'
                    ]
                },
                {
                    title: 'HND in Civil Engineering',
                    department: 'Department of Engineering',
                    level: 'Higher National Diploma Level',
                    requirements: [
                        'Completion of Advanced Level, foundation, or equivalent qualification.',
                        'Mathematics or technical subject background is recommended.',
                        'Interest in construction, surveying, and engineering practice.'
                    ]
                },
                {
                    title: 'HND in Electrical and Electronic Engineering',
                    department: 'Department of Engineering',
                    level: 'Higher National Diploma Level',
                    requirements: [
                        'Completion of Advanced Level, foundation, or equivalent qualification.',
                        'Mathematics, physics, or technical subject background is recommended.',
                        'Interest in electrical systems and electronics.'
                    ]
                },
                {
                    title: 'Certificate in AutoCAD for Engineering',
                    department: 'Department of Engineering',
                    level: 'Certificate Level',
                    requirements: [
                        'Basic computer literacy.',
                        'Interest in engineering drawing or design.',
                        'Suitable for students and technical professionals.'
                    ]
                },
                {
                    title: 'Diploma in Business Management',
                    department: 'Department of Management & Law',
                    level: 'Diploma Level',
                    requirements: [
                        'Completion of ordinary level, advanced level, or equivalent qualification.',
                        'Interest in business, management, or entrepreneurship.',
                        'English communication skills are recommended.'
                    ]
                },
                {
                    title: 'BA (Hons) in Business Administration',
                    department: 'Department of Management & Law',
                    level: 'Undergraduate Level',
                    requirements: [
                        'Successful completion of Advanced Level, foundation, diploma, or equivalent qualification.',
                        'Basic knowledge of business studies is recommended.',
                        'English language competency suitable for degree-level study.'
                    ]
                },
                {
                    title: 'MBA in Project Management',
                    department: 'Department of Management & Law',
                    level: 'Postgraduate Level',
                    requirements: [
                        'Recognised bachelor’s degree or equivalent professional qualification.',
                        'Work experience in management, technology, or project-related roles is recommended.',
                        'Applicants may be evaluated through prior learning and professional experience.'
                    ]
                },
                {
                    title: 'Doctor of Business Administration',
                    department: 'Department of Management & Law',
                    level: 'Doctorate Level',
                    requirements: [
                        'Recognised master’s degree or equivalent qualification.',
                        'Research interest aligned with business, management, or leadership practice.',
                        'Professional experience is strongly recommended.'
                    ]
                }
            ];

            const pageOne = document.getElementById('pageOne');
            const pageTwo = document.getElementById('pageTwo');
            const nextButton = document.getElementById('nextButton');
            const backButton = document.getElementById('backButton');
            const stepTitle = document.getElementById('stepTitle');
            const stepDescription = document.getElementById('stepDescription');
            const stepOneIndicator = document.getElementById('stepOneIndicator');
            const stepTwoIndicator = document.getElementById('stepTwoIndicator');
            const progressLine = document.getElementById('progressLine');
            const courseDropdownButton = document.getElementById('courseDropdownButton');
            const courseDropdownPanel = document.getElementById('courseDropdownPanel');
            const courseSearchInput = document.getElementById('courseSearchInput');
            const courseOptions = document.getElementById('courseOptions');
            const selectedCourseText = document.getElementById('selectedCourseText');
            const selectedCourseInput = document.getElementById('selectedCourseInput');
            const courseError = document.getElementById('courseError');
            const entryRequirementsList = document.getElementById('entryRequirementsList');
            const coursePreview = document.getElementById('coursePreview');
            const previewCourseTitle = document.getElementById('previewCourseTitle');
            const previewCourseMeta = document.getElementById('previewCourseMeta');
            const previewCourseLevel = document.getElementById('previewCourseLevel');
            const summarySelectedCourse = document.getElementById('summarySelectedCourse');
            const documentType = document.getElementById('documentType');
            const documentFile = document.getElementById('documentFile');
            const addDocumentButton = document.getElementById('addDocumentButton');
            const uploadedDocumentsTable = document.getElementById('uploadedDocumentsTable');
            const emptyDocumentRow = document.getElementById('emptyDocumentRow');
            const documentTypeError = document.getElementById('documentTypeError');
            const documentFileError = document.getElementById('documentFileError');

            let selectedCourse = null;
            let uploadedDocuments = [];

            function renderCourseOptions(keyword = '') {
                const normalizedKeyword = keyword.trim().toLowerCase();
                const filteredCourses = courses.filter(course =>
                    `${course.title} ${course.department} ${course.level}`.toLowerCase().includes(normalizedKeyword)
                );

                courseOptions.innerHTML = '';

                if (filteredCourses.length === 0) {
                    courseOptions.innerHTML = '<div class="px-4 py-6 text-center text-sm font-semibold text-slate-400">No courses found.</div>';
                    return;
                }

                filteredCourses.forEach(course => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'w-full rounded-xl px-4 py-3 text-left transition hover:bg-brand-50';
                    button.innerHTML = `
                        <span class="block text-sm font-extrabold text-slate-900">${course.title}</span>
                        <span class="mt-1 block text-xs font-semibold text-slate-500">${course.department} • ${course.level}</span>
                    `;
                    button.addEventListener('click', () => selectCourse(course));
                    courseOptions.appendChild(button);
                });
            }

            function selectCourse(course) {
                selectedCourse = course;
                selectedCourseText.textContent = course.title;
                selectedCourseText.classList.remove('text-slate-400');
                selectedCourseText.classList.add('text-slate-900');
                selectedCourseInput.value = course.title;
                courseDropdownPanel.classList.add('hidden');
                courseError.classList.add('hidden');

                previewCourseTitle.textContent = course.title;
                previewCourseMeta.textContent = `${course.department} • ${course.level}`;
                previewCourseLevel.textContent = course.level;
                coursePreview.classList.remove('hidden');
                summarySelectedCourse.textContent = course.title;
                summarySelectedCourse.classList.remove('text-slate-400');
                summarySelectedCourse.classList.add('text-slate-900');

                entryRequirementsList.innerHTML = course.requirements
                    .map(item => `<li class="flex gap-3"><span class="font-extrabold text-brand-700">•</span><span>${item}</span></li>`)
                    .join('');
            }

            function showPageTwo() {
                if (!selectedCourse) {
                    courseError.classList.remove('hidden');
                    return;
                }

                pageOne.classList.add('hidden');
                pageTwo.classList.remove('hidden');
                stepTitle.textContent = 'Page 2: Upload Documents';
                stepDescription.textContent = 'Upload the available supporting documents for your enrollment.';
                stepOneIndicator.className = 'flex h-10 w-10 items-center justify-center rounded-full bg-emerald-600 text-sm font-extrabold text-white shadow-lg shadow-emerald-600/20';
                stepTwoIndicator.className = 'flex h-10 w-10 items-center justify-center rounded-full bg-brand-700 text-sm font-extrabold text-white shadow-lg shadow-brand-700/20';
                progressLine.classList.remove('w-0');
                progressLine.classList.add('w-full');
            }

            function showPageOne() {
                pageTwo.classList.add('hidden');
                pageOne.classList.remove('hidden');
                stepTitle.textContent = 'Page 1: Select Course';
                stepDescription.textContent = 'Choose the programme you wish to enroll in.';
                stepOneIndicator.className = 'flex h-10 w-10 items-center justify-center rounded-full bg-brand-700 text-sm font-extrabold text-white shadow-lg shadow-brand-700/20';
                stepTwoIndicator.className = 'flex h-10 w-10 items-center justify-center rounded-full bg-slate-200 text-sm font-extrabold text-slate-500';
                progressLine.classList.remove('w-full');
                progressLine.classList.add('w-0');
            }

            function addDocument() {
                const selectedType = documentType.value;
                const file = documentFile.files[0];

                documentTypeError.classList.toggle('hidden', Boolean(selectedType));
                documentFileError.classList.toggle('hidden', Boolean(file));

                if (!selectedType || !file) {
                    return;
                }

                uploadedDocuments.push({
                    type: selectedType,
                    fileName: file.name,
                    fileType: file.type || 'Unknown'
                });

                renderUploadedDocuments();
                documentType.value = '';
                documentFile.value = '';
            }

            function renderUploadedDocuments() {
                uploadedDocumentsTable.innerHTML = '';

                if (uploadedDocuments.length === 0) {
                    uploadedDocumentsTable.appendChild(emptyDocumentRow);
                    return;
                }

                uploadedDocuments.forEach((doc, index) => {
                    const row = document.createElement('tr');
                    row.className = 'hover:bg-slate-50';
                    row.innerHTML = `
                        <td class="px-5 py-4 font-bold text-slate-900">${doc.type}</td>
                        <td class="px-5 py-4 text-slate-600">${doc.fileName}</td>
                        <td class="px-5 py-4 text-slate-500">${doc.fileType}</td>
                        <td class="px-5 py-4 text-right">
                            <button type="button" class="remove-document rounded-full bg-rose-50 px-3 py-1.5 text-xs font-extrabold text-rose-600 hover:bg-rose-100" data-index="${index}">Remove</button>
                        </td>
                    `;
                    uploadedDocumentsTable.appendChild(row);
                });
            }

            courseDropdownButton.addEventListener('click', () => {
                courseDropdownPanel.classList.toggle('hidden');
                courseSearchInput.focus();
            });

            document.addEventListener('click', event => {
                if (!courseDropdownPanel.contains(event.target) && !courseDropdownButton.contains(event.target)) {
                    courseDropdownPanel.classList.add('hidden');
                }
            });

            courseSearchInput.addEventListener('input', event => renderCourseOptions(event.target.value));
            nextButton.addEventListener('click', showPageTwo);
            backButton.addEventListener('click', showPageOne);
            addDocumentButton.addEventListener('click', addDocument);

            uploadedDocumentsTable.addEventListener('click', event => {
                if (event.target.classList.contains('remove-document')) {
                    const index = Number(event.target.dataset.index);
                    uploadedDocuments.splice(index, 1);
                    renderUploadedDocuments();
                }
            });

            renderCourseOptions();
        });
    </script>
}
