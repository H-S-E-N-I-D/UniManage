                    ]
                },
                {
                    title: 'BA in Fashion Design',
                    department: 'Department of Art & Design',
                    level: 'Undergraduate Level',
                    requirements: [
                        'Successful completion of Advanced Level or equivalent qualification.',
                        'Creative portfolio or design interest is recommended.',
                        'English language competency suitable for degree-level study.'
                    ]
                },
                {
                    title: 'Diploma in English Language',
                    department: 'Department of Languages',
                    level: 'Diploma Level',
                    requirements: [
