                </div>

                <div class="rounded-2xl border border-slate-100 bg-slate-50 p-4 text-center">
                    <p class="text-sm text-slate-500">Rating</p>
                    <h3 class="mt-1 text-2xl font-bold text-amber-600">4.7</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Interactive Tabs -->
    <div class="rounded-2xl border border-slate-100 bg-white p-5 shadow-sm">
        <div class="mb-5 flex flex-wrap gap-2 border-b border-slate-100 pb-4">
            <button class="tab-button rounded-xl bg-brand-700 px-4 py-2 text-sm font-semibold text-white" data-tab="personal">
                Personal Details
            </button>
            <button class="tab-button rounded-xl px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50" data-tab="academic">
                Academic Details
            </button>
            <button class="tab-button rounded-xl px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50" data-tab="modules">
                Assigned Modules
            </button>
            <button class="tab-button rounded-xl px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50" data-tab="workload">
                Workload
