            </div>

            <div class="grid gap-4 sm:grid-cols-4 lg:w-[680px]">
                <div class="rounded-2xl border border-slate-100 bg-slate-50 p-4 text-center">
                    <p class="text-sm text-slate-500">Assigned Modules</p>
                    <h3 class="mt-1 text-2xl font-bold text-brand-700">4</h3>
                </div>

                <div class="rounded-2xl border border-slate-100 bg-slate-50 p-4 text-center">
                    <p class="text-sm text-slate-500">Students</p>
                    <h3 class="mt-1 text-2xl font-bold text-emerald-600">142</h3>
                </div>

