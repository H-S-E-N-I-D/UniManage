                    NP
                </div>

                <div>
                    <h2 class="text-2xl font-bold text-slate-800">Dr. Nuwan Perera</h2>
                    <p class="mt-1 text-sm text-slate-500">Lecturer ID: LEC0001</p>

                    <div class="mt-3 flex flex-wrap gap-2">
                        <span class="rounded-full bg-emerald-50 px-3 py-1 text-sm font-semibold text-emerald-700">
                            Active
                        </span>
                        <span class="rounded-full bg-brand-50 px-3 py-1 text-sm font-semibold text-brand-700">
                            Senior Lecturer
                        </span>
                        <span class="rounded-full bg-indigo-50 px-3 py-1 text-sm font-semibold text-indigo-700">
                            Software Engineering
                        </span>
                    </div>
