            </button>
        </div>

        <div class="space-y-5">
            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">Title</label>
                <input type="text" class="w-full rounded-xl border border-slate-300 px-4 py-3 focus:border-brand-500 focus:outline-none">
            </div>

            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">Description</label>
                <textarea rows="4" class="w-full rounded-xl border border-slate-300 px-4 py-3 focus:border-brand-500 focus:outline-none"></textarea>
            </div>

            <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700">File</label>
                <input type="file" class="w-full rounded-xl border border-slate-300 px-4 py-3">
            </div>

            <button class="w-full rounded-xl bg-brand-700 px-5 py-3 text-sm font-semibold text-white hover:bg-brand-800">
                Submit
            </button>
        </div>
    </div>
</div>

