<!-- Course Material Modal -->
<div id="materialModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div class="w-full max-w-lg rounded-3xl bg-white p-6 shadow-2xl">
        <div class="mb-5 flex items-center justify-between">
            <h2 class="text-xl font-bold text-slate-800">New Course Material</h2>
            <button onclick="closeModal('materialModal')" class="text-slate-500 hover:text-slate-700">
