@{
    ViewData["Title"] = "Lecturer Module Information";
}

<div class="space-y-6">

    <!-- Module Header -->
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
        <a href="javascript:history.back()"
           class="mb-4 inline-flex items-center text-sm font-semibold text-brand-700 hover:text-brand-800">
            ← Back to My Modules
        </a>

        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div>
                <h1 class="mt-2 text-2xl font-bold text-slate-800">
                    Software Testing and Quality Assurance
                </h1>
                <p class="mt-2 text-sm text-slate-500">
                    Module Code: <span class="font-semibold text-slate-700">SE202</span>
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-3xl bg-brand-100 text-brand-700">
                <i class="fa-solid fa-book-open-reader text-3xl"></i>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-panel">

        <div class="flex border-b border-slate-200">
            <button onclick="showTab('materials')" id="tab-materials"
                    class="tab-btn flex-1 border-b-2 border-brand-700 px-4 py-4 text-sm font-bold text-brand-700">
                Course Materials
            </button>

            <button onclick="showTab('announcements')" id="tab-announcements"
                    class="tab-btn flex-1 border-b-2 border-transparent px-4 py-4 text-sm font-bold text-slate-500 hover:text-brand-700">
                Announcements
            </button>

            <button onclick="showTab('assessments')" id="tab-assessments"
                    class="tab-btn flex-1 border-b-2 border-transparent px-4 py-4 text-sm font-bold text-slate-500 hover:text-brand-700">
                Assessments
            </button>
        </div>

        <!-- Course Materials -->
        <div id="materials" class="tab-content p-6">
            <div class="mb-6 flex items-center justify-between">
                <div>
                    <h2 class="text-xl font-bold text-slate-800">Course Materials</h2>
                    <p class="text-sm text-slate-500">Upload and manage learning resources.</p>
                </div>

                <button onclick="openModal('materialModal')"
                        class="inline-flex items-center gap-2 rounded-xl bg-green-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-green-700">
                    <i class="fa-solid fa-plus"></i>
                    New Course Material
                </button>
            </div>

            <div class="space-y-4">

                <div class="rounded-2xl border border-slate-200 p-5 transition hover:border-brand-300 hover:shadow-md">
                    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                        <div>
                            <h3 class="text-lg font-bold text-slate-800">Introduction to Software Testing</h3>
                            <p class="mt-1 text-sm text-slate-500">Lecture slides covering testing fundamentals and QA concepts.</p>
                            <div class="mt-3 flex flex-wrap gap-3 text-xs font-semibold text-slate-500">
                                <span>PDF</span>
                                <span>Uploaded: 10 Mar 2026</span>
                            </div>
                        </div>
                        <button class="rounded-xl bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-800">
                            Download
                        </button>
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-200 p-5 transition hover:border-brand-300 hover:shadow-md">
