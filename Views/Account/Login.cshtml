@using UniManage.ViewModels;
@model LoginViewModel;

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}


<a asp-controller="Account"
   asp-action="Register"
   class="inline-flex items-center gap-2 rounded-xl border border-white/40 bg-white/40 px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm backdrop-blur transition hover:bg-white hover:text-blue-700">
    <i class="fa-solid fa-user-plus"></i>
    Register
</a>
</div>
</header>
<!-- Main -->
<main class="relative z-10">
    <div class="mx-auto max-w-6xl px-4 py-5">

        <!-- Glass Container -->
        <div class="glass-panel relative grid min-h-[calc(100vh-90px)] items-center overflow-hidden rounded-[28px] border border-white/40 px-6 py-6 shadow-xl lg:grid-cols-2 lg:gap-8 xl:gap-10">

            <!-- Inner Glass Effects -->
            <div class="pointer-events-none absolute inset-0 rounded-[28px] border border-white/20"></div>
            <div class="pointer-events-none absolute -top-24 left-10 h-52 w-52 rounded-full bg-white/30 blur-3xl"></div>
            <div class="pointer-events-none absolute bottom-0 right-0 h-60 w-60 rounded-full bg-blue-200/30 blur-3xl"></div>

            <!-- Welcome Section -->
            <section class="relative hidden h-full items-center justify-center lg:flex">
                <div class="w-full max-w-md">

                    <div class="flex justify-center">
                        <div class="inline-flex items-center gap-2 rounded-full bg-blue-100/80 px-3.5 py-1.5 text-xs font-semibold text-blue-700 shadow-sm backdrop-blur">
                            <i class="fa-solid fa-bolt"></i>
                            Secure LMS Access Portal
                        </div>
                    </div>

                    <h2 class="mt-3 text-2xl font-extrabold leading-tight text-slate-800 md:text-2xl">
                        Welcome Back to SmartEdu Course Management System
                    </h2>

                    <p class="mt-3 max-w-sm text-sm text-slate-600">
                        Sign in to access your enrolled courses, modules, assessments, announcements and academic communication tools.
                    </p>

                    <!-- Stats -->
                    <div class="mt-5 grid grid-cols-3 gap-2">
                        <div class="glass-card rounded-xl border border-blue-100 p-3 text-center shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                            <h3 class="text-xl font-extrabold text-blue-700">24/7</h3>
                            <p class="mt-1 text-[11px] font-semibold text-slate-500">Access</p>
                        </div>

                        <div class="glass-card rounded-xl border border-emerald-100 p-3 text-center shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                            <h3 class="text-xl font-extrabold text-emerald-700">100%</h3>
                            <p class="mt-1 text-[11px] font-semibold text-slate-500">Secure</p>
                        </div>

                        <div class="glass-card rounded-xl border border-amber-100 p-3 text-center shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                            <h3 class="text-xl font-extrabold text-amber-700">Live</h3>
                            <p class="mt-1 text-[11px] font-semibold text-slate-500">Updates</p>
                        </div>
                    </div>

                    <!-- Features -->
                    <div class="mt-5 grid grid-cols-1 gap-3">

                        <div class="glass-card group flex cursor-pointer items-start gap-3 rounded-xl border border-white/40 p-3 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-700 transition group-hover:bg-blue-700 group-hover:text-white">
                                <i class="fa-solid fa-book-open text-sm"></i>
                            </div>

                            <div>
                                <div class="flex items-center gap-2">
                                    <h3 class="text-sm font-bold text-slate-800">Continue Learning</h3>
                                    <i class="fa-solid fa-arrow-right text-[10px] text-blue-600 opacity-0 transition group-hover:translate-x-1 group-hover:opacity-100"></i>
                                </div>
                                <p class="mt-1 text-xs leading-5 text-slate-500">
                                    Resume enrolled courses and access module learning materials.
                                </p>
                            </div>
                        </div>

                        <div class="glass-card group flex cursor-pointer items-start gap-3 rounded-xl border border-white/40 p-3 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-emerald-100 text-emerald-700 transition group-hover:bg-emerald-600 group-hover:text-white">
                                <i class="fa-solid fa-file-pen text-sm"></i>
                            </div>

                            <div>
                                <div class="flex items-center gap-2">
                                    <h3 class="text-sm font-bold text-slate-800">Track Assessments</h3>
                                    <i class="fa-solid fa-arrow-right text-[10px] text-emerald-600 opacity-0 transition group-hover:translate-x-1 group-hover:opacity-100"></i>
                                </div>
                                <p class="mt-1 text-xs leading-5 text-slate-500">
                                    Monitor deadlines, submissions, marks and lecturer feedback.
                                </p>
                            </div>
                        </div>

                        <div class="glass-card group flex cursor-pointer items-start gap-3 rounded-xl border border-white/40 p-3 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-amber-100 text-amber-700 transition group-hover:bg-amber-500 group-hover:text-white">
                                <i class="fa-solid fa-comments text-sm"></i>
                            </div>

                            <div>
                                <div class="flex items-center gap-2">
                                    <h3 class="text-sm font-bold text-slate-800">Stay Connected</h3>
                                    <i class="fa-solid fa-arrow-right text-[10px] text-amber-600 opacity-0 transition group-hover:translate-x-1 group-hover:opacity-100"></i>
                                </div>
                                <p class="mt-1 text-xs leading-5 text-slate-500">
                                    View announcements and communicate with academic staff.
                                </p>
                            </div>
                        </div>

                    </div>
                </div>
            </section>

            <!-- Login Card -->
            <section class="relative flex h-full items-center justify-center">
                <div class="w-full max-w-sm overflow-hidden rounded-[22px] border border-white/40 bg-white/75 shadow-xl backdrop-blur-xl">

                    <!-- Login Header -->
                    <div class="brand-gradient relative px-5 py-5 text-white">
                        <div class="absolute right-0 top-0 h-32 w-32 rounded-full bg-white/20 blur-3xl"></div>

                        <div class="relative">
                            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 backdrop-blur">
                                <i class="fa-solid fa-right-to-bracket text-base"></i>
                            </div>

                            <h2 class="mt-3 text-2xl font-extrabold">
                                Login
                            </h2>

                            <p class="mt-1.5 text-xs leading-5 text-white/80">
                                Sign in to continue to your SmartEdu LMS dashboard.
                            </p>
                        </div>
                    </div>

                    <!-- Login Form -->
                    <div class="p-5">
                        <form asp-action="Login" method="post" class="space-y-3">
                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly"
                                 class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-700">
                            </div>

                            <!-- Email -->
                            <div>
                                <label asp-for="Email" class="mb-1 block text-xs font-semibold text-slate-700"></label>

                                <div class="relative">
                                    <i class="fa-regular fa-envelope absolute left-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400"></i>

                                    <input asp-for="Email"
                                           placeholder="Enter your email address"
                                           class="w-full rounded-lg border border-slate-200 bg-white/70 py-2 pl-9 pr-4 text-sm text-slate-700 backdrop-blur transition focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-100" />
                                </div>

                                <span asp-validation-for="Email" class="mt-1 block text-[11px] font-semibold text-red-600"></span>
                            </div>

                            <!-- Password -->
                            <div>
                                <label asp-for="Password" class="mb-1 block text-xs font-semibold text-slate-700"></label>

                                <div class="relative">
                                    <i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400"></i>

                                    <input asp-for="Password"
                                           id="passwordInput"
                                           placeholder="Enter password"
                                           class="w-full rounded-lg border border-slate-200 bg-white/70 py-2 pl-9 pr-10 text-sm text-slate-700 backdrop-blur transition focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-100" />

                                    <button type="button"
                                            onclick="togglePassword('passwordInput', 'passwordIcon')"
                                            class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400 hover:text-blue-700">
                                        <i id="passwordIcon" class="fa-regular fa-eye"></i>
                                    </button>
                                </div>

                                <span asp-validation-for="Password" class="mt-1 block text-[11px] font-semibold text-red-600"></span>
                            </div>

                            <!-- Remember + Forgot -->
                            <div class="flex items-center justify-between gap-3">
                                <label class="inline-flex items-center gap-2 text-xs font-semibold text-slate-600">
                                    <input asp-for="RememberMe"
                                           class="h-4 w-4 rounded border-slate-300 text-blue-700 focus:ring-blue-500" />
                                    @Html.DisplayNameFor(a => a.RememberMe)
                                </label>

                                <a asp-controller="Account"
                                   asp-action="VerifyEmail"
                                   class="text-xs font-bold text-blue-700 hover:text-blue-800">
                                    Forgot password?
                                </a>
                            </div>

                            <!-- Submit -->
                            <button type="submit"
                                    class="group flex w-full items-center justify-center gap-2 rounded-lg bg-blue-700 px-4 py-2 text-sm font-bold text-white shadow-md transition hover:-translate-y-0.5 hover:bg-blue-800">
                                <i class="fa-solid fa-right-to-bracket text-xs transition group-hover:scale-110"></i>
                                Login
                            </button>

                            <!-- Register Link -->
                            <p class="text-center text-xs text-slate-500">
                                Don't have an account?
                                <a asp-controller="Account"
                                   asp-action="Register"
                                   class="font-bold text-blue-700 hover:text-blue-800">
                                    Register
                                </a>
                            </p>

                            <!-- Back Link -->
                            <div class="text-center">
                                <a asp-controller="Home"
                                   asp-action="Index"
                                   class="inline-flex items-center gap-2 text-xs font-semibold text-slate-500 hover:text-blue-700">
                                    <i class="fa-solid fa-arrow-left text-[10px]"></i>
                                    Back to Home
                                </a>
                            </div>

                        </form>
                    </div>
                </div>
            </section>

        </div>
    </div>
</main>

