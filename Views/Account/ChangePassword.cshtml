@using UniManage.ViewModels;
@model ChangePasswordViewModel;

@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="hidden md:flex items-center gap-3">
    <a href="/Account/Login" class="px-5 py-2.5 rounded-full bg-white text-blue-700 text-sm font-bold shadow hover:bg-blue-50 transition transform hover:-translate-y-0.5 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-blue-500">Login</a>
    <a href="/Account/Register" class="px-5 py-2.5 rounded-full bg-blue-700 text-white text-sm font-bold hover:bg-blue-800 shadow-lg shadow-blue-700/20 transition transform hover:-translate-y-0.5 hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-blue-300">Register</a>
</div>
</header>
<div class="relative z-10 flex min-h-[calc(100vh-90px)] items-center justify-center px-4 py-8">

    <div class="w-full max-w-sm overflow-hidden rounded-[22px] border border-white/40 bg-white/75 shadow-xl backdrop-blur-xl">

        <!-- Header -->
        <div class="relative bg-gradient-to-br from-blue-900 via-indigo-900 to-blue-600 px-5 py-5 text-white">

            <div class="absolute right-0 top-0 h-32 w-32 rounded-full bg-white/20 blur-3xl"></div>

            <div class="relative">

                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/10 backdrop-blur">
                    <i class="fa-solid fa-key text-base"></i>
                </div>

                <h2 class="mt-3 text-2xl font-extrabold">
                    Change Password
                </h2>

                <p class="mt-1.5 text-xs leading-5 text-white/80">
                    Create a strong new password to secure your UniManage account.
                </p>

            </div>

        </div>

        <!-- Body -->
        <div class="p-5">

            <form asp-action="ChangePassword" method="post" class="space-y-3">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-700">
                </div>

                <!-- Email -->
                <div>

                    <label asp-for="Email"
                           class="mb-1 block text-xs font-semibold text-slate-700">
                    </label>

                    <div class="relative">

                        <i class="fa-regular fa-envelope absolute left-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400"></i>

                        <input asp-for="Email"
                               readonly
                               class="w-full rounded-lg border border-slate-200 bg-slate-100 py-2 pl-9 pr-4 text-sm text-slate-500 backdrop-blur focus:outline-none" />

                    </div>

                </div>

                <!-- New Password -->
                <div>

                    <label asp-for="NewPassword"
                           class="mb-1 block text-xs font-semibold text-slate-700">
                    </label>

                    <div class="relative">

                        <i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400"></i>

                        <input asp-for="NewPassword"
                               id="newPasswordInput"
                               placeholder="Enter new password"
                               class="w-full rounded-lg border border-slate-200 bg-white/70 py-2 pl-9 pr-10 text-sm text-slate-700 backdrop-blur transition focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-100" />

                        <button type="button"
                                onclick="togglePassword('newPasswordInput', 'newPasswordIcon')"
                                class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400 hover:text-blue-700">

                            <i id="newPasswordIcon" class="fa-regular fa-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="NewPassword"
                          class="mt-1 block text-[11px] font-semibold text-red-600">
                    </span>

                </div>

                <!-- Confirm Password -->
                <div>

                    <label asp-for="ConfirmNewPassword"
                           class="mb-1 block text-xs font-semibold text-slate-700">
                    </label>

                    <div class="relative">

                        <i class="fa-solid fa-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400"></i>

                        <input asp-for="ConfirmNewPassword"
                               id="confirmPasswordInput"
                               placeholder="Confirm new password"
                               class="w-full rounded-lg border border-slate-200 bg-white/70 py-2 pl-9 pr-10 text-sm text-slate-700 backdrop-blur transition focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-100" />

                        <button type="button"
                                onclick="togglePassword('confirmPasswordInput', 'confirmPasswordIcon')"
                                class="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs text-slate-400 hover:text-blue-700">

                            <i id="confirmPasswordIcon" class="fa-regular fa-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="ConfirmNewPassword"
                          class="mt-1 block text-[11px] font-semibold text-red-600">
                    </span>

                </div>

                <!-- Submit -->
                <button type="submit"
                        class="group flex w-full items-center justify-center gap-2 rounded-lg bg-blue-700 px-4 py-2 text-sm font-bold text-white shadow-md transition hover:-translate-y-0.5 hover:bg-blue-800">

                    <i class="fa-solid fa-key text-xs transition group-hover:scale-110"></i>

                    Update Password

                </button>

                <!-- Back -->
                <div class="text-center">

                    <a asp-controller="Account"
                       asp-action="VerifyEmail"
                       class="inline-flex items-center gap-2 text-xs font-semibold text-slate-500 hover:text-blue-700">

                        <i class="fa-solid fa-arrow-left text-[10px]"></i>

                        Back to Verify Email

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

<partial name="_ValidationScriptsPartial" />

<script>
    function togglePassword(inputId, iconId) {

        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);

        if (input.type === "password") {

            input.type = "text";

            icon.classList.remove("fa-eye");
            icon.classList.add("fa-eye-slash");

        } else {

            input.type = "password";

            icon.classList.remove("fa-eye-slash");
            icon.classList.add("fa-eye");

        }
    }
</script>