@{
    ViewData["Title"] = "Chats";
}

<div class="space-y-6">

    <!-- Page Header -->
    <div class="flex flex-col gap-4 rounded-3xl border border-slate-200 bg-white p-6 shadow-panel md:flex-row md:items-center md:justify-between">

        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-700">
                Communication
            </p>

            <h1 class="mt-2 text-2xl font-bold text-slate-800">
                Chats
            </h1>

            <p class="mt-2 text-sm text-slate-500">
                Communicate with students and manage academic discussions.
            </p>
        </div>

        <button onclick="newChat()"
                class="inline-flex items-center justify-center gap-2 rounded-xl bg-green-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-green-700">
            <i class="fa-solid fa-plus"></i>
            New Chat
        </button>

    </div>

    <!-- Chat Layout -->
    <div class="grid min-h-[650px] overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-panel lg:grid-cols-12">

        <!-- Left Chat List -->
        <aside class="border-b border-slate-200 bg-slate-50 lg:col-span-4 lg:border-b-0 lg:border-r">

            <!-- Search -->
            <div class="border-b border-slate-200 p-5">

                <h2 class="text-lg font-bold text-slate-800">
                    Student Chats
                </h2>

                <div class="mt-4">
                    <div class="relative">
                        <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-sm text-slate-400"></i>

                        <input type="text"
                               placeholder="Search students"
                               class="w-full rounded-2xl border border-slate-200 bg-white py-3 pl-11 pr-4 text-sm focus:border-brand-500 focus:outline-none">
                    </div>
                </div>

            </div>

            <!-- Chat List -->
            <div class="max-h-[560px] overflow-y-auto">

                <!-- Chat Item -->
                <button onclick="openChat('Kasun Perera', 'ST2025001', 'Department of Computing')"
                        class="w-full border-b border-slate-200 bg-white px-5 py-4 text-left transition hover:bg-brand-50">

                    <div class="flex items-center gap-4">

                        <div class="relative">

                            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-100 text-base font-bold text-brand-700">
                                KP
                            </div>

                            <!-- Unread Counter -->
                            <span class="absolute -right-1 -top-1 flex h-5 min-w-[20px] items-center justify-center rounded-full bg-red-500 px-1 text-[10px] font-bold text-white">
                                3
                            </span>

                        </div>

                        <div class="min-w-0 flex-1">

                            <div class="flex items-center justify-between gap-3">

                                <h3 class="truncate font-bold text-slate-800">
                                    Kasun Perera
                                </h3>

                                <span class="shrink-0 text-xs font-semibold text-slate-400">
                                    Today
                                </span>

                            </div>

                            <p class="mt-1 truncate text-sm font-medium text-slate-700">
                                Sir, I uploaded the corrected coursework document.
                            </p>

                        </div>

                    </div>

                </button>

                <!-- Chat Item -->
                <button onclick="openChat('Nimal Silva', 'ST2025002', 'Department of Computing')"
                        class="w-full border-b border-slate-200 px-5 py-4 text-left transition hover:bg-brand-50">

                    <div class="flex items-center gap-4">

                        <div class="relative">

                            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-base font-bold text-emerald-700">
                                NS
                            </div>

                            <!-- Unread Counter -->
                            <span class="absolute -right-1 -top-1 flex h-5 min-w-[20px] items-center justify-center rounded-full bg-red-500 px-1 text-[10px] font-bold text-white">
                                1
                            </span>

                        </div>

                        <div class="min-w-0 flex-1">

                            <div class="flex items-center justify-between gap-3">

                                <h3 class="truncate font-bold text-slate-800">
                                    Nimal Silva
                                </h3>

                                <span class="shrink-0 text-xs font-semibold text-slate-400">
                                    Yesterday
                                </span>

                            </div>

                            <p class="mt-1 truncate text-sm font-medium text-slate-700">
                                Can you clarify the submission requirements?
                            </p>

                        </div>

                    </div>

                </button>

                <!-- Chat Item -->
                <button onclick="openChat('Tharushi Fernando', 'ST2025003', 'Department of Software Engineering')"
                        class="w-full border-b border-slate-200 px-5 py-4 text-left transition hover:bg-brand-50">

                    <div class="flex items-center gap-4">

                        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-base font-bold text-indigo-700">
                            TF
                        </div>

                        <div class="min-w-0 flex-1">

                            <div class="flex items-center justify-between gap-3">

                                <h3 class="truncate font-bold text-slate-800">
                                    Tharushi Fernando
                                </h3>

                                <span class="shrink-0 text-xs font-semibold text-slate-400">
                                    21 Mar
                                </span>

                            </div>

                            <p class="mt-1 truncate text-sm text-slate-500">
                                Thank you for the feedback on my report.
                            </p>

                        </div>

                    </div>

                </button>

                <!-- Chat Item -->
                <button onclick="openChat('Dinesh Madushanka', 'ST2025004', 'Department of Information Technology')"
                        class="w-full border-b border-slate-200 px-5 py-4 text-left transition hover:bg-brand-50">

                    <div class="flex items-center gap-4">

                        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-amber-100 text-base font-bold text-amber-700">
                            DM
                        </div>

                        <div class="min-w-0 flex-1">

                            <div class="flex items-center justify-between gap-3">

                                <h3 class="truncate font-bold text-slate-800">
                                    Dinesh Madushanka
                                </h3>

                                <span class="shrink-0 text-xs font-semibold text-slate-400">
                                    19 Mar
                                </span>

                            </div>

                            <p class="mt-1 truncate text-sm text-slate-500">
                                I will submit the updated implementation tomorrow.
                            </p>

                        </div>

                    </div>

                </button>

                <!-- Chat Item -->
                <button onclick="openChat('Sachini Jayawardena', 'ST2025005', 'Department of Cyber Security')"
                        class="w-full border-b border-slate-200 px-5 py-4 text-left transition hover:bg-brand-50">

                    <div class="flex items-center gap-4">

                        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-pink-100 text-base font-bold text-pink-700">
                            SJ
                        </div>

                        <div class="min-w-0 flex-1">

                            <div class="flex items-center justify-between gap-3">

                                <h3 class="truncate font-bold text-slate-800">
                                    Sachini Jayawardena
                                </h3>

                                <span class="shrink-0 text-xs font-semibold text-slate-400">
                                    15 Mar
                                </span>

                            </div>

                            <p class="mt-1 truncate text-sm text-slate-500">
                                Please share the practical session slides.
                            </p>

                        </div>

                    </div>

                </button>

            </div>

        </aside>

        <!-- Right Chat Section -->
        <section class="flex min-h-[650px] flex-col lg:col-span-8">

            <!-- Chat Header -->
            <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">

                <div class="flex items-center gap-4">

                    <div id="chatProfileCircle"
                         class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-100 text-base font-bold text-brand-700">
                        KP
                    </div>

                    <div>

                        <h2 id="chatTitle"
                            class="text-lg font-extrabold text-slate-800">
                            Kasun Perera
                        </h2>

                        <p id="chatSubTitle"
                           class="text-sm text-slate-500">
                            Registration No: ST2025001
                        </p>

                    </div>

                </div>

                <button class="rounded-full p-2 text-slate-500 hover:bg-slate-100 hover:text-slate-700">
                    <i class="fa-solid fa-ellipsis-vertical"></i>
                </button>

            </div>

            <!-- Chat Messages -->
            <div id="chatMessages"
                 class="flex-1 space-y-5 overflow-y-auto bg-slate-50 px-6 py-6">

                <!-- Student Message -->
                <div class="flex items-start gap-3">

                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700">
                        KP
                    </div>

                    <div>

                        <div class="max-w-xl rounded-2xl rounded-tl-none bg-white px-5 py-3 text-sm leading-6 text-slate-700 shadow-sm">
                            Sir, I uploaded the corrected coursework document. Could you please verify whether the format is correct?
                        </div>

                        <p class="mt-1 text-xs text-slate-400">
                            09:15 AM
                        </p>

                    </div>

                </div>

                <!-- Lecturer Message -->
                <div class="flex justify-end">

                    <div>

                        <div class="max-w-xl rounded-2xl rounded-tr-none bg-brand-700 px-5 py-3 text-sm leading-6 text-white shadow-sm">
                            I reviewed the submission briefly. The structure looks correct now. Please also include the UML diagrams section.
                        </div>

                        <p class="mt-1 text-right text-xs text-slate-400">
                            09:18 AM
                        </p>

                    </div>

                </div>

                <!-- Student Message -->
                <div class="flex items-start gap-3">

                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700">
                        KP
                    </div>

                    <div>

                        <div class="max-w-xl rounded-2xl rounded-tl-none bg-white px-5 py-3 text-sm leading-6 text-slate-700 shadow-sm">
                            Thank you sir. I will update the diagrams section and resubmit before tomorrow evening.
                        </div>

                        <p class="mt-1 text-xs text-slate-400">
                            09:21 AM
                        </p>

                    </div>

                </div>

            </div>

            <!-- Message Box -->
            <div class="border-t border-slate-200 bg-white p-4">

                <div class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">

                    <!-- Image -->
                    <button title="Attach Image"
                            class="flex h-10 w-10 items-center justify-center rounded-xl text-slate-500 hover:bg-white hover:text-brand-700">
                        <i class="fa-regular fa-image text-lg"></i>
                    </button>

                    <!-- Attachment -->
                    <button title="Add Attachment"
                            class="flex h-10 w-10 items-center justify-center rounded-xl text-slate-500 hover:bg-white hover:text-brand-700">
                        <i class="fa-solid fa-paperclip text-lg"></i>
                    </button>

                    <!-- Emoji -->
                    <button title="Emojis"
                            class="flex h-10 w-10 items-center justify-center rounded-xl text-slate-500 hover:bg-white hover:text-brand-700">
                        <i class="fa-regular fa-face-smile text-lg"></i>
                    </button>

                    <!-- Message Input -->
                    <input id="messageInput"
                           type="text"
                           placeholder="Write a message..."
                           class="flex-1 bg-transparent text-sm text-slate-700 placeholder:text-slate-400 focus:outline-none">

                    <!-- Send -->
                    <button onclick="sendMessage()"
                            class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-700 text-white hover:bg-brand-800">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>

                </div>

            </div>

        </section>

    </div>

</div>

@section Scripts {

    <script>

        function getInitials(name) {
            return name
                .split(' ')
                .map(part => part.charAt(0))
                .join('')
                .substring(0, 2)
                .toUpperCase();
        }

        function openChat(name, regNo, department) {

            const initials = getInitials(name);

            document.getElementById('chatTitle').innerText = name;

            document.getElementById('chatSubTitle').innerText =
                'Registration No: ' + regNo;

            document.getElementById('chatProfileCircle').innerText =
                initials;
        }

        function sendMessage() {

            const input = document.getElementById('messageInput');

            const message = input.value.trim();

            if (!message) {
                return;
            }

            const chatMessages = document.getElementById('chatMessages');

            const wrapper = document.createElement('div');

            wrapper.className = 'flex justify-end';

            wrapper.innerHTML = `
                <div>
                    <div class="max-w-xl rounded-2xl rounded-tr-none bg-brand-700 px-5 py-3 text-sm leading-6 text-white shadow-sm">
                        ${message}
                    </div>

                    <p class="mt-1 text-right text-xs text-slate-400">
                        Just now
                    </p>
                </div>
            `;

            chatMessages.appendChild(wrapper);

            input.value = '';

            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function newChat() {
            alert('New Chat popup or page navigation can be implemented later.');
        }

    </script>

}