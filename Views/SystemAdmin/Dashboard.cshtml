@{
    ViewData["Title"] = "System Admin Dashboard";
}

<div class="space-y-6">

    <!-- Welcome Header -->
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-700">
                    System Admin Portal
                </p>

                <h1 class="mt-2 text-2xl font-bold text-slate-800">
                    System Dashboard
                </h1>

                <p class="mt-2 text-sm text-slate-500">
                    Monitor users, system activity, LMS usage, security alerts and platform performance.
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-3xl bg-brand-100 text-brand-700">
                <i class="fa-solid fa-shield-halved text-3xl"></i>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4">

        <div class="rounded-3xl border border-blue-100 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-semibold text-slate-500">Total Users</p>
                    <h2 class="mt-2 text-3xl font-extrabold text-slate-800">3,842</h2>
                </div>
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-100 text-brand-700">
                    <i class="fa-solid fa-users text-xl"></i>
                </div>
            </div>
        </div>

        <div class="rounded-3xl border border-blue-100 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-semibold text-slate-500">Active Courses</p>
                    <h2 class="mt-2 text-3xl font-extrabold text-slate-800">86</h2>
                </div>
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-700">
                    <i class="fa-solid fa-book-open text-xl"></i>
                </div>
            </div>
        </div>

        <div class="rounded-3xl border border-blue-100 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-semibold text-slate-500">Pending Approvals</p>
                    <h2 class="mt-2 text-3xl font-extrabold text-slate-800">42</h2>
                </div>
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 text-amber-700">
                    <i class="fa-solid fa-user-clock text-xl"></i>
                </div>
            </div>
        </div>

        <div class="rounded-3xl border border-blue-100 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-semibold text-slate-500">Security Alerts</p>
                    <h2 class="mt-2 text-3xl font-extrabold text-slate-800">7</h2>
                </div>
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-red-100 text-red-700">
                    <i class="fa-solid fa-triangle-exclamation text-xl"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- Main Dashboard -->
    <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">

        <!-- Left Content -->
        <div class="space-y-6 xl:col-span-2">

            <!-- User Growth Chart -->
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
                <div class="mb-5 flex items-center justify-between">
                    <div>
                        <h2 class="text-xl font-bold text-slate-800">User Growth Overview</h2>
                        <p class="text-sm text-slate-500">Monthly user registrations across the LMS.</p>
                    </div>

                    <select class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-600 focus:border-brand-500 focus:outline-none">
                        <option>Last 6 Months</option>
                        <option>Last 12 Months</option>
                        <option>This Academic Year</option>
                    </select>
                </div>

                <div class="h-72">
                    <canvas id="userGrowthChart"></canvas>
                </div>
            </div>

            <!-- Charts Row -->
            <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">

                <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
                    <h2 class="mb-5 text-xl font-bold text-slate-800">User Role Distribution</h2>
                    <div class="h-64">
                        <canvas id="roleDistributionChart"></canvas>
                    </div>
                </div>

                <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
                    <h2 class="mb-5 text-xl font-bold text-slate-800">System Activity</h2>
                    <div class="h-64">
                        <canvas id="systemActivityChart"></canvas>
                    </div>
                </div>

            </div>

            <!-- Recent System Logs -->
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
                <div class="mb-5 flex items-center justify-between">
                    <div>
                        <h2 class="text-xl font-bold text-slate-800">Recent System Logs</h2>
                        <p class="text-sm text-slate-500">Latest platform activities and administrative changes.</p>
                    </div>

                    <button onclick="navigateToLogs()"
                            class="rounded-xl border border-brand-700 px-4 py-2 text-sm font-semibold text-brand-700 hover:bg-brand-50">
                        View Logs
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200">
                        <thead class="bg-slate-50">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-bold uppercase text-slate-500">Activity</th>
                                <th class="px-4 py-3 text-left text-xs font-bold uppercase text-slate-500">User</th>
                                <th class="px-4 py-3 text-left text-xs font-bold uppercase text-slate-500">Date Time</th>
                                <th class="px-4 py-3 text-left text-xs font-bold uppercase text-slate-500">Status</th>
                            </tr>
                        </thead>

                        <tbody class="divide-y divide-slate-200 bg-white">
                            <tr>
                                <td class="px-4 py-4 font-semibold text-slate-800">New lecturer account created</td>
                                <td class="px-4 py-4 text-slate-600">System Admin</td>
                                <td class="px-4 py-4 text-slate-600">08 May 2026, 09:15 AM</td>
                                <td class="px-4 py-4">
                                    <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-bold text-green-700">Success</span>
                                </td>
                            </tr>

                            <tr>
                                <td class="px-4 py-4 font-semibold text-slate-800">Failed login attempt detected</td>
                                <td class="px-4 py-4 text-slate-600">Unknown User</td>
                                <td class="px-4 py-4 text-slate-600">08 May 2026, 08:42 AM</td>
                                <td class="px-4 py-4">
                                    <span class="rounded-full bg-red-100 px-3 py-1 text-xs font-bold text-red-700">Alert</span>
                                </td>
                            </tr>

                            <tr>
                                <td class="px-4 py-4 font-semibold text-slate-800">Course registration period updated</td>
                                <td class="px-4 py-4 text-slate-600">Department Admin</td>
                                <td class="px-4 py-4 text-slate-600">07 May 2026, 04:30 PM</td>
                                <td class="px-4 py-4">
                                    <span class="rounded-full bg-blue-100 px-3 py-1 text-xs font-bold text-blue-700">Updated</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

        <!-- Right Sidebar -->
        <div class="space-y-6">

            <!-- Quick Links -->
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
                <h2 class="mb-5 text-xl font-bold text-slate-800">Quick Links</h2>

                <div class="space-y-3">
                    <button onclick="navigateToUsers()"
                            class="flex w-full items-center gap-3 rounded-2xl border border-slate-200 px-4 py-3 text-left font-semibold text-slate-700 hover:border-brand-300 hover:bg-brand-50">
                        <i class="fa-solid fa-users-gear text-brand-700"></i>
                        Manage Users
                    </button>

                    <button onclick="navigateToRoles()"
                            class="flex w-full items-center gap-3 rounded-2xl border border-slate-200 px-4 py-3 text-left font-semibold text-slate-700 hover:border-brand-300 hover:bg-brand-50">
                        <i class="fa-solid fa-user-shield text-brand-700"></i>
                        Role & Permissions
                    </button>

                    <button onclick="navigateToSystemSettings()"
                            class="flex w-full items-center gap-3 rounded-2xl border border-slate-200 px-4 py-3 text-left font-semibold text-slate-700 hover:border-brand-300 hover:bg-brand-50">
                        <i class="fa-solid fa-gears text-brand-700"></i>
                        System Settings
                    </button>

                    <button onclick="navigateToLogs()"
                            class="flex w-full items-center gap-3 rounded-2xl border border-slate-200 px-4 py-3 text-left font-semibold text-slate-700 hover:border-brand-300 hover:bg-brand-50">
                        <i class="fa-solid fa-list-check text-brand-700"></i>
                        Audit Logs
                    </button>

                    <button onclick="navigateToReports()"
                            class="flex w-full items-center gap-3 rounded-2xl border border-slate-200 px-4 py-3 text-left font-semibold text-slate-700 hover:border-brand-300 hover:bg-brand-50">
                        <i class="fa-solid fa-chart-pie text-brand-700"></i>
                        System Reports
                    </button>
                </div>
            </div>

            <!-- System Health -->
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
                <div class="mb-5 flex items-center justify-between">
                    <h2 class="text-xl font-bold text-slate-800">System Health</h2>
                    <i class="fa-solid fa-heart-pulse text-green-600"></i>
                </div>

                <div class="space-y-5">
                    <div>
                        <div class="mb-2 flex justify-between text-sm">
                            <span class="font-semibold text-slate-700">Server Uptime</span>
                            <span class="font-bold text-green-700">99.8%</span>
                        </div>
                        <div class="h-3 rounded-full bg-slate-200">
                            <div class="h-3 rounded-full bg-green-600" style="width: 99.8%;"></div>
                        </div>
                    </div>

                    <div>
                        <div class="mb-2 flex justify-between text-sm">
                            <span class="font-semibold text-slate-700">Storage Usage</span>
                            <span class="font-bold text-amber-700">68%</span>
                        </div>
                        <div class="h-3 rounded-full bg-slate-200">
                            <div class="h-3 rounded-full bg-amber-500" style="width: 68%;"></div>
                        </div>
                    </div>

                    <div>
                        <div class="mb-2 flex justify-between text-sm">
                            <span class="font-semibold text-slate-700">Database Load</span>
                            <span class="font-bold text-brand-700">42%</span>
                        </div>
                        <div class="h-3 rounded-full bg-slate-200">
                            <div class="h-3 rounded-full bg-brand-600" style="width: 42%;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Security Alerts -->
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
                <div class="mb-5 flex items-center justify-between">
                    <h2 class="text-xl font-bold text-slate-800">Security Alerts</h2>
                    <i class="fa-solid fa-triangle-exclamation text-red-600"></i>
                </div>

                <div class="space-y-4">
                    <div class="rounded-2xl bg-red-50 p-4">
                        <h3 class="font-bold text-slate-800">Multiple failed login attempts</h3>
                        <p class="mt-1 text-sm text-slate-500">Detected from unknown IP address.</p>
                        <p class="mt-2 text-xs font-semibold text-red-700">High Priority</p>
                    </div>

                    <div class="rounded-2xl bg-amber-50 p-4">
                        <h3 class="font-bold text-slate-800">Password reset requests increased</h3>
                        <p class="mt-1 text-sm text-slate-500">12 requests within the last hour.</p>
                        <p class="mt-2 text-xs font-semibold text-amber-700">Medium Priority</p>
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        new Chart(document.getElementById('userGrowthChart'), {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                datasets: [{
                    label: 'New Users',
                    data: [240, 310, 420, 390, 510, 620],
                    borderWidth: 3,
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });

        new Chart(document.getElementById('roleDistributionChart'), {
            type: 'doughnut',
            data: {
                labels: ['Students', 'Lecturers', 'Department Admins', 'System Admins'],
                datasets: [{
                    data: [3200, 480, 128, 34],
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });

        new Chart(document.getElementById('systemActivityChart'), {
            type: 'bar',
            data: {
                labels: ['Logins', 'Uploads', 'Submissions', 'Messages', 'Approvals'],
                datasets: [{
                    label: 'Today',
                    data: [820, 145, 230, 560, 72],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });

        function navigateToUsers() {
            console.log("Navigate to manage users");
        }

        function navigateToRoles() {
            console.log("Navigate to role and permissions");
        }

        function navigateToSystemSettings() {
            console.log("Navigate to system settings");
        }

        function navigateToLogs() {
            console.log("Navigate to audit logs");
        }

        function navigateToReports() {
            console.log("Navigate to system reports");
        }
    </script>
}