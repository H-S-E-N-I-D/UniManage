@{
    ViewData["Title"] = "Course Offering Info";
}

<section class="space-y-6">

    <!-- Page Header -->
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <p class="text-sm font-semibold uppercase tracking-[0.25em] text-brand-700">
                Course Offering Management
            </p>
            <h1 class="mt-2 text-2xl font-bold text-slate-800">
                Course Offering View
            </h1>
            <p class="mt-2 text-sm text-slate-500">
                View course offering details, semesters, modules, and assigned lecturers.
            </p>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row lg:justify-end">
            <button id="addSemesterButton" type="button"
                    class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-700 px-5 py-3 text-sm font-extrabold text-white shadow-lg shadow-brand-700/20 transition hover:-translate-y-0.5 hover:bg-brand-800 focus:outline-none focus:ring-2 focus:ring-brand-600">
                <i class="fa-solid fa-calendar-plus"></i>
                Add Semester
            </button>
        </div>
    </div>

    <!-- Course Information -->
    <section class="rounded-[28px] border border-slate-200 bg-white p-5 shadow-panel sm:p-6">
        <div class="flex flex-col gap-4 border-b border-slate-100 pb-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-50 text-brand-700">
                    <i class="fa-solid fa-book-open-reader"></i>
                </div>
                <div>
                    <h2 class="text-lg font-bold text-slate-900">Course Information</h2>
                    <p class="text-sm text-slate-500">Academic and enrollment details related to this course offering.</p>
                </div>
            </div>

            <span id="statusBadge"
                  class="inline-flex w-fit rounded-full bg-emerald-50 px-4 py-2 text-xs font-extrabold uppercase tracking-wide text-emerald-700 ring-1 ring-emerald-100">
                Open
            </span>
        </div>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Course Title</p>
                <p id="courseTitle" class="mt-2 text-sm font-extrabold text-slate-900">BSc (Hons) in Software Engineering</p>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Course Code</p>
                <p id="courseCode" class="mt-2 text-sm font-extrabold text-slate-900">CSE-UG-001</p>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Department</p>
                <p id="department" class="mt-2 text-sm font-extrabold text-slate-900">Department of Computing</p>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Programme Level</p>
                <p id="programmeLevel" class="mt-2 text-sm font-extrabold text-slate-900">Undergraduate Level</p>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Academic Year</p>
                <p id="academicYear" class="mt-2 text-sm font-extrabold text-slate-900">2026</p>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Status</p>
                <p id="statusText" class="mt-2 text-sm font-extrabold text-emerald-700">Open</p>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Duration</p>
                <p id="duration" class="mt-2 text-sm font-extrabold text-slate-900">36 Months</p>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Study Mode</p>
                <p id="studyMode" class="mt-2 text-sm font-extrabold text-slate-900">Full Time</p>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Max Capacity</p>
                <p id="maxCapacity" class="mt-2 text-sm font-extrabold text-slate-900">120</p>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Enrollment Count</p>
                <p id="enrollmentCount" class="mt-2 text-sm font-extrabold text-slate-900">86</p>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Enrollment Start Date</p>
                <p id="enrollmentStartDate" class="mt-2 text-sm font-extrabold text-slate-900">01 May 2026</p>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Enrollment End Date</p>
                <p id="enrollmentEndDate" class="mt-2 text-sm font-extrabold text-slate-900">30 June 2026</p>
            </div>
        </div>
    </section>

    <!-- Semesters -->
    <section class="rounded-[28px] border border-slate-200 bg-white p-5 shadow-panel sm:p-6">
        <div class="flex flex-col gap-4 border-b border-slate-100 pb-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-50 text-brand-700">
                    <i class="fa-solid fa-layer-group"></i>
                </div>
                <div>
                    <h2 class="text-lg font-bold text-slate-900">Semesters</h2>
                    <p class="text-sm text-slate-500">Modules and lecturers assigned under each semester.</p>
                </div>
            </div>

            <span id="semesterCountBadge"
                  class="inline-flex w-fit rounded-full bg-slate-100 px-4 py-2 text-xs font-extrabold text-slate-700">
                2 Semesters
            </span>
        </div>

        <div id="semestersContainer" class="mt-6 space-y-5"></div>
    </section>

    <!-- Page Buttons -->
    <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
        <button id="goBackButton" type="button"
                class="inline-flex items-center justify-center gap-2 rounded-full bg-slate-100 px-8 py-3 text-sm font-extrabold text-slate-700 transition hover:bg-slate-200 focus:outline-none focus:ring-2 focus:ring-slate-300">
            <i class="fa-solid fa-arrow-left"></i>
            Go Back
        </button>

        <button id="saveOfferingButton" type="button"
                class="inline-flex min-w-[220px] items-center justify-center gap-2 rounded-full bg-emerald-600 px-10 py-3 text-sm font-extrabold text-white shadow-lg shadow-emerald-600/20 transition hover:-translate-y-0.5 hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-600">
            <i class="fa-solid fa-floppy-disk"></i>
            Save
        </button>
    </div>

    <!-- Add Semester Popup -->
    <div id="semesterPopup" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4">
        <div class="w-full max-w-xl rounded-[28px] bg-white p-5 shadow-2xl sm:p-6">
            <div class="flex items-start justify-between gap-4 border-b border-slate-100 pb-4">
                <div class="flex items-center gap-3">
                    <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-50 text-brand-700">
                        <i class="fa-solid fa-calendar-plus"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold text-slate-900">Add Semester</h2>
                        <p class="text-sm text-slate-500">Create a new semester section for this course offering.</p>
                    </div>
                </div>

                <button id="closeSemesterPopupButton" type="button"
                        class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition hover:bg-slate-200">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="mt-5 grid gap-5 sm:grid-cols-2">
                <div>
                    <label class="block text-xs font-bold text-slate-700">Academic Year</label>
                    <div class="relative mt-2">
                        <select id="semesterAcademicYear"
                                class="w-full appearance-none rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 shadow-sm transition focus:outline-none focus:ring-2 focus:ring-brand-600">
                            <option value="">Select Academic Year</option>
                            <option value="2026">2026</option>
                            <option value="2025">2025</option>
                        </select>
                        <i class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-xs text-slate-400"></i>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700">Semester Name</label>
                    <input id="semesterNameInput"
                           type="text"
                           placeholder="Example: Semester 3"
                           class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 shadow-sm transition focus:outline-none focus:ring-2 focus:ring-brand-600" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700">Start Date</label>
                    <input id="semesterStartDate"
                           type="date"
                           class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 shadow-sm transition focus:outline-none focus:ring-2 focus:ring-brand-600" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700">End Date</label>
                    <input id="semesterEndDate"
                           type="date"
                           class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 shadow-sm transition focus:outline-none focus:ring-2 focus:ring-brand-600" />
                </div>
            </div>

            <div id="semesterValidationBox"
                 class="mt-5 hidden rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-700">
            </div>

            <div class="mt-6 flex justify-end gap-3 border-t border-slate-100 pt-5">
                <button id="cancelSemesterPopupButton" type="button"
                        class="rounded-full bg-slate-100 px-5 py-3 text-sm font-extrabold text-slate-700 transition hover:bg-slate-200">
                    Cancel
                </button>

                <button id="confirmAddSemesterButton" type="button"
                        class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-700 px-5 py-3 text-sm font-extrabold text-white shadow-lg shadow-brand-700/20 transition hover:bg-brand-800">
                    <i class="fa-solid fa-plus"></i>
                    Add
                </button>
            </div>
        </div>
    </div>

    <!-- Add Module Popup -->
    <div id="modulePopup" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4">
        <div class="w-full max-w-2xl rounded-[28px] bg-white p-5 shadow-2xl sm:p-6">
            <div class="flex items-start justify-between gap-4 border-b border-slate-100 pb-4">
                <div class="flex items-center gap-3">
                    <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-50 text-brand-700">
                        <i class="fa-solid fa-plus"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-bold text-slate-900">Add Module</h2>
                        <p id="popupSemesterText" class="text-sm text-slate-500">Select module and lecturer.</p>
                    </div>
                </div>

                <button id="closePopupButton" type="button"
                        class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition hover:bg-slate-200">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="mt-5 grid gap-5">
                <div>
                    <label class="block text-xs font-bold text-slate-700">Module</label>
                    <div class="relative mt-2">
                        <button id="moduleDropdownButton" type="button"
                                class="flex w-full items-center justify-between rounded-2xl border border-slate-200 bg-white px-4 py-3 text-left text-sm font-semibold text-slate-700 shadow-sm transition hover:border-brand-300 focus:outline-none focus:ring-2 focus:ring-brand-600">
                            <span id="selectedModuleText" class="truncate text-slate-400">Search and select module</span>
                            <i class="fa-solid fa-chevron-down text-xs text-slate-400"></i>
                        </button>

                        <div id="moduleDropdownPanel"
                             class="absolute z-50 mt-2 hidden w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
                            <div class="border-b border-slate-100 p-3">
                                <div class="relative">
                                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-sm text-slate-400"></i>
                                    <input id="moduleSearchInput" type="text" placeholder="Search module"
                                           class="w-full rounded-xl border border-slate-200 py-2.5 pl-10 pr-4 text-sm focus:outline-none focus:ring-2 focus:ring-brand-600" />
                                </div>
                            </div>
                            <div id="moduleOptions" class="max-h-56 overflow-y-auto p-2"></div>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700">Lecturer</label>
                    <div class="relative mt-2">
                        <button id="lecturerDropdownButton" type="button"
                                class="flex w-full items-center justify-between rounded-2xl border border-slate-200 bg-white px-4 py-3 text-left text-sm font-semibold text-slate-700 shadow-sm transition hover:border-brand-300 focus:outline-none focus:ring-2 focus:ring-brand-600">
                            <span id="selectedLecturerText" class="truncate text-slate-400">Search and select lecturer</span>
                            <i class="fa-solid fa-chevron-down text-xs text-slate-400"></i>
                        </button>

                        <div id="lecturerDropdownPanel"
                             class="absolute z-50 mt-2 hidden w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
                            <div class="border-b border-slate-100 p-3">
                                <div class="relative">
                                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-sm text-slate-400"></i>
                                    <input id="lecturerSearchInput" type="text" placeholder="Search lecturer"
                                           class="w-full rounded-xl border border-slate-200 py-2.5 pl-10 pr-4 text-sm focus:outline-none focus:ring-2 focus:ring-brand-600" />
                                </div>
                            </div>
                            <div id="lecturerOptions" class="max-h-56 overflow-y-auto p-2"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="popupValidationBox"
                 class="mt-5 hidden rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-700">
            </div>

            <div class="mt-6 flex justify-end gap-3 border-t border-slate-100 pt-5">
                <button id="cancelPopupButton" type="button"
                        class="rounded-full bg-slate-100 px-5 py-3 text-sm font-extrabold text-slate-700 transition hover:bg-slate-200">
                    Cancel
                </button>

                <button id="confirmAddModuleButton" type="button"
                        class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-700 px-5 py-3 text-sm font-extrabold text-white shadow-lg shadow-brand-700/20 transition hover:bg-brand-800">
                    <i class="fa-solid fa-plus"></i>
                    Add
                </button>
            </div>
        </div>
    </div>

</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const semesters = [
            {
                name: 'Semester 1',
                academicYear: '2026',
                startDate: '2026-01-15',
                endDate: '2026-05-15',
                modules: [
                    { module: 'Programming Fundamentals', lecturer: 'Dr. Nimal Perera' },
                    { module: 'Database Management Systems', lecturer: 'Ms. Thilini Fernando' },
                    { module: 'Web Application Development', lecturer: 'Mr. Kasun Wijesinghe' }
                ]
            },
            {
                name: 'Semester 2',
                academicYear: '2026',
                startDate: '2026-06-01',
                endDate: '2026-10-30',
                modules: [
                    { module: 'Object Oriented Programming', lecturer: 'Dr. Chamara Silva' },
                    { module: 'Software Engineering Principles', lecturer: 'Ms. Dilini Jayawardena' },
                    { module: 'Data Structures and Algorithms', lecturer: 'Mr. Lahiru Bandara' }
                ]
            }
        ];

        const semestersContainer = document.getElementById('semestersContainer');
        const semesterCountBadge = document.getElementById('semesterCountBadge');

        const addSemesterButton = document.getElementById('addSemesterButton');
        const semesterPopup = document.getElementById('semesterPopup');
        const closeSemesterPopupButton = document.getElementById('closeSemesterPopupButton');
        const cancelSemesterPopupButton = document.getElementById('cancelSemesterPopupButton');
        const confirmAddSemesterButton = document.getElementById('confirmAddSemesterButton');
        const semesterAcademicYear = document.getElementById('semesterAcademicYear');
        const semesterNameInput = document.getElementById('semesterNameInput');
        const semesterStartDate = document.getElementById('semesterStartDate');
        const semesterEndDate = document.getElementById('semesterEndDate');
        const semesterValidationBox = document.getElementById('semesterValidationBox');

        const saveOfferingButton = document.getElementById('saveOfferingButton');
        const goBackButton = document.getElementById('goBackButton');

        const modulePopup = document.getElementById('modulePopup');
        const closePopupButton = document.getElementById('closePopupButton');
        const cancelPopupButton = document.getElementById('cancelPopupButton');
        const confirmAddModuleButton = document.getElementById('confirmAddModuleButton');
        const popupSemesterText = document.getElementById('popupSemesterText');
        const popupValidationBox = document.getElementById('popupValidationBox');

        const moduleDropdownButton = document.getElementById('moduleDropdownButton');
        const moduleDropdownPanel = document.getElementById('moduleDropdownPanel');
        const moduleSearchInput = document.getElementById('moduleSearchInput');
        const moduleOptions = document.getElementById('moduleOptions');
        const selectedModuleText = document.getElementById('selectedModuleText');

        const lecturerDropdownButton = document.getElementById('lecturerDropdownButton');
        const lecturerDropdownPanel = document.getElementById('lecturerDropdownPanel');
        const lecturerSearchInput = document.getElementById('lecturerSearchInput');
        const lecturerOptions = document.getElementById('lecturerOptions');
        const selectedLecturerText = document.getElementById('selectedLecturerText');

        let selectedSemesterIndex = null;
        let selectedModule = '';
        let selectedLecturer = '';

        const availableModules = [
            'Programming Fundamentals',
            'Database Management Systems',
            'Web Application Development',
            'Software Engineering Principles',
            'Object Oriented Programming',
            'Data Structures and Algorithms',
            'Cloud Computing',
            'Mobile Application Development',
            'Software Quality Assurance',
            'Final Year Project',
            'Cyber Security Fundamentals'
        ];

        const availableLecturers = [
            'Dr. Nimal Perera',
            'Ms. Thilini Fernando',
            'Mr. Kasun Wijesinghe',
            'Dr. Chamara Silva',
            'Ms. Dilini Jayawardena',
            'Mr. Lahiru Bandara',
            'Dr. Amila Rathnayake',
            'Ms. Kavindi Herath',
            'Mr. Ruwan De Silva',
            'Dr. Harsha Gunawardena',
            'Ms. Anjali Perera'
        ];

        function formatDate(value) {
            if (!value) return 'Not set';

            const date = new Date(value + 'T00:00:00');
            return date.toLocaleDateString('en-GB', {
                day: '2-digit',
                month: 'short',
                year: 'numeric'
            });
        }

        function renderSemesters() {
            semestersContainer.innerHTML = '';
            semesterCountBadge.textContent = `${semesters.length} Semester${semesters.length === 1 ? '' : 's'}`;

            semesters.forEach((semester, semesterIndex) => {
                const semesterCard = document.createElement('div');
                semesterCard.className = 'overflow-hidden rounded-[24px] border border-slate-200 bg-white';

                const rows = semester.modules.map((item, moduleIndex) => `
                    <tr class="transition hover:bg-slate-50">
                        <td class="px-5 py-4 font-semibold text-slate-900">${item.module}</td>
                        <td class="px-5 py-4 text-slate-700">${item.lecturer}</td>
                        <td class="px-5 py-4 text-right">
                            <button type="button"
                                    data-semester="${semesterIndex}"
                                    data-module="${moduleIndex}"
                                    class="remove-module inline-flex h-9 w-9 items-center justify-center rounded-full bg-rose-50 text-rose-700 transition hover:bg-rose-100">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');

                semesterCard.innerHTML = `
                    <div class="flex flex-col gap-4 border-b border-slate-100 bg-slate-50 px-5 py-4 xl:flex-row xl:items-center xl:justify-between">
                        <div>
                            <div class="flex flex-wrap items-center gap-3">
                                <h3 class="text-base font-extrabold text-slate-900">${semester.name}</h3>
                                <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-extrabold text-brand-700">${semester.academicYear}</span>
                            </div>

                            <div class="mt-2 flex flex-wrap gap-3 text-xs font-semibold text-slate-500">
                                <span><i class="fa-regular fa-calendar mr-1 text-brand-600"></i>Start: ${formatDate(semester.startDate)}</span>
                                <span><i class="fa-regular fa-calendar-check mr-1 text-brand-600"></i>End: ${formatDate(semester.endDate)}</span>
                                <span><i class="fa-solid fa-layer-group mr-1 text-brand-600"></i>${semester.modules.length} module${semester.modules.length === 1 ? '' : 's'} assigned</span>
                            </div>
                        </div>

                        <button type="button"
                                data-semester="${semesterIndex}"
                                class="add-module-to-semester inline-flex items-center justify-center gap-2 rounded-full bg-brand-50 px-4 py-2 text-xs font-extrabold text-brand-700 transition hover:bg-brand-100">
                            <i class="fa-solid fa-plus"></i>
                            Add Module
                        </button>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-slate-200 text-sm">
                            <thead class="bg-white text-left text-sm font-bold text-slate-700">
                                <tr>
                                    <th class="px-5 py-4">Module</th>
                                    <th class="px-5 py-4">Lecturer</th>
                                    <th class="px-5 py-4 text-right">Action</th>
                                </tr>
                            </thead>

                            <tbody class="divide-y divide-slate-100 bg-white">
                                ${rows || `
                                    <tr>
                                        <td colspan="3" class="px-5 py-8 text-center text-sm font-semibold text-slate-400">
                                            No modules assigned to this semester.
                                        </td>
                                    </tr>
                                `}
                            </tbody>
                        </table>
                    </div>
                `;

                semestersContainer.appendChild(semesterCard);
            });
        }

        function openSemesterPopup() {
            semesterAcademicYear.value = '';
            semesterNameInput.value = '';
            semesterStartDate.value = '';
            semesterEndDate.value = '';
            semesterValidationBox.classList.add('hidden');

            semesterPopup.classList.remove('hidden');
            semesterPopup.classList.add('flex');

            setTimeout(() => semesterAcademicYear.focus(), 0);
        }

        function closeSemesterPopup() {
            semesterPopup.classList.add('hidden');
            semesterPopup.classList.remove('flex');
        }

        function addSemester() {
            semesterValidationBox.classList.add('hidden');

            const academicYear = semesterAcademicYear.value;
            const semesterName = semesterNameInput.value.trim();
            const startDate = semesterStartDate.value;
            const endDate = semesterEndDate.value;

            if (!academicYear) {
                semesterValidationBox.textContent = 'Please select an academic year.';
                semesterValidationBox.classList.remove('hidden');
                return;
            }

            if (!semesterName) {
                semesterValidationBox.textContent = 'Please enter semester name.';
                semesterValidationBox.classList.remove('hidden');
                return;
            }

            if (!startDate) {
                semesterValidationBox.textContent = 'Please select start date.';
                semesterValidationBox.classList.remove('hidden');
                return;
            }

            if (!endDate) {
                semesterValidationBox.textContent = 'Please select end date.';
                semesterValidationBox.classList.remove('hidden');
                return;
            }

            if (new Date(endDate) < new Date(startDate)) {
                semesterValidationBox.textContent = 'End date cannot be earlier than start date.';
                semesterValidationBox.classList.remove('hidden');
                return;
            }

            semesters.push({
                name: semesterName,
                academicYear: academicYear,
                startDate: startDate,
                endDate: endDate,
                modules: []
            });

            renderSemesters();
            closeSemesterPopup();
        }

        function openModulePopup(semesterIndex) {
            selectedSemesterIndex = semesterIndex;
            selectedModule = '';
            selectedLecturer = '';

            popupSemesterText.textContent = `Add a module to ${semesters[semesterIndex].name}.`;

            selectedModuleText.textContent = 'Search and select module';
            selectedModuleText.classList.add('text-slate-400');
            selectedModuleText.classList.remove('text-slate-900');

            selectedLecturerText.textContent = 'Search and select lecturer';
            selectedLecturerText.classList.add('text-slate-400');
            selectedLecturerText.classList.remove('text-slate-900');

            moduleSearchInput.value = '';
            lecturerSearchInput.value = '';
            popupValidationBox.classList.add('hidden');

            renderDropdownOptions(moduleOptions, availableModules, '', selectModule);
            renderDropdownOptions(lecturerOptions, availableLecturers, '', selectLecturer);

            modulePopup.classList.remove('hidden');
            modulePopup.classList.add('flex');
        }

        function closeModulePopup() {
            modulePopup.classList.add('hidden');
            modulePopup.classList.remove('flex');
            moduleDropdownPanel.classList.add('hidden');
            lecturerDropdownPanel.classList.add('hidden');
        }

        function renderDropdownOptions(container, items, keyword, selectCallback) {
            const normalizedKeyword = keyword.trim().toLowerCase();
            const filteredItems = items.filter(item => item.toLowerCase().includes(normalizedKeyword));

            container.innerHTML = '';

            if (filteredItems.length === 0) {
                const emptyItem = document.createElement('div');
                emptyItem.className = 'px-4 py-6 text-center text-sm font-semibold text-slate-400';
                emptyItem.textContent = 'No matching records found.';
                container.appendChild(emptyItem);
                return;
            }

            filteredItems.forEach(item => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'w-full rounded-xl px-4 py-3 text-left text-sm font-bold text-slate-700 transition hover:bg-brand-50 hover:text-brand-700';
                button.textContent = item;
                button.addEventListener('click', () => selectCallback(item));
                container.appendChild(button);
            });
        }

        function selectModule(moduleName) {
            selectedModule = moduleName;
            selectedModuleText.textContent = moduleName;
            selectedModuleText.classList.remove('text-slate-400');
            selectedModuleText.classList.add('text-slate-900');
            moduleDropdownPanel.classList.add('hidden');
        }

        function selectLecturer(lecturerName) {
            selectedLecturer = lecturerName;
            selectedLecturerText.textContent = lecturerName;
            selectedLecturerText.classList.remove('text-slate-400');
            selectedLecturerText.classList.add('text-slate-900');
            lecturerDropdownPanel.classList.add('hidden');
        }

        function addSelectedModuleToSemester() {
            popupValidationBox.classList.add('hidden');

            if (selectedSemesterIndex === null) {
                popupValidationBox.textContent = 'Please select a semester.';
                popupValidationBox.classList.remove('hidden');
                return;
            }

            if (!selectedModule) {
                popupValidationBox.textContent = 'Please select a module.';
                popupValidationBox.classList.remove('hidden');
                return;
            }

            if (!selectedLecturer) {
                popupValidationBox.textContent = 'Please select a lecturer.';
                popupValidationBox.classList.remove('hidden');
                return;
            }

            semesters[selectedSemesterIndex].modules.push({
                module: selectedModule,
                lecturer: selectedLecturer
            });

            renderSemesters();
            closeModulePopup();
        }

        addSemesterButton.addEventListener('click', openSemesterPopup);
        closeSemesterPopupButton.addEventListener('click', closeSemesterPopup);
        cancelSemesterPopupButton.addEventListener('click', closeSemesterPopup);
        confirmAddSemesterButton.addEventListener('click', addSemester);

        semesterPopup.addEventListener('click', event => {
            if (event.target === semesterPopup) {
                closeSemesterPopup();
            }
        });

        semestersContainer.addEventListener('click', event => {
            const addButton = event.target.closest('.add-module-to-semester');
            const removeButton = event.target.closest('.remove-module');

            if (addButton) {
                const semesterIndex = Number(addButton.dataset.semester);
                openModulePopup(semesterIndex);
            }

            if (removeButton) {
                const semesterIndex = Number(removeButton.dataset.semester);
                const moduleIndex = Number(removeButton.dataset.module);
                semesters[semesterIndex].modules.splice(moduleIndex, 1);
                renderSemesters();
            }
        });

        moduleDropdownButton.addEventListener('click', () => {
            moduleDropdownPanel.classList.toggle('hidden');
            lecturerDropdownPanel.classList.add('hidden');
            renderDropdownOptions(moduleOptions, availableModules, moduleSearchInput.value, selectModule);
            setTimeout(() => moduleSearchInput.focus(), 0);
        });

        lecturerDropdownButton.addEventListener('click', () => {
            lecturerDropdownPanel.classList.toggle('hidden');
            moduleDropdownPanel.classList.add('hidden');
            renderDropdownOptions(lecturerOptions, availableLecturers, lecturerSearchInput.value, selectLecturer);
            setTimeout(() => lecturerSearchInput.focus(), 0);
        });

        moduleSearchInput.addEventListener('input', event => {
            renderDropdownOptions(moduleOptions, availableModules, event.target.value, selectModule);
        });

        lecturerSearchInput.addEventListener('input', event => {
            renderDropdownOptions(lecturerOptions, availableLecturers, event.target.value, selectLecturer);
        });

        closePopupButton.addEventListener('click', closeModulePopup);
        cancelPopupButton.addEventListener('click', closeModulePopup);
        confirmAddModuleButton.addEventListener('click', addSelectedModuleToSemester);

        modulePopup.addEventListener('click', event => {
            if (event.target === modulePopup) {
                closeModulePopup();
            }
        });

        saveOfferingButton.addEventListener('click', () => {
            alert('Course offering details saved successfully. Connect this action to your ASP.NET Core controller.');
        });

        goBackButton.addEventListener('click', () => {
            window.history.back();
        });

        document.addEventListener('click', event => {
            if (!moduleDropdownPanel.contains(event.target) && !moduleDropdownButton.contains(event.target)) {
                moduleDropdownPanel.classList.add('hidden');
            }

            if (!lecturerDropdownPanel.contains(event.target) && !lecturerDropdownButton.contains(event.target)) {
                lecturerDropdownPanel.classList.add('hidden');
            }
        });

        renderSemesters();
    });
</script>