@{
    ViewData["Title"] = "Course Offerings";
}


<section class=space-y-6 px-1 sm:px-2">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-xs font-extrabold uppercase tracking-[0.25em] text-brand-700">Course Offering Management</p>
            <h1 class="mt-2 text-2xl font-extrabold text-slate-900 sm:text-3xl">Course Offering List</h1>
            <p class="mt-2 text-sm text-slate-500">View, filter, and manage course offerings by department, course, and academic year.</p>
        </div>
    </div>

    <div class="rounded-[28px] border border-slate-200 bg-white p-5 shadow-panel sm:p-6">
        <div class="flex flex-col gap-3 border-b border-slate-100 pb-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-50 text-brand-700">
                    <i class="fa-solid fa-filter"></i>
                </div>
                <div>
                    <h2 class="text-lg font-bold text-slate-900">Filter Course Offerings</h2>
                    <p class="text-sm text-slate-500">Use the filters below to narrow the course offering list.</p>
                </div>
            </div>

            <button id="clearFiltersButton" type="button" class="inline-flex items-center justify-center gap-2 rounded-full bg-slate-100 px-4 py-2 text-xs font-bold text-slate-700 transition hover:bg-slate-200">
                <i class="fa-solid fa-rotate-left"></i>
                Clear Filters
            </button>
        </div>

        <form class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-12">
            <div class="sm:col-span-2 xl:col-span-4">
                <label class="block text-xs font-bold text-slate-700">Department</label>
                <div class="relative mt-2">
                    <button id="departmentDropdownButton" type="button" class="flex w-full items-center justify-between rounded-2xl border border-slate-200 bg-white px-4 py-3 text-left text-sm font-semibold text-slate-700 shadow-sm transition hover:border-brand-300 focus:outline-none focus:ring-2 focus:ring-brand-600">
                        <span id="selectedDepartmentText" class="truncate text-slate-400">Searchable department dropdown</span>
                        <i class="fa-solid fa-chevron-down text-xs text-slate-400"></i>
                    </button>

                    <div id="departmentDropdownPanel" class="absolute z-40 mt-2 hidden w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
                        <div class="border-b border-slate-100 p-3">
                            <div class="relative">
                                <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-sm text-slate-400"></i>
                                <input id="departmentSearchInput" type="text" placeholder="Search department" class="w-full rounded-xl border border-slate-200 py-2.5 pl-10 pr-4 text-sm focus:outline-none focus:ring-2 focus:ring-brand-600" />
                            </div>
                        </div>
                        <div id="departmentOptions" class="max-h-64 overflow-y-auto p-2"></div>
                    </div>
                </div>
                <input id="selectedDepartmentInput" type="hidden" />
            </div>

            <div class="sm:col-span-2 xl:col-span-4">
                <label class="block text-xs font-bold text-slate-700">Course Title</label>
                <div class="relative mt-2">
                    <button id="courseDropdownButton" type="button" class="flex w-full items-center justify-between rounded-2xl border border-slate-200 bg-white px-4 py-3 text-left text-sm font-semibold text-slate-700 shadow-sm transition hover:border-brand-300 focus:outline-none focus:ring-2 focus:ring-brand-600">
                        <span id="selectedCourseText" class="truncate text-slate-400">Searchable course titles</span>
                        <i class="fa-solid fa-chevron-down text-xs text-slate-400"></i>
                    </button>

                    <div id="courseDropdownPanel" class="absolute z-40 mt-2 hidden w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
                        <div class="border-b border-slate-100 p-3">
                            <div class="relative">
                                <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-sm text-slate-400"></i>
                                <input id="courseSearchInput" type="text" placeholder="Search course title" class="w-full rounded-xl border border-slate-200 py-2.5 pl-10 pr-4 text-sm focus:outline-none focus:ring-2 focus:ring-brand-600" />
                            </div>
                        </div>
                        <div id="courseOptions" class="max-h-64 overflow-y-auto p-2"></div>
                    </div>
                </div>
                <input id="selectedCourseInput" type="hidden" />
            </div>

            <div class="sm:col-span-1 xl:col-span-2">
                <label for="academicYearFilter" class="block text-xs font-bold text-slate-700">Academic Year</label>
                <select id="academicYearFilter" class="mt-2 w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 focus:outline-none focus:ring-2 focus:ring-brand-600">
                    <option value="">All years</option>
                    <option>2026</option>
                    <option>2025</option>
                    <option>2024</option>
                    <option>2023</option>
                </select>
            </div>

            <div class="flex items-end sm:col-span-1 xl:col-span-2">
                <button id="applyFiltersButton" type="button" class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-brand-700 px-4 py-3 text-xs font-bold text-white shadow-lg shadow-brand-700/20 transition hover:-translate-y-0.5 hover:bg-brand-800 focus:outline-none focus:ring-2 focus:ring-brand-600">
                    <i class="fa-solid fa-filter"></i>
                    Apply Filter
                </button>
            </div>
        </form>
    </div>

    <div class="overflow-hidden rounded-[28px] border border-slate-200 bg-white shadow-panel">
        <div class="flex flex-col gap-3 border-b border-slate-100 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-50 text-brand-700">
                    <i class="fa-solid fa-calendar-days"></i>
                </div>
                <div>
                    <h2 class="text-lg font-extrabold text-slate-900">Course Offerings Table</h2>
                    <p id="offeringCountText" class="mt-1 text-sm text-slate-500">Showing all course offerings</p>
                </div>
            </div>
            <span id="activeFilterBadge" class="hidden rounded-full bg-brand-50 px-4 py-2 text-xs font-extrabold text-brand-700">Filters active</span>
        </div>

        <div id="offeringTableContainer" class="w-full overflow-x-auto">
            <table class="w-full min-w-[1000px] divide-y divide-slate-200 text-xs sm:text-sm">
                <thead class="bg-slate-50 text-left text-sm font-bold text-slate-700">
                    <tr>
                        <th class="px-3 py-3 sm:px-5 sm:py-4">Course Title</th>
                        <th class="px-3 py-3 sm:px-5 sm:py-4">Department</th>
                        <th class="px-3 py-3 sm:px-5 sm:py-4">Academic Year</th>
                        <th class="px-3 py-3 sm:px-5 sm:py-4">Status</th>
                        <th class="px-3 py-3 text-right sm:px-5 sm:py-4">View</th>
                        <th class="px-3 py-3 text-right sm:px-5 sm:py-4">Edit</th>
                    </tr>
                </thead>
                <tbody id="offeringTableBody" class="divide-y divide-slate-100 bg-white"></tbody>
            </table>
        </div>

        <div id="pagination" class="flex flex-wrap items-center justify-center gap-2 border-t border-slate-100 px-5 py-5"></div>

        <div id="noResultsBox" class="hidden px-6 py-12 text-center">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand-50 text-brand-700">
                <i class="fa-solid fa-magnifying-glass text-xl"></i>
            </div>
            <h3 class="mt-4 text-lg font-extrabold text-slate-900">No course offerings found</h3>
            <p class="mt-2 text-sm text-slate-500">Try changing the department, course title, or academic year filters.</p>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const departments = [
            'Department of Languages',
            'Department of Art & Design',
            'Department of Life Science',
            'Department of Computing',
            'Department of Engineering',
            'Department of Management & Law'
        ];

        const courseOfferings = [
            { id: 1, courseTitle: 'BSc (Hons) in Software Engineering', department: 'Department of Computing', academicYear: '2026', status: 'open' },
            { id: 2, courseTitle: 'HND in Computing', department: 'Department of Computing', academicYear: '2026', status: 'planned' },
            { id: 3, courseTitle: 'Certificate in Cyber Security', department: 'Department of Computing', academicYear: '2025', status: 'closed' },
            { id: 4, courseTitle: 'Foundation in Information Technology', department: 'Department of Computing', academicYear: '2025', status: 'completed' },
            { id: 5, courseTitle: 'Diploma in Graphic Design', department: 'Department of Art & Design', academicYear: '2026', status: 'open' },
            { id: 6, courseTitle: 'Higher National Certificate in Multimedia Design', department: 'Department of Art & Design', academicYear: '2025', status: 'cancelled' },
            { id: 7, courseTitle: 'BA in Fashion Design', department: 'Department of Art & Design', academicYear: '2024', status: 'completed' },
            { id: 8, courseTitle: 'Diploma in English Language', department: 'Department of Languages', academicYear: '2026', status: 'planned' },
            { id: 9, courseTitle: 'Certificate in Business English', department: 'Department of Languages', academicYear: '2025', status: 'open' },
            { id: 10, courseTitle: 'Foundation in Academic English', department: 'Department of Languages', academicYear: '2024', status: 'closed' },
            { id: 11, courseTitle: 'BSc Biomedical Science', department: 'Department of Life Science', academicYear: '2026', status: 'planned' },
            { id: 12, courseTitle: 'Diploma in Psychology', department: 'Department of Life Science', academicYear: '2025', status: 'completed' },
            { id: 13, courseTitle: 'Certificate in Laboratory Practice', department: 'Department of Life Science', academicYear: '2024', status: 'cancelled' },
            { id: 14, courseTitle: 'HND in Civil Engineering', department: 'Department of Engineering', academicYear: '2026', status: 'open' },
            { id: 15, courseTitle: 'HND in Electrical and Electronic Engineering', department: 'Department of Engineering', academicYear: '2025', status: 'closed' },
            { id: 16, courseTitle: 'Certificate in AutoCAD for Engineering', department: 'Department of Engineering', academicYear: '2024', status: 'completed' },
            { id: 17, courseTitle: 'Diploma in Business Management', department: 'Department of Management & Law', academicYear: '2026', status: 'planned' },
            { id: 18, courseTitle: 'BA (Hons) in Business Administration', department: 'Department of Management & Law', academicYear: '2025', status: 'open' },
            { id: 19, courseTitle: 'MBA in Project Management', department: 'Department of Management & Law', academicYear: '2024', status: 'completed' },
            { id: 20, courseTitle: 'Doctor of Business Administration', department: 'Department of Management & Law', academicYear: '2023', status: 'closed' }
        ];

        const departmentDropdownButton = document.getElementById('departmentDropdownButton');
        const departmentDropdownPanel = document.getElementById('departmentDropdownPanel');
        const departmentSearchInput = document.getElementById('departmentSearchInput');
        const departmentOptions = document.getElementById('departmentOptions');
        const selectedDepartmentText = document.getElementById('selectedDepartmentText');
        const selectedDepartmentInput = document.getElementById('selectedDepartmentInput');
        const courseDropdownButton = document.getElementById('courseDropdownButton');
        const courseDropdownPanel = document.getElementById('courseDropdownPanel');
        const courseSearchInput = document.getElementById('courseSearchInput');
        const courseOptions = document.getElementById('courseOptions');
        const selectedCourseText = document.getElementById('selectedCourseText');
        const selectedCourseInput = document.getElementById('selectedCourseInput');
        const academicYearFilter = document.getElementById('academicYearFilter');
        const applyFiltersButton = document.getElementById('applyFiltersButton');
        const clearFiltersButton = document.getElementById('clearFiltersButton');
        const offeringTableBody = document.getElementById('offeringTableBody');
        const offeringCountText = document.getElementById('offeringCountText');
        const activeFilterBadge = document.getElementById('activeFilterBadge');
        const noResultsBox = document.getElementById('noResultsBox');
        const pagination = document.getElementById('pagination');
        const offeringTableContainer = document.getElementById('offeringTableContainer');

        const itemsPerPage = 5;
        let currentPage = 1;
        let selectedDepartment = '';
        let selectedCourse = '';
        let currentFilteredOfferings = [];

        function renderDepartmentOptions(keyword = '') {
            const normalizedKeyword = keyword.trim().toLowerCase();
            const filteredDepartments = departments.filter(department => department.toLowerCase().includes(normalizedKeyword));

            departmentOptions.innerHTML = '';

            const allButton = document.createElement('button');
            allButton.type = 'button';
            allButton.className = 'w-full rounded-xl px-4 py-3 text-left text-sm font-bold text-slate-700 transition hover:bg-brand-50';
            allButton.textContent = 'All departments';
            allButton.addEventListener('click', () => selectDepartment(''));
            departmentOptions.appendChild(allButton);

            if (filteredDepartments.length === 0) {
                const emptyItem = document.createElement('div');
                emptyItem.className = 'px-4 py-6 text-center text-sm font-semibold text-slate-400';
                emptyItem.textContent = 'No departments found.';
                departmentOptions.appendChild(emptyItem);
                return;
            }

            filteredDepartments.forEach(department => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'w-full rounded-xl px-4 py-3 text-left text-sm font-bold text-slate-700 transition hover:bg-brand-50';
                button.textContent = department;
                button.addEventListener('click', () => selectDepartment(department));
                departmentOptions.appendChild(button);
            });
        }

        function renderCourseOptions(keyword = '') {
            const normalizedKeyword = keyword.trim().toLowerCase();
            const uniqueCourses = [...new Set(courseOfferings.map(item => item.courseTitle))];
            const filteredCourses = uniqueCourses.filter(course => course.toLowerCase().includes(normalizedKeyword));

            courseOptions.innerHTML = '';

            const allButton = document.createElement('button');
            allButton.type = 'button';
            allButton.className = 'w-full rounded-xl px-4 py-3 text-left text-sm font-bold text-slate-700 transition hover:bg-brand-50';
            allButton.textContent = 'All courses';
            allButton.addEventListener('click', () => selectCourse(''));
            courseOptions.appendChild(allButton);

            if (filteredCourses.length === 0) {
                const emptyItem = document.createElement('div');
                emptyItem.className = 'px-4 py-6 text-center text-sm font-semibold text-slate-400';
                emptyItem.textContent = 'No courses found.';
                courseOptions.appendChild(emptyItem);
                return;
            }

            filteredCourses.forEach(course => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'w-full rounded-xl px-4 py-3 text-left text-sm font-bold text-slate-700 transition hover:bg-brand-50';
                button.textContent = course;
                button.addEventListener('click', () => selectCourse(course));
                courseOptions.appendChild(button);
            });
        }

        function selectDepartment(department) {
            selectedDepartment = department;
            selectedDepartmentInput.value = department;
            selectedDepartmentText.textContent = department || 'All departments';
            selectedDepartmentText.classList.toggle('text-slate-400', department === '');
            selectedDepartmentText.classList.toggle('text-slate-900', department !== '');
            departmentDropdownPanel.classList.add('hidden');
        }

        function selectCourse(course) {
            selectedCourse = course;
            selectedCourseInput.value = course;
            selectedCourseText.textContent = course || 'All courses';
            selectedCourseText.classList.toggle('text-slate-400', course === '');
            selectedCourseText.classList.toggle('text-slate-900', course !== '');
            courseDropdownPanel.classList.add('hidden');
        }

        function getStatusBadge(status) {
            const statusStyles = {
                planned: 'bg-sky-50 text-sky-700 ring-sky-200',
                open: 'bg-emerald-50 text-emerald-700 ring-emerald-200',
                closed: 'bg-slate-100 text-slate-700 ring-slate-200',
                cancelled: 'bg-rose-50 text-rose-700 ring-rose-200',
                completed: 'bg-violet-50 text-violet-700 ring-violet-200'
            };

            const classes = statusStyles[status] || 'bg-slate-50 text-slate-700 ring-slate-200';
            return `<span class="inline-flex rounded-full px-3 py-1 text-xs font-extrabold capitalize ring-1 ${classes}">${status}</span>`;
        }

        function applyFilters(resetPage = true) {
            const academicYear = academicYearFilter.value;

            currentFilteredOfferings = courseOfferings.filter(offering => {
                const matchesDepartment = !selectedDepartment || offering.department === selectedDepartment;
                const matchesCourse = !selectedCourse || offering.courseTitle === selectedCourse;
                const matchesAcademicYear = !academicYear || offering.academicYear === academicYear;
                return matchesDepartment && matchesCourse && matchesAcademicYear;
            });

            if (resetPage) {
                currentPage = 1;
            }

            renderTable(currentFilteredOfferings);
            renderPagination(currentFilteredOfferings.length);
            updateFilterStatus(currentFilteredOfferings.length);
        }

        function renderTable(data) {
            offeringTableBody.innerHTML = '';
            noResultsBox.classList.toggle('hidden', data.length > 0);

            const startIndex = (currentPage - 1) * itemsPerPage;
            const endIndex = startIndex + itemsPerPage;
            const paginatedData = data.slice(startIndex, endIndex);

            paginatedData.forEach(offering => {
                const row = document.createElement('tr');
                row.className = 'transition hover:bg-slate-50';
                row.innerHTML = `
                    <td class="px-3 py-3 font-semibold text-slate-900 sm:px-5 sm:py-4">${offering.courseTitle}</td>
                    <td class="px-3 py-3 text-slate-700 sm:px-5 sm:py-4">${offering.department}</td>
                    <td class="px-3 py-3 text-slate-600 sm:px-5 sm:py-4">${offering.academicYear}</td>
                    <td class="px-3 py-3 sm:px-5 sm:py-4">${getStatusBadge(offering.status)}</td>
                    <td class="px-3 py-3 text-right sm:px-5 sm:py-4">
                        <a href="/CourseOffering/Details/${offering.id}" class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-50 px-4 py-2 text-xs font-bold text-brand-700 transition hover:bg-brand-100">
                            <i class="fa-solid fa-eye"></i>
                            View
                        </a>
                    </td>
                    <td class="px-3 py-3 text-right sm:px-5 sm:py-4">
                        <a href="/CourseOffering/Edit/${offering.id}" class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-amber-50 text-amber-700 transition hover:bg-amber-100">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                    </td>
                `;
                offeringTableBody.appendChild(row);
            });
        }

        function renderPagination(totalItems) {
            pagination.innerHTML = '';
            const totalPages = Math.ceil(totalItems / itemsPerPage);

            if (totalPages <= 1) {
                return;
            }

            const createButton = (label, page, disabled = false, active = false) => {
                const button = document.createElement('button');
                button.type = 'button';
                button.textContent = label;
                button.disabled = disabled;
                button.className = active
                    ? 'h-10 min-w-10 rounded-full bg-blue-700 px-4 text-sm font-extrabold text-white shadow-md'
                    : 'h-10 min-w-10 rounded-full border border-slate-200 bg-white px-4 text-sm font-bold text-slate-700 transition hover:bg-blue-50 hover:text-blue-700 disabled:cursor-not-allowed disabled:opacity-40';

                button.addEventListener('click', () => {
                    if (!disabled) {
                        currentPage = page;
                        renderTable(currentFilteredOfferings);
                        renderPagination(currentFilteredOfferings.length);
                        offeringTableContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });

                pagination.appendChild(button);
            };

            createButton('Prev', Math.max(1, currentPage - 1), currentPage === 1);

            for (let page = 1; page <= totalPages; page++) {
                createButton(page, page, false, page === currentPage);
            }

            createButton('Next', Math.min(totalPages, currentPage + 1), currentPage === totalPages);
        }

        function updateFilterStatus(count) {
            const filtersActive = Boolean(selectedDepartment || selectedCourse || academicYearFilter.value);
            activeFilterBadge.classList.toggle('hidden', !filtersActive);
            offeringCountText.textContent = `${count} course offering${count === 1 ? '' : 's'} found`;
        }

        function clearFilters() {
            selectedDepartment = '';
            selectedCourse = '';
            selectedDepartmentInput.value = '';
            selectedCourseInput.value = '';
            selectedDepartmentText.textContent = 'Searchable department dropdown';
            selectedDepartmentText.classList.add('text-slate-400');
            selectedDepartmentText.classList.remove('text-slate-900');
            selectedCourseText.textContent = 'Searchable course titles';
            selectedCourseText.classList.add('text-slate-400');
            selectedCourseText.classList.remove('text-slate-900');
            departmentSearchInput.value = '';
            courseSearchInput.value = '';
            academicYearFilter.value = '';
            renderDepartmentOptions();
            renderCourseOptions();
            applyFilters(true);
        }

        departmentDropdownButton.addEventListener('click', () => {
            departmentDropdownPanel.classList.toggle('hidden');
            courseDropdownPanel.classList.add('hidden');
            departmentSearchInput.value = '';
            renderDepartmentOptions();
            setTimeout(() => departmentSearchInput.focus(), 0);
        });

        courseDropdownButton.addEventListener('click', () => {
            courseDropdownPanel.classList.toggle('hidden');
            departmentDropdownPanel.classList.add('hidden');
            courseSearchInput.value = '';
            renderCourseOptions();
            setTimeout(() => courseSearchInput.focus(), 0);
        });

        document.addEventListener('click', event => {
            if (!departmentDropdownPanel.contains(event.target) && !departmentDropdownButton.contains(event.target)) {
                departmentDropdownPanel.classList.add('hidden');
            }

            if (!courseDropdownPanel.contains(event.target) && !courseDropdownButton.contains(event.target)) {
                courseDropdownPanel.classList.add('hidden');
            }
        });

        departmentSearchInput.addEventListener('input', event => renderDepartmentOptions(event.target.value));
        courseSearchInput.addEventListener('input', event => renderCourseOptions(event.target.value));
        academicYearFilter.addEventListener('change', () => applyFilters(true));
        applyFiltersButton.addEventListener('click', () => applyFilters(true));
        clearFiltersButton.addEventListener('click', clearFilters);

        renderDepartmentOptions();
        renderCourseOptions();
        applyFilters(true);
    });
</script>
