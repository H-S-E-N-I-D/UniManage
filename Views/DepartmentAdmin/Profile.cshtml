<script>
    const tabButtons = document.querySelectorAll(".tab-button");
    const tabContents = document.querySelectorAll(".tab-content");

    tabButtons.forEach(button => {
        button.addEventListener("click", function () {
            const selectedTab = this.getAttribute("data-tab");

            tabButtons.forEach(btn => {
                btn.classList.remove("bg-brand-700", "text-white");
                btn.classList.add("text-slate-600", "hover:bg-slate-50");
            });

            this.classList.add("bg-brand-700", "text-white");
            this.classList.remove("text-slate-600", "hover:bg-slate-50");

            tabContents.forEach(content => {
                content.classList.add("hidden");
            });

            document.getElementById(selectedTab).classList.remove("hidden");
        });
    });

    const courses = [
        {
            name: "BSc Software Engineering",
            code: "SE101",
            batches: 4,
            students: 186,
            lecturers: 8,
            status: "Active"
        },
        {
            name: "Higher Diploma in Software Engineering",
            code: "HDSE201",
            batches: 3,
            students: 124,
            lecturers: 5,
            status: "Active"
        },
        {
            name: "Diploma in Software Development",
            code: "DSD301",
            batches: 2,
            students: 78,
            lecturers: 4,
            status: "Active"
        },
        {
            name: "Software Quality Assurance Certificate",
            code: "SQA401",
            batches: 1,
            students: 40,
            lecturers: 1,
            status: "Inactive"
        }
    ];

    const courseTableBody = document.getElementById("courseTableBody");
    const courseStatusFilter = document.getElementById("courseStatusFilter");

    function getStatusClass(status) {
        if (status === "Active") return "bg-emerald-50 text-emerald-700";
        if (status === "Inactive") return "bg-slate-100 text-slate-700";
        return "bg-amber-50 text-amber-700";
    }

    function renderCourses(filter = "all") {
        courseTableBody.innerHTML = "";

        const filteredCourses = filter === "all"
            ? courses
            : courses.filter(item => item.status === filter);

        filteredCourses.forEach(course => {
            courseTableBody.innerHTML += `
                <tr class="transition hover:bg-brand-50/40">
                    <td class="px-4 py-3 font-medium text-slate-800">${course.name}</td>
                    <td class="px-4 py-3 text-center text-slate-600">${course.code}</td>
                    <td class="px-4 py-3 text-center text-slate-600">${course.batches}</td>
                    <td class="px-4 py-3 text-center text-slate-600">${course.students}</td>
                    <td class="px-4 py-3 text-center text-slate-600">${course.lecturers}</td>
                    <td class="px-4 py-3 text-center">
                        <span class="rounded-full px-3 py-1 font-semibold ${getStatusClass(course.status)}">
                            ${course.status}
                        </span>
                    </td>
                </tr>
            `;
        });
    }

    courseStatusFilter.addEventListener("change", function () {
        renderCourses(this.value);
    });

    renderCourses();
</script>