@{
    ViewData["Title"] = "Department Admin Dashboard";
}

<div class="space-y-6">

    <!-- Welcome Header -->
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-700">
                    Department Admin Portal
                </p>

                <h1 class="mtmt-2 text-2xl font-bold text-slate-800">
                    Department Admin Dashboard
                </h1>

                <p class="mt-2 text-sm text-slate-500">
                    Monitor courses, modules, lecturers, students, enrollments and department-level academic activities.
                </p>
            </div>

            <div class="flex h-16 w-16 items-center justify-center rounded-3xl bg-brand-100 text-brand-700">
                <i class="fa-solid fa-building-columns text-3xl"></i>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4">

        <div class="rounded-3xl border border-blue-100 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-semibold text-slate-500">Active Courses</p>
                    <h2 class="mt-2 text-3xl font-bold text-slate-800">12</h2>
                </div>
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-100 text-brand-700">
                    <i class="fa-solid fa-book-open text-xl"></i>
                </div>
            </div>
        </div>

        <div class="rounded-3xl border border-blue-100 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-semibold text-slate-500">Total Students</p>
                    <h2 class="mt-2 text-3xl font-bold text-slate-800">1,248</h2>
                </div>
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-700">
                    <i class="fa-solid fa-user-graduate text-xl"></i>
                </div>
            </div>
        </div>

        <div class="rounded-3xl border border-blue-100 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-semibold text-slate-500">Lecturers</p>
                    <h2 class="mt-2 text-3xl font-bold text-slate-800">48</h2>
                </div>
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 text-amber-700">
                    <i class="fa-solid fa-chalkboard-user text-xl"></i>
                </div>
            </div>
        </div>

        <div class="rounded-3xl border border-blue-100 bg-white p-6 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-semibold text-slate-500">Pending Enrollments</p>
                    <h2 class="mt-2 text-3xl font-bold text-slate-800">36</h2>
                </div>
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-red-100 text-red-700">
                    <i class="fa-solid fa-user-clock text-xl"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- Main Dashboard Grid -->
    <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">

        <!-- Left Content -->
        <div class="space-y-6 xl:col-span-2">

            <!-- Enrollment Trend -->
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
                <div class="mb-5 flex items-center justify-between">
                    <div>
                        <h2 class="text-xl font-bold text-slate-800">Enrollment Trend</h2>
                        <p class="text-sm text-slate-500">Monthly student enrollments for the department.</p>
                    </div>
                </div>

                <div class="h-72">
                    <canvas id="enrollmentTrendChart"></canvas>
                </div>
            </div>

            <!-- Course and Module Overview -->
            <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">

                <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
                    <h2 class="mb-5 text-xl font-bold text-slate-800">Course Status Overview</h2>
                    <div class="h-64">
                        <canvas id="courseStatusChart"></canvas>
                    </div>
                </div>

                <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
                    <h2 class="mb-5 text-xl font-bold text-slate-800">Assessment Submission Status</h2>
                    <div class="h-64">
                        <canvas id="submissionStatusChart"></canvas>
                    </div>
                </div>

            </div>

            <!-- Pending Enrollment Requests -->
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
                <div class="mb-5 flex items-center justify-between">
                    <div>
                        <h2 class="text-xl font-bold text-slate-800">Recent Enrollment Requests</h2>
                        <p class="text-sm text-slate-500">Latest student course enrollment requests.</p>
                    </div>

                    <button onclick="navigateToEnrollments()"
                            class="rounded-xl border border-brand-700 px-4 py-2 text-sm font-semibold text-brand-700 hover:bg-brand-50">
                        View All
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-slate-200">
                        <thead class="bg-slate-50">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-bold uppercase text-slate-500">Student</th>
                                <th class="px-4 py-3 text-left text-xs font-bold uppercase text-slate-500">Course</th>
                                <th class="px-4 py-3 text-left text-xs font-bold uppercase text-slate-500">Request Date</th>
                                <th class="px-4 py-3 text-left text-xs font-bold uppercase text-slate-500">Status</th>
                            </tr>
                        </thead>

                        <tbody class="divide-y divide-slate-200 bg-white">
                            <tr>
                                <td class="px-4 py-4 font-semibold text-slate-800">Kasun Perera</td>
                                <td class="px-4 py-4 text-slate-600">BSc Software Engineering</td>
                                <td class="px-4 py-4 text-slate-600">08 May 2026</td>
                                <td class="px-4 py-4">
                                    <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-700">Pending</span>
                                </td>
                            </tr>

                            <tr>
                                <td class="px-4 py-4 font-semibold text-slate-800">Tharushi Fernando</td>
                                <td class="px-4 py-4 text-slate-600">BSc Data Science</td>
                                <td class="px-4 py-4 text-slate-600">07 May 2026</td>
                                <td class="px-4 py-4">
                                    <span class="rounded-full bg-blue-100 px-3 py-1 text-xs font-bold text-blue-700">Waitlisted</span>
                                </td>
                            </tr>

                            <tr>
                                <td class="px-4 py-4 font-semibold text-slate-800">Nimal Silva</td>
                                <td class="px-4 py-4 text-slate-600">Diploma in Web Development</td>
                                <td class="px-4 py-4 text-slate-600">06 May 2026</td>
                                <td class="px-4 py-4">
                                    <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-bold text-green-700">Approved</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>

        <!-- Right Sidebar -->
        <div class="space-y-6">

            <!-- Quick Links -->
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
                <h2 class="mb-5 text-xl font-bold text-slate-800">Quick Links</h2>

                <div class="space-y-3">
                    <button onclick="navigateToCourses()"
                            class="flex w-full items-center gap-3 rounded-2xl border border-slate-200 px-4 py-3 text-left font-semibold text-slate-700 hover:border-brand-300 hover:bg-brand-50">
                        <i class="fa-solid fa-book-open text-brand-700"></i>
                        Manage Courses
                    </button>

                    <button onclick="navigateToModules()"
                            class="flex w-full items-center gap-3 rounded-2xl border border-slate-200 px-4 py-3 text-left font-semibold text-slate-700 hover:border-brand-300 hover:bg-brand-50">
                        <i class="fa-solid fa-layer-group text-brand-700"></i>
                        Manage Modules
                    </button>

                    <button onclick="navigateToLecturers()"
                            class="flex w-full items-center gap-3 rounded-2xl border border-slate-200 px-4 py-3 text-left font-semibold text-slate-700 hover:border-brand-300 hover:bg-brand-50">
                        <i class="fa-solid fa-chalkboard-user text-brand-700"></i>
                        Lecturers
                    </button>

                    <button onclick="navigateToEnrollments()"
                            class="flex w-full items-center gap-3 rounded-2xl border border-slate-200 px-4 py-3 text-left font-semibold text-slate-700 hover:border-brand-300 hover:bg-brand-50">
                        <i class="fa-solid fa-user-check text-brand-700"></i>
                        Enrollment Requests
                    </button>

                    <button onclick="navigateToReports()"
                            class="flex w-full items-center gap-3 rounded-2xl border border-slate-200 px-4 py-3 text-left font-semibold text-slate-700 hover:border-brand-300 hover:bg-brand-50">
                        <i class="fa-solid fa-chart-line text-brand-700"></i>
                        Department Reports
                    </button>
                </div>
            </div>

            <!-- Academic Activity -->
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
                <h2 class="mb-5 text-xl font-bold text-slate-800">Academic Activity</h2>

                <div class="space-y-4">
                    <div class="rounded-2xl bg-brand-50 p-4">
                        <p class="text-sm font-semibold text-slate-700">Modules Currently Running</p>
                        <h3 class="mt-2 text-2xl font-extrabold text-brand-700">28</h3>
                    </div>

                    <div class="rounded-2xl bg-amber-50 p-4">
                        <p class="text-sm font-semibold text-slate-700">Assessments Due This Week</p>
                        <h3 class="mt-2 text-2xl font-extrabold text-amber-700">9</h3>
                    </div>

                    <div class="rounded-2xl bg-red-50 p-4">
                        <p class="text-sm font-semibold text-slate-700">Late Submissions</p>
                        <h3 class="mt-2 text-2xl font-extrabold text-red-700">42</h3>
                    </div>
                </div>
            </div>

            <!-- Department Notices -->
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-panel">
                <div class="mb-5 flex items-center justify-between">
                    <h2 class="text-xl font-bold text-slate-800">Department Notices</h2>
                    <i class="fa-solid fa-bullhorn text-brand-700"></i>
                </div>

                <div class="space-y-4">
                    <div class="border-b border-slate-200 pb-4">
                        <h3 class="font-bold text-slate-800">Semester 2 Timetable Review</h3>
                        <p class="mt-1 text-sm text-slate-500">Lecturer allocation review is scheduled this week.</p>
                        <p class="mt-2 text-xs font-semibold text-slate-400">Today</p>
                    </div>

                    <div class="border-b border-slate-200 pb-4">
                        <h3 class="font-bold text-slate-800">Enrollment Capacity Alert</h3>
                        <p class="mt-1 text-sm text-slate-500">Two courses have reached 90% enrollment capacity.</p>
                        <p class="mt-2 text-xs font-semibold text-slate-400">Yesterday</p>
                    </div>

                    <div>
                        <h3 class="font-bold text-slate-800">Assessment Moderation</h3>
                        <p class="mt-1 text-sm text-slate-500">Moderation reports are due before final publication.</p>
                        <p class="mt-2 text-xs font-semibold text-slate-400">06 May 2026</p>
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const enrollmentCtx = document.getElementById('enrollmentTrendChart');

        new Chart(enrollmentCtx, {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
                datasets: [{
                    label: 'Enrollments',
                    data: [120, 160, 210, 185, 240, 280],
                    borderWidth: 3,
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });

        const courseStatusCtx = document.getElementById('courseStatusChart');

        new Chart(courseStatusCtx, {
            type: 'doughnut',
            data: {
                labels: ['Active', 'Upcoming', 'Completed', 'Inactive'],
                datasets: [{
                    data: [12, 5, 8, 2],
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });

        const submissionStatusCtx = document.getElementById('submissionStatusChart');

        new Chart(submissionStatusCtx, {
            type: 'bar',
            data: {
                labels: ['Submitted', 'Late', 'Not Submitted'],
                datasets: [{
                    label: 'Submissions',
                    data: [320, 42, 76],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });

        function navigateToCourses() {
            console.log("Navigate to course management");
        }

        function navigateToModules() {
            console.log("Navigate to module management");
        }

        function navigateToLecturers() {
            console.log("Navigate to lecturers");
        }

        function navigateToEnrollments() {
            console.log("Navigate to enrollment requests");
        }

        function navigateToReports() {
            console.log("Navigate to department reports");
        }
    </script>
}